From 50b0ef6870e9251e65949dbb7004c4760905d3a7 Mon Sep 17 00:00:00 2001
From: Timothy Schmidt <timschmidt@gmail.com>
Date: Wed, 11 Nov 2026 08:29:12 -0500
Subject: [PATCH] cpufreq: qcom-nvmem: attach calibrated MSM8926 CPU suppliers

Port the complete qualified supplier query, eligibility filtering,
attachment, unwind and retry behavior onto the verified ARM update
base 285ad12ac4d4. Preserve this tree's existing flexible allocation and
OF machine-query APIs. The public eligibility interface is supplied
as a dependency of the separate CPR controller series.

The enabled supplier path is built with the current PM stack and
covered by the actual CPU/core models. This standalone ARM topic is
also compiled with the disabled-provider interface on native ARM
and ARM64. Original author/date retained from Timothy Schmidt's CPU
component. Codex performed this current-base port and qualification.
Human review/DCO and physical CPU acceptance remain pending.
---
 drivers/cpufreq/cpufreq-dt-platdev.c | 13 ++++++++
 drivers/cpufreq/qcom-cpufreq-nvmem.c | 46 +++++++++++++++++++++++-----
 2 files changed, 51 insertions(+), 8 deletions(-)

diff --git a/drivers/cpufreq/cpufreq-dt-platdev.c b/drivers/cpufreq/cpufreq-dt-platdev.c
index bce4c8757..753c9bb8f 100644
--- a/drivers/cpufreq/cpufreq-dt-platdev.c
+++ b/drivers/cpufreq/cpufreq-dt-platdev.c
@@ -229,10 +229,23 @@ static bool __init cpu0_node_has_opp_v2_prop(void)
 	return ret;
 }
 
+static bool __init cpu0_uses_msm8926_cpr(void)
+{
+	struct device_node *cpu __free(device_node) = of_cpu_device_node_get(0);
+	struct device_node *opps __free(device_node) =
+		of_parse_phandle(cpu, "operating-points-v2", 0);
+
+	return of_device_is_compatible(opps, "operating-points-v2-msm8926-cpu");
+}
+
 static int __init cpufreq_dt_platdev_init(void)
 {
 	const void *data = NULL;
 
+	/* Calibrated CPU/domain filtering must precede generic registration. */
+	if (cpu0_uses_msm8926_cpr())
+		return -ENODEV;
+
 	if (of_machine_device_match(allowlist)) {
 		data = of_machine_get_match_data(allowlist);
 		goto create_pdev;
diff --git a/drivers/cpufreq/qcom-cpufreq-nvmem.c b/drivers/cpufreq/qcom-cpufreq-nvmem.c
index 375f12d5d..f13382990 100644
--- a/drivers/cpufreq/qcom-cpufreq-nvmem.c
+++ b/drivers/cpufreq/qcom-cpufreq-nvmem.c
@@ -28,6 +28,7 @@
 #include <linux/pm_opp.h>
 #include <linux/pm_runtime.h>
 #include <linux/slab.h>
+#include <linux/soc/qcom/cpr.h>
 #include <linux/soc/qcom/smem.h>
 
 #include <dt-bindings/arm/qcom,ids.h>
@@ -54,6 +55,7 @@ struct qcom_cpufreq_match_data {
 			   struct qcom_cpufreq_drv *drv);
 	const char **pd_names;
 	unsigned int num_pd_names;
+	bool cpr_supported_hw;
 };
 
 struct qcom_cpufreq_drv_cpu {
@@ -458,6 +460,12 @@ static const struct qcom_cpufreq_match_data match_data_qcs404 = {
 	.num_pd_names = 1,
 };
 
+static const struct qcom_cpufreq_match_data match_data_msm8926 = {
+	.pd_names = (const char *[]) { "cpr" },
+	.num_pd_names = 1,
+	.cpr_supported_hw = true,
+};
+
 static const struct qcom_cpufreq_match_data match_data_ipq6018 = {
 	.get_version = qcom_cpufreq_ipq6018_name_version,
 };
@@ -491,8 +499,14 @@ static int qcom_cpufreq_probe(struct platform_device *pdev)
 	char *pvs_name = pvs_name_buffer;
 	unsigned cpu;
 	const struct of_device_id *match;
+	const struct qcom_cpufreq_match_data *data;
 	int ret;
 
+	match = pdev->dev.platform_data;
+	if (!match || !match->data)
+		return -EINVAL;
+	data = match->data;
+
 	cpu_dev = get_cpu_device(0);
 	if (!cpu_dev)
 		return -ENODEV;
@@ -502,8 +516,11 @@ static int qcom_cpufreq_probe(struct platform_device *pdev)
 	if (!np)
 		return -ENOENT;
 
-	ret = of_device_is_compatible(np, "operating-points-v2-kryo-cpu") ||
-	      of_device_is_compatible(np, "operating-points-v2-krait-cpu");
+	if (data->cpr_supported_hw)
+		ret = of_device_is_compatible(np, "operating-points-v2-msm8926-cpu");
+	else
+		ret = of_device_is_compatible(np, "operating-points-v2-kryo-cpu") ||
+		      of_device_is_compatible(np, "operating-points-v2-krait-cpu");
 	if (!ret)
 		return -ENOENT;
 
@@ -512,12 +529,14 @@ static int qcom_cpufreq_probe(struct platform_device *pdev)
 	if (!drv)
 		return -ENOMEM;
 
-	match = pdev->dev.platform_data;
-	drv->data = match->data;
-	if (!drv->data)
-		return -ENODEV;
+	drv->data = data;
 
-	if (drv->data->get_version) {
+	if (data->cpr_supported_hw) {
+		ret = qcom_cpr_msm8926_get_supported_hw(cpu_dev, &drv->versions);
+		if (ret)
+			return dev_err_probe(cpu_dev, ret, "CPR eligibility unavailable\n");
+		pvs_name = NULL;
+	} else if (data->get_version) {
 		speedbin_nvmem = of_nvmem_cell_get(np, NULL);
 		if (IS_ERR(speedbin_nvmem))
 			return dev_err_probe(cpu_dev, PTR_ERR(speedbin_nvmem),
@@ -543,7 +562,7 @@ static int qcom_cpufreq_probe(struct platform_device *pdev)
 			goto free_opp;
 		}
 
-		if (drv->data->get_version) {
+		if (drv->data->get_version || drv->data->cpr_supported_hw) {
 			config.supported_hw = &drv->versions;
 			config.supported_hw_count = 1;
 
@@ -631,6 +650,7 @@ static struct platform_driver qcom_cpufreq_driver = {
 static const struct of_device_id qcom_cpufreq_match_list[] __initconst __maybe_unused = {
 	{ .compatible = "qcom,apq8096", .data = &match_data_kryo },
 	{ .compatible = "qcom,msm8909", .data = &match_data_msm8909 },
+	{ .compatible = "qcom,msm8926", .data = &match_data_msm8926 },
 	{ .compatible = "qcom,msm8996", .data = &match_data_kryo },
 	{ .compatible = "qcom,qcs404", .data = &match_data_qcs404 },
 	{ .compatible = "qcom,ipq5210", .data = &match_data_kryo },
@@ -663,6 +683,16 @@ static int __init qcom_cpufreq_init(void)
 	if (!match)
 		return -ENODEV;
 
+	if (((const struct qcom_cpufreq_match_data *)match->data)->cpr_supported_hw) {
+		struct device_node *cpu __free(device_node) = of_cpu_device_node_get(0);
+		struct device_node *opps __free(device_node) =
+			of_parse_phandle(cpu, "operating-points-v2", 0);
+
+		/* Legacy MSM8926 boards keep their ordinary cpufreq-dt route. */
+		if (!of_device_is_compatible(opps, "operating-points-v2-msm8926-cpu"))
+			return -ENODEV;
+	}
+
 	ret = platform_driver_register(&qcom_cpufreq_driver);
 	if (unlikely(ret < 0))
 		return ret;
