From 72780be1f7b3edef520b945c37d421a466b19b0a Mon Sep 17 00:00:00 2001
From: Timothy Schmidt <timschmidt@gmail.com>
Date: Sun, 15 Nov 2026 04:20:06 -0500
Subject: [PATCH] dt-bindings: Import exact qualified schemas and complete Fx0
 validation board

Use the five existing qualified IOMMU, CAMSS, WCNSS, LED and PMIC parent
schema dependencies without runtime driver changes. Add the complete
unchanged Fx0 board solely for ordinary Kbuild and binding validation.

Prepared with OpenAI Codex assistance; human review and DCO pending.
---
 .../devicetree/bindings/iommu/qcom,iommu.yaml |  88 ++-
 .../bindings/leds/qcom,pm8941-flash-led.yaml  |  71 ++
 .../bindings/media/qcom,msm8226-camss.yaml    | 250 ++++++
 .../bindings/mfd/qcom,spmi-pmic.yaml          |   4 +-
 .../bindings/remoteproc/qcom,wcnss-pil.yaml   |   1 +
 arch/arm/boot/dts/qcom/Makefile               |   3 +
 .../boot/dts/qcom/qcom-msm8926-lg-madai.dts   | 741 ++++++++++++++++++
 7 files changed, 1152 insertions(+), 6 deletions(-)
 create mode 100644 Documentation/devicetree/bindings/leds/qcom,pm8941-flash-led.yaml
 create mode 100644 Documentation/devicetree/bindings/media/qcom,msm8226-camss.yaml
 create mode 100644 arch/arm/boot/dts/qcom/qcom-msm8926-lg-madai.dts

diff --git a/Documentation/devicetree/bindings/iommu/qcom,iommu.yaml b/Documentation/devicetree/bindings/iommu/qcom,iommu.yaml
index 93a489025..6381107f8 100644
--- a/Documentation/devicetree/bindings/iommu/qcom,iommu.yaml
+++ b/Documentation/devicetree/bindings/iommu/qcom,iommu.yaml
@@ -10,10 +10,15 @@ maintainers:
   - Konrad Dybcio <konradybcio@kernel.org>
 
 description: |
-  Qualcomm "B" family devices which are not compatible with arm-smmu have
-  a similar looking IOMMU, but without access to the global register space
-  and optionally requiring additional configuration to route context IRQs
-  to non-secure vs secure interrupt line.
+  Qualcomm legacy IOMMUs are not compatible with the generic arm-smmu
+  programming interface. Instances using the msm-iommu-v1/v2 fallbacks
+  expose an optional local register region for interrupt routing, with
+  global configuration managed by the secure world.
+
+  Instances identified by per-instance compatibles expose the global
+  register space for implementation-specific prefetch settings. When
+  qcom,iommu-secure-id is absent on these instances, the OS also manages
+  the global stream mappings and configuration.
 
 properties:
   compatible:
@@ -30,6 +35,13 @@ properties:
               - qcom,msm8953-iommu
               - qcom,msm8976-iommu
           - const: qcom,msm-iommu-v2
+      - enum:
+          - qcom,msm8226-gpu-iommu
+          - qcom,msm8226-vfe-iommu
+          - qcom,msm8226-mdp-iommu
+          - qcom,msm8974-gpu-iommu
+          - qcom,msm8974-mdp-iommu
+          - qcom,msm8974-venus-iommu
 
   clocks:
     minItems: 2
@@ -50,13 +62,23 @@ properties:
 
   reg:
     maxItems: 1
+    description:
+      For instances using the qcom,msm-iommu-v1/-v2 fallbacks, the
+      optional "SMMU local" register region used for interrupt routing
+      configuration. For instances with per-instance compatibles, the
+      SMMU global register space, used for stream mapping configuration
+      on non-secured instances and for the implementation-defined
+      prefetch registers on all instances.
 
   ranges: true
 
   qcom,iommu-secure-id:
     $ref: /schemas/types.yaml#/definitions/uint32
     description:
-      The SCM secure ID of the IOMMU instance.
+      The SCM secure ID of the IOMMU instance. When absent on instances
+      with per-instance compatibles, the instance is not managed by the
+      secure world and the OS programs the whole global register space
+      (stream mapping included) directly.
 
   '#address-cells':
     const: 1
@@ -104,6 +126,22 @@ required:
   - '#size-cells'
   - '#iommu-cells'
 
+allOf:
+  - if:
+      properties:
+        compatible:
+          contains:
+            enum:
+              - qcom,msm8226-gpu-iommu
+              - qcom,msm8226-mdp-iommu
+              - qcom,msm8226-vfe-iommu
+              - qcom,msm8974-gpu-iommu
+              - qcom,msm8974-mdp-iommu
+              - qcom,msm8974-venus-iommu
+    then:
+      required:
+        - reg
+
 additionalProperties: false
 
 examples:
@@ -130,3 +168,43 @@ examples:
         interrupts = <GIC_SPI 70 IRQ_TYPE_LEVEL_HIGH>;
       };
     };
+
+  - |
+    #include <dt-bindings/interrupt-controller/arm-gic.h>
+
+    vfe_iommu: iommu@fda44000 {
+      compatible = "qcom,msm8226-vfe-iommu";
+      reg = <0xfda44000 0x2600>;
+      #address-cells = <1>;
+      #size-cells = <1>;
+      #iommu-cells = <1>;
+      ranges = <0 0xfda4c000 0x3000>;
+
+      /* MMCC indices from dt-bindings/clock/qcom,mmcc-msm8974.h. */
+      clocks = <&mmcc 90>, /* CAMSS_VFE_VFE_AHB_CLK */
+               <&mmcc 91>, /* CAMSS_VFE_VFE_AXI_CLK */
+               <&mmcc 85>; /* CAMSS_TOP_AHB_CLK */
+      clock-names = "iface", "bus", "tbu";
+      power-domains = <&mmcc 3>; /* CAMSS_VFE_GDSC */
+
+      /* VFE0 */
+      iommu-ctx@0 {
+        compatible = "qcom,msm-iommu-v1-ns";
+        reg = <0x0 0x1000>;
+        interrupts = <GIC_SPI 65 IRQ_TYPE_LEVEL_HIGH>;
+      };
+
+      /* VFE1 */
+      iommu-ctx@1000 {
+        compatible = "qcom,msm-iommu-v1-ns";
+        reg = <0x1000 0x1000>;
+        interrupts = <GIC_SPI 65 IRQ_TYPE_LEVEL_HIGH>;
+      };
+
+      /* CPP */
+      iommu-ctx@2000 {
+        compatible = "qcom,msm-iommu-v1-ns";
+        reg = <0x2000 0x1000>;
+        interrupts = <GIC_SPI 65 IRQ_TYPE_LEVEL_HIGH>;
+      };
+    };
diff --git a/Documentation/devicetree/bindings/leds/qcom,pm8941-flash-led.yaml b/Documentation/devicetree/bindings/leds/qcom,pm8941-flash-led.yaml
new file mode 100644
index 000000000..f07069203
--- /dev/null
+++ b/Documentation/devicetree/bindings/leds/qcom,pm8941-flash-led.yaml
@@ -0,0 +1,71 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/leds/qcom,pm8941-flash-led.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Qualcomm PM8226 and PM8941 first-generation torch LED controller
+
+maintainers:
+  - Timothy Schmidt <timschmidt@gmail.com>
+
+description: |
+  These PMICs contain the first-generation flash LED peripheral, with type
+  0x18 and subtype 1 or 2. Its register layout differs from later SPMI flash
+  controllers. Torch mode programs the two output current registers together,
+  in 12.5 mA steps up to 200 mA. A single logical torch is described here.
+
+properties:
+  compatible:
+    oneOf:
+      - const: qcom,pm8941-flash-led
+      - items:
+          - const: qcom,pm8226-flash-led
+          - const: qcom,pm8941-flash-led
+
+  reg:
+    maxItems: 1
+
+  vin-supply:
+    description: Optional supply for the torch outputs.
+
+  led:
+    type: object
+    $ref: common.yaml#
+    unevaluatedProperties: false
+
+    properties:
+      led-max-microamp:
+        minimum: 12500
+        maximum: 200000
+        description: Maximum programmed torch current for each output.
+
+    required:
+      - led-max-microamp
+
+required:
+  - compatible
+  - reg
+  - led
+
+additionalProperties: false
+
+examples:
+  - |
+    #include <dt-bindings/leds/common.h>
+
+    pmic {
+        #address-cells = <1>;
+        #size-cells = <0>;
+
+        led-controller@d300 {
+            compatible = "qcom,pm8226-flash-led", "qcom,pm8941-flash-led";
+            reg = <0xd300>;
+
+            led {
+                function = LED_FUNCTION_TORCH;
+                color = <LED_COLOR_ID_WHITE>;
+                led-max-microamp = <200000>;
+            };
+        };
+    };
diff --git a/Documentation/devicetree/bindings/media/qcom,msm8226-camss.yaml b/Documentation/devicetree/bindings/media/qcom,msm8226-camss.yaml
new file mode 100644
index 000000000..2dc0dbee5
--- /dev/null
+++ b/Documentation/devicetree/bindings/media/qcom,msm8226-camss.yaml
@@ -0,0 +1,250 @@
+# SPDX-License-Identifier: (GPL-2.0 OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/media/qcom,msm8226-camss.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Qualcomm MSM8226 CAMSS ISP
+
+maintainers:
+  - Robert Foss <robert.foss@linaro.org>
+  - Todor Tomov <todor.too@gmail.com>
+
+description: |
+  The CAMSS IP is a CSI decoder and ISP present on Qualcomm platforms.
+  MSM8226 has the MSM8916 blocks without the separate CAMSS AHB clock.
+
+properties:
+  compatible:
+    const: qcom,msm8226-camss
+
+  clocks:
+    minItems: 18
+    maxItems: 18
+
+  clock-names:
+    items:
+      - const: top_ahb
+      - const: ispif_ahb
+      - const: csiphy0_timer
+      - const: csiphy1_timer
+      - const: csi0_ahb
+      - const: csi0
+      - const: csi0_phy
+      - const: csi0_pix
+      - const: csi0_rdi
+      - const: csi1_ahb
+      - const: csi1
+      - const: csi1_phy
+      - const: csi1_pix
+      - const: csi1_rdi
+      - const: vfe0
+      - const: csi_vfe0
+      - const: vfe_ahb
+      - const: vfe_axi
+
+  interrupts:
+    minItems: 6
+    maxItems: 6
+
+  interrupt-names:
+    items:
+      - const: csiphy0
+      - const: csiphy1
+      - const: csid0
+      - const: csid1
+      - const: ispif
+      - const: vfe0
+
+  iommus:
+    maxItems: 1
+
+  power-domains:
+    items:
+      - description: VFE GDSC - Video Front End, Global Distributed Switch Controller.
+
+  ports:
+    $ref: /schemas/graph.yaml#/properties/ports
+
+    description:
+      CSI input ports.
+
+    properties:
+      port@0:
+        $ref: /schemas/graph.yaml#/$defs/port-base
+        unevaluatedProperties: false
+        description:
+          Input port for receiving CSI data.
+
+        properties:
+          endpoint:
+            $ref: video-interfaces.yaml#
+            unevaluatedProperties: false
+
+            properties:
+              data-lanes:
+                description:
+                  An array of physical data lanes indexes.
+                  Position of an entry determines the logical
+                  lane number, while the value of an entry
+                  indicates physical lane index. Lane swapping
+                  is supported. Physical lane indexes;
+                  0, 2, 3, 4.
+                minItems: 1
+                maxItems: 4
+
+              bus-type:
+                enum:
+                  - 4 # MEDIA_BUS_TYPE_CSI2_DPHY
+
+            required:
+              - data-lanes
+
+      port@1:
+        $ref: /schemas/graph.yaml#/$defs/port-base
+        unevaluatedProperties: false
+        description:
+          Input port for receiving CSI data.
+
+        properties:
+          endpoint:
+            $ref: video-interfaces.yaml#
+            unevaluatedProperties: false
+
+            properties:
+              data-lanes:
+                minItems: 1
+                maxItems: 4
+
+              bus-type:
+                enum:
+                  - 4 # MEDIA_BUS_TYPE_CSI2_DPHY
+
+            required:
+              - data-lanes
+
+  reg:
+    minItems: 9
+    maxItems: 9
+
+  reg-names:
+    items:
+      - const: csiphy0
+      - const: csiphy0_clk_mux
+      - const: csiphy1
+      - const: csiphy1_clk_mux
+      - const: csid0
+      - const: csid1
+      - const: ispif
+      - const: csi_clk_mux
+      - const: vfe0
+
+  vdda-supply:
+    description:
+      Definition of the regulator used as analog power supply.
+
+required:
+  - clock-names
+  - clocks
+  - compatible
+  - interrupt-names
+  - interrupts
+  - iommus
+  - power-domains
+  - reg
+  - reg-names
+  - vdda-supply
+
+additionalProperties: false
+
+examples:
+  - |
+    #include <dt-bindings/interrupt-controller/arm-gic.h>
+    #include <dt-bindings/clock/qcom,mmcc-msm8974.h>
+
+    camss: camss@fda0ac00 {
+      compatible = "qcom,msm8226-camss";
+
+      clocks = <&mmcc CAMSS_TOP_AHB_CLK>,
+        <&mmcc CAMSS_ISPIF_AHB_CLK>,
+        <&mmcc CAMSS_PHY0_CSI0PHYTIMER_CLK>,
+        <&mmcc CAMSS_PHY1_CSI1PHYTIMER_CLK>,
+        <&mmcc CAMSS_CSI0_AHB_CLK>,
+        <&mmcc CAMSS_CSI0_CLK>,
+        <&mmcc CAMSS_CSI0PHY_CLK>,
+        <&mmcc CAMSS_CSI0PIX_CLK>,
+        <&mmcc CAMSS_CSI0RDI_CLK>,
+        <&mmcc CAMSS_CSI1_AHB_CLK>,
+        <&mmcc CAMSS_CSI1_CLK>,
+        <&mmcc CAMSS_CSI1PHY_CLK>,
+        <&mmcc CAMSS_CSI1PIX_CLK>,
+        <&mmcc CAMSS_CSI1RDI_CLK>,
+        <&mmcc CAMSS_VFE_VFE0_CLK>,
+        <&mmcc CAMSS_CSI_VFE0_CLK>,
+        <&mmcc CAMSS_VFE_VFE_AHB_CLK>,
+        <&mmcc CAMSS_VFE_VFE_AXI_CLK>;
+
+      clock-names = "top_ahb",
+        "ispif_ahb",
+        "csiphy0_timer",
+        "csiphy1_timer",
+        "csi0_ahb",
+        "csi0",
+        "csi0_phy",
+        "csi0_pix",
+        "csi0_rdi",
+        "csi1_ahb",
+        "csi1",
+        "csi1_phy",
+        "csi1_pix",
+        "csi1_rdi",
+        "vfe0",
+        "csi_vfe0",
+        "vfe_ahb",
+        "vfe_axi";
+
+      interrupts = <GIC_SPI 78 IRQ_TYPE_EDGE_RISING>,
+        <GIC_SPI 79 IRQ_TYPE_EDGE_RISING>,
+        <GIC_SPI 51 IRQ_TYPE_EDGE_RISING>,
+        <GIC_SPI 52 IRQ_TYPE_EDGE_RISING>,
+        <GIC_SPI 55 IRQ_TYPE_EDGE_RISING>,
+        <GIC_SPI 57 IRQ_TYPE_EDGE_RISING>;
+
+      interrupt-names = "csiphy0",
+        "csiphy1",
+        "csid0",
+        "csid1",
+        "ispif",
+        "vfe0";
+
+      iommus = <&vfe_iommu 0>;
+
+      power-domains = <&mmcc CAMSS_VFE_GDSC>;
+
+      reg = <0xfda0ac00 0x200>,
+        <0xfda00030 0x4>,
+        <0xfda0b000 0x200>,
+        <0xfda00038 0x4>,
+        <0xfda08000 0x100>,
+        <0xfda08400 0x100>,
+        <0xfda0a000 0x500>,
+        <0xfda00020 0x10>,
+        <0xfda10000 0x1000>;
+
+      reg-names = "csiphy0",
+        "csiphy0_clk_mux",
+        "csiphy1",
+        "csiphy1_clk_mux",
+        "csid0",
+        "csid1",
+        "ispif",
+        "csi_clk_mux",
+        "vfe0";
+
+      vdda-supply = <&reg_1v2>;
+
+      ports {
+        #address-cells = <1>;
+        #size-cells = <0>;
+      };
+    };
