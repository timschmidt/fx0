From 9c90dae786c6b1a9cb4c18323d6d4b719f699267 Mon Sep 17 00:00:00 2001
From: Timothy Schmidt <timschmidt@gmail.com>
Date: Sat, 31 Oct 2026 07:56:00 -0400
Subject: [PATCH 2/4] ARM: dts: qcom: msm8226: describe the SLIMbus NGD and BAM

Describe the remotely controlled SLIMbus BAM and NGD controller with the
original register windows, interrupts and application message pipes. Keep
both controllers disabled in the common SoC description.

Adapted from the original implementation linked below. Original authors:
Timothy Schmidt and Claude Opus 5.5. Only the common SoC description is
carried; the complete Fx0 board is preserved separately without the early
experiment.

Current-tree refresh and validation prepared with OpenAI Codex assistance.
Audio execution testing is excluded; current hardware validation is
pending.

Link: https://github.com/timschmidt/fx0-linux/commit/be15b668b3ab83d8850b696f580167b46e3ccd44
---
 arch/arm/boot/dts/qcom/qcom-msm8226.dtsi | 29 ++++++++++++++++++++++++
 1 file changed, 29 insertions(+)

diff --git a/arch/arm/boot/dts/qcom/qcom-msm8226.dtsi b/arch/arm/boot/dts/qcom/qcom-msm8226.dtsi
index ffe351f01..6aac5f308 100644
--- a/arch/arm/boot/dts/qcom/qcom-msm8226.dtsi
+++ b/arch/arm/boot/dts/qcom/qcom-msm8226.dtsi
@@ -1650,6 +1650,35 @@ gmu_sram: gmu-sram@0 {
 			};
 		};
 
+		slimbam: dma-controller@fe104000 {
+			compatible = "qcom,bam-v1.4.0";
+			reg = <0xfe104000 0x20000>;
+			interrupts = <GIC_SPI 164 IRQ_TYPE_LEVEL_HIGH>;
+			#dma-cells = <1>;
+			qcom,ee = <1>;
+			qcom,controlled-remotely;
+			num-channels = <31>;
+			qcom,num-ees = <2>;
+			status = "disabled";
+		};
+
+		slim_msm: slimbus@fe12f000 {
+			compatible = "qcom,slim-ngd-v1.5.0";
+			reg = <0xfe12f000 0x35000>;
+			interrupts = <GIC_SPI 163 IRQ_TYPE_LEVEL_HIGH>;
+			dmas = <&slimbam 3>, <&slimbam 4>;
+			dma-names = "rx", "tx";
+			#address-cells = <1>;
+			#size-cells = <0>;
+			status = "disabled";
+
+			slim@1 {
+				reg = <1>;
+				#address-cells = <2>;
+				#size-cells = <0>;
+			};
+		};
+
 		adsp: remoteproc@fe200000 {
 			compatible = "qcom,msm8226-adsp-pil";
 			reg = <0xfe200000 0x100>;
