From f8048f86c324708bb3e6e347e04c4f252b2b3732 Mon Sep 17 00:00:00 2001
From: Timothy Schmidt <timschmidt@gmail.com>
Date: Thu, 29 Oct 2026 07:46:16 -0400
Subject: [PATCH 13/20] iommu: qcom_iommu: Add the MSM8226 display
 configuration

Original integration rationale and historical observations follow. These
observations do not qualify hardware on this refreshed base.

Use the MSM8226 downstream MDP prefetch settings. This generation uses
short descriptors and secured global configuration, with context
restoration across MDSS power collapse.

Refreshed from integration source
b506b8cd827d546d05e3332b77a2d4a4a29abe83. Current-base adaptation and
host qualification used OpenAI Codex. Human review and new DCO
certification remain pending.
---
 drivers/iommu/arm/arm-smmu/qcom_iommu.c | 34 +++++++++++++++++++++++++
 1 file changed, 34 insertions(+)

diff --git a/drivers/iommu/arm/arm-smmu/qcom_iommu.c b/drivers/iommu/arm/arm-smmu/qcom_iommu.c
index febb59e72..b4e9cfed9 100644
--- a/drivers/iommu/arm/arm-smmu/qcom_iommu.c
+++ b/drivers/iommu/arm/arm-smmu/qcom_iommu.c
@@ -3,6 +3,8 @@
  * IOMMU API for QCOM secure IOMMUs.  Somewhat based on arm-smmu.c
  *
  * Copyright (C) 2013 ARM Limited
+ * Copyright (c) 2013, The Linux Foundation. All rights reserved.
+ * Copyright (c) 2026 Timothy Schmidt
  * Copyright (C) 2017 Red Hat
  */
 
@@ -1218,6 +1220,37 @@ static const struct qcom_iommu_cfg msm8974_gpu_cfg = {
 	.num_sids = ARRAY_SIZE(msm8974_gpu_sids),
 };
 
+static const struct qcom_iommu_bfb_reg msm8226_mdp_bfb[] = {
+	{ 0x04c, 0xffffffff },
+	{ 0x050, 0x00000000 },
+	{ 0x514, 0x00000004 },
+	{ 0x540, 0x00000010 },
+	{ 0x56c, 0x00000000 },
+	{ 0x0ac, 0x00000000 },
+	{ 0x15c, 0x00000013 },
+	{ 0x20c, 0x00000017 },
+	{ 0x314, 0x00000000 },
+	{ 0x394, 0x00000013 },
+	{ 0x414, 0x00000023 },
+	{ 0x008, 0x00000000 },
+	{ 0x00c, 0x00000000 },
+	{ 0x010, 0x00000000 },
+	{ 0x014, 0x00000000 },
+	{ 0x018, 0x00000000 },
+	{ 0x01c, 0x00000000 },
+	{ 0x020, 0x00000000 },
+};
+
+static const struct qcom_iommu_cfg msm8226_mdp_cfg = {
+	.halt = true,
+	.no_stall = true,
+	.fmt = ARM_V7S,
+	.no_afe = true,
+	.ctx_restore = true,
+	.bfb = msm8226_mdp_bfb,
+	.num_bfb = ARRAY_SIZE(msm8226_mdp_bfb),
+};
+
 static const struct qcom_iommu_bfb_reg msm8974_mdp_bfb[] = {
 	{ 0x04c, 0xffffffff },
 	{ 0x050, 0x00000000 },
@@ -1290,6 +1323,7 @@ static const struct of_device_id qcom_iommu_of_match[] = {
 	{ .compatible = "qcom,msm-iommu-v1" },
 	{ .compatible = "qcom,msm-iommu-v2" },
 	{ .compatible = "qcom,msm8974-gpu-iommu", .data = &msm8974_gpu_cfg },
+	{ .compatible = "qcom,msm8226-mdp-iommu", .data = &msm8226_mdp_cfg },
 	{ .compatible = "qcom,msm8974-mdp-iommu", .data = &msm8974_mdp_cfg },
 	{ .compatible = "qcom,msm8974-venus-iommu", .data = &msm8974_venus_cfg },
 	{ /* sentinel */ }
