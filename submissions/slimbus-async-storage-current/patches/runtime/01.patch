-	bool released = false;
+	bool released = false, prepared = false;
 
 	spin_lock_irqsave(&ctrl->txn_lock, flags);
-	if (idr_find(&ctrl->tid_idr, txn->tid) == txn) {
+	pending = idr_find(&ctrl->tid_idr, txn->tid);
