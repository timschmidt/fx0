@@ -126,17 +234,21 @@ EXPORT_SYMBOL_GPL(slim_prepare_txn);
  */
 bool slim_free_txn_tid(struct slim_controller *ctrl, struct slim_msg_txn *txn)
 {
+	struct slim_pending_msg *pending;
