From a37ea8cff8cf0243e279f4168a299993c3189215 Mon Sep 17 00:00:00 2001
From: Timothy Schmidt <timschmidt@gmail.com>
Date: Mon, 16 Nov 2026 23:23:00 -0500
Subject: [PATCH] soc: qcom: spm: Verify MSM8226 CPU collapse readiness

Record the CPU owning each MSM8226 CPU SAW before publishing it. Expose
a read-only admission check for that CPU with IRQs disabled: match the
controller version, disabled AVS, configuration, delay, safe control state
and every word of the 64-byte CPU sequence program before collapse.

The retained SPM/probe/idle model plus readiness corruption cases passes
1749 cases and 29 behavioral controls. This establishes a software admission
check; it does not establish a physical collapse or wake-voltage proof.

Codex generated this source, host tests and draft message during the Fx0
bringup. Human review and DCO remain pending. This feature is local and
has not been submitted; it has no Fixes tag.
---
 drivers/soc/qcom/spm.c | 32 ++++++++++++++++++++++++++++++++
 include/soc/qcom/spm.h |  3 +++
 2 files changed, 35 insertions(+)

diff --git a/drivers/soc/qcom/spm.c b/drivers/soc/qcom/spm.c
index a18d8fbaf54d..85b1d19e12c0 100644
--- a/drivers/soc/qcom/spm.c
+++ b/drivers/soc/qcom/spm.c
@@ -319,6 +319,32 @@ int spm_set_l2_low_power_mode(struct spm_driver_data *drv,
 	return spm_8226_l2_set_mode(drv->l2_map, mode);
 }
 
+int spm_msm8226_cpu_ready(struct spm_driver_data *drv)
+{
+	const struct spm_reg_data *data;
+	u32 word;
+	int i;
+
+	if (!drv || drv->reg_data != &spm_reg_8226_cpu)
+		return -ENODEV;
+	if (!irqs_disabled() || raw_smp_processor_id() != drv->reg_cpu)
+		return -EPERM;
+	data = drv->reg_data;
+	if (readl_relaxed(drv->reg_base + 0xfd0) != 0x20010000 ||
+	    readl_relaxed(drv->reg_base + 0x20) & BIT(0) ||
+	    spm_register_read(drv, SPM_REG_CFG) != data->spm_cfg ||
+	    spm_register_read(drv, SPM_REG_DLY) != data->spm_dly ||
+	    spm_register_read(drv, SPM_REG_SPM_CTL) & ~SPM_CTL_EN)
+		return -EIO;
+	for (i = 0; i < MAX_SEQ_DATA; i += sizeof(word)) {
+		word = data->seq[i] | (u32)data->seq[i + 1] << 8 |
+		       (u32)data->seq[i + 2] << 16 | (u32)data->seq[i + 3] << 24;
+		if (readl_relaxed(drv->reg_base + 0x80 + i) != word)
+			return -EIO;
+	}
+	return 0;
+}
+
 static void spm_force_disable(struct spm_driver_data *drv, u32 saved_ctl)
 {
 	u32 mask = ~(SPM_CTL_INDEX << SPM_CTL_INDEX_SHIFT);
@@ -682,6 +708,12 @@ static int spm_dev_probe(struct platform_device *pdev)
 
 	drv->reg_data = match_id->data;
 	drv->dev = &pdev->dev;
+	if (drv->reg_data == &spm_reg_8226_cpu) {
+		ret = spm_get_cpu(&pdev->dev);
+		if (ret < 0)
+			return ret;
+		drv->reg_cpu = ret;
+	}
 
 	if (drv->reg_data->pmic_arbiter_master) {
 		ret = spm_8226_l2_register(pdev, drv);
diff --git a/include/soc/qcom/spm.h b/include/soc/qcom/spm.h
index 6f741971a307..bc69d4bb3db5 100644
--- a/include/soc/qcom/spm.h
+++ b/include/soc/qcom/spm.h
@@ -20,6 +20,9 @@ struct spm_driver_data;
 int spm_set_low_power_mode(struct spm_driver_data *drv,
 			   enum pm_sleep_mode mode);
 
+/* Exact MSM8226 CPU program/state check on its own CPU, with IRQs off. */
+int spm_msm8226_cpu_ready(struct spm_driver_data *drv);
+
 enum spm_l2_sleep_mode {
 	SPM_L2_MODE_DISABLED,
 	SPM_L2_MODE_RETENTION,
