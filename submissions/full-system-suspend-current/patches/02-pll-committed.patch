From ac03d871113a3d2eaea081d00e50d7ad0d779a59 Mon Sep 17 00:00:00 2001
From: Timothy Schmidt <timschmidt@gmail.com>
Date: Mon, 16 Nov 2026 23:22:59 -0500
Subject: [PATCH] clk: qcom: Restore MSM8226 A7PLL context before activation

When the experimental MSM8226 coordinator is configured, retain the A7PLL
configuration and rate fields for restoration after cluster context loss.
Verify or restore them under CCF's prepare lock before output activation.
Keep the cached L/M/N target current after set_rate, reject FSM ownership,
and verify critical PLL disable before allowing any configuration writes.

The exact-source context model passes 393 cases and four mutation controls.
Actual PLL/APCS/GCC probes preserve ordinary/other-SoC scope in eight cases
with four controls. Retained PLL/mux/CPR runtime and startup programs pass.
Hardware context loss and electrical behavior remain unqualified.

Codex generated this source, host tests and draft message during the Fx0
bringup. Human review and DCO remain pending. This feature is local and
has not been submitted; it has no Fixes tag.
---
 drivers/clk/qcom/a53-pll.c         | 18 +++++++
 drivers/clk/qcom/clk-pll-suspend.h | 86 ++++++++++++++++++++++++++++++
 drivers/clk/qcom/clk-pll.c         | 19 ++++++-
 drivers/clk/qcom/clk-pll.h         | 12 +++++
 4 files changed, 133 insertions(+), 2 deletions(-)
 create mode 100644 drivers/clk/qcom/clk-pll-suspend.h

diff --git a/drivers/clk/qcom/a53-pll.c b/drivers/clk/qcom/a53-pll.c
index ff638f5e5e19..77e5384eb7c7 100644
--- a/drivers/clk/qcom/a53-pll.c
+++ b/drivers/clk/qcom/a53-pll.c
@@ -116,6 +116,24 @@ static int qcom_a53pll_probe(struct platform_device *pdev)
 	pll->status_bit = 16;
 	/* Returning an uncertain CPU PLL to CCF can select it after an error. */
 	pll->critical_rate = of_device_is_compatible(np, "qcom,msm8226-a7pll");
+	if (pll->critical_rate && IS_ENABLED(CONFIG_QCOM_MSM8226_PM)) {
+		ret = regmap_read(regmap, pll->config_reg, &pll->suspend_config);
+		if (ret)
+			return ret;
+		ret = regmap_read(regmap, pll->l_reg, &pll->suspend_l);
+		if (ret)
+			return ret;
+		ret = regmap_read(regmap, pll->m_reg, &pll->suspend_m);
+		if (ret)
+			return ret;
+		ret = regmap_read(regmap, pll->n_reg, &pll->suspend_n);
+		if (ret)
+			return ret;
+		pll->suspend_l &= 0x3ff;
+		pll->suspend_m &= 0x7ffff;
+		pll->suspend_n &= 0x7ffff;
+		pll->suspend_valid = true;
+	}
 
 	pll->freq_tbl = qcom_a53pll_get_freq_tbl(dev);
 	if (!pll->freq_tbl) {
diff --git a/drivers/clk/qcom/clk-pll-suspend.h b/drivers/clk/qcom/clk-pll-suspend.h
new file mode 100644
index 000000000000..f5f0630d01d0
--- /dev/null
+++ b/drivers/clk/qcom/clk-pll-suspend.h
@@ -0,0 +1,86 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef __QCOM_CLK_PLL_SUSPEND_H__
+#define __QCOM_CLK_PLL_SUSPEND_H__
+
+/* Called under CCF's prepare lock, before output enable or mux selection. */
+static int clk_pll_suspend_prepare(struct clk_hw *hw)
+{
+	struct clk_pll *pll = to_clk_pll(hw);
+	u32 offsets[4], expected[4], masks[4];
+	u32 value, mode;
+	bool different = false;
+	int i, ret;
+
+	if (!pll->suspend_valid)
+		return 0;
+	if (!pll->suspend_l)
+		return clk_pll_rate_error(pll, -EINVAL);
+	offsets[0] = pll->config_reg;
+	offsets[1] = pll->l_reg;
+	offsets[2] = pll->m_reg;
+	offsets[3] = pll->n_reg;
+	expected[0] = pll->suspend_config;
+	expected[1] = pll->suspend_l;
+	expected[2] = pll->suspend_m;
+	expected[3] = pll->suspend_n;
+	masks[0] = U32_MAX;
+	masks[1] = 0x3ff;
+	masks[2] = 0x7ffff;
+	masks[3] = 0x7ffff;
+	for (i = 0; i < ARRAY_SIZE(offsets); i++) {
+		ret = regmap_read(pll->clkr.regmap, offsets[i], &value);
+		if (ret)
+			return clk_pll_rate_error(pll, ret);
+		if ((value & masks[i]) != expected[i])
+			different = true;
+	}
+	ret = regmap_read(pll->clkr.regmap, pll->mode_reg, &mode);
+	if (ret)
+		return clk_pll_rate_error(pll, ret);
+	if (mode & PLL_VOTE_FSM_ENA)
+		return clk_pll_rate_error(pll, -EOPNOTSUPP);
+	if (!different) {
+		pll->suspend_armed = false;
+		return 0;
+	}
+	if (!pll->suspend_armed && mode & (PLL_OUTCTRL | PLL_BYPASSNL | PLL_RESET_N))
+		return clk_pll_rate_error(pll, -EBUSY);
+	ret = clk_pll_disable_checked(hw);
+	if (ret)
+		return clk_pll_rate_error(pll, ret);
+	ret = regmap_read(pll->clkr.regmap, pll->mode_reg, &mode);
+	if (!ret && mode & (PLL_OUTCTRL | PLL_BYPASSNL | PLL_RESET_N | PLL_VOTE_FSM_ENA))
+		ret = -EIO;
+	if (ret)
+		return clk_pll_rate_error(pll, ret);
+	for (i = 0; i < ARRAY_SIZE(offsets); i++) {
+		ret = regmap_update_bits(pll->clkr.regmap, offsets[i], masks[i], expected[i]);
+		if (ret)
+			return clk_pll_rate_error(pll, ret);
+		ret = regmap_read(pll->clkr.regmap, offsets[i], &value);
+		if (ret)
+			return clk_pll_rate_error(pll, ret);
+		if ((value & masks[i]) != expected[i])
+			return clk_pll_rate_error(pll, -EIO);
+	}
+	pll->suspend_armed = false;
+	return 0;
+}
+
+static void clk_pll_suspend_unprepare(struct clk_hw *hw)
+{
+	struct clk_pll *pll = to_clk_pll(hw);
+	u32 mode;
+	int ret;
+
+	if (!pll->suspend_valid)
+		return;
+	ret = regmap_read(pll->clkr.regmap, pll->mode_reg, &mode);
+	if (!ret && mode & (PLL_OUTCTRL | PLL_BYPASSNL | PLL_RESET_N | PLL_VOTE_FSM_ENA))
+		ret = -EIO;
+	if (clk_pll_rate_error(pll, ret))
+		return;
+	pll->suspend_armed = true;
+}
+
+#endif
diff --git a/drivers/clk/qcom/clk-pll.c b/drivers/clk/qcom/clk-pll.c
index 49f1d691d568..850a22c4f558 100644
--- a/drivers/clk/qcom/clk-pll.c
+++ b/drivers/clk/qcom/clk-pll.c
@@ -84,9 +84,15 @@ static int clk_pll_disable_checked(struct clk_hw *hw)
 		return ret;
 	/* Skip if in FSM mode */
 	if (val & PLL_VOTE_FSM_ENA)
-		return 0;
+		return pll->critical_rate ? -EOPNOTSUPP : 0;
 	mask = PLL_OUTCTRL | PLL_RESET_N | PLL_BYPASSNL;
-	return regmap_update_bits(pll->clkr.regmap, pll->mode_reg, mask, 0);
+	ret = regmap_update_bits(pll->clkr.regmap, pll->mode_reg, mask, 0);
+	if (ret || !pll->critical_rate)
+		return ret;
+	ret = regmap_read(pll->clkr.regmap, pll->mode_reg, &val);
+	if (!ret && val & mask)
+		ret = -EIO;
+	return ret;
 }
 
 static void clk_pll_disable(struct clk_hw *hw)
@@ -98,6 +104,8 @@ static void clk_pll_disable(struct clk_hw *hw)
 		pr_err("%s: PLL disable failed: %d\n", clk_hw_get_name(hw), ret);
 }
 
+#include "clk-pll-suspend.h"
+
 static unsigned long
 clk_pll_recalc_rate(struct clk_hw *hw, unsigned long parent_rate)
 {
@@ -365,6 +373,11 @@ clk_pll_sr2_set_rate(struct clk_hw *hw, unsigned long rate, unsigned long prate)
 		return clk_pll_rate_error(pll, ret);
 	if (pll->critical_rate && clk_pll_recalc_rate(hw, prate) != f->freq)
 		return clk_pll_rate_error(pll, -EIO);
+	if (pll->suspend_valid) {
+		pll->suspend_l = f->l;
+		pll->suspend_m = f->m;
+		pll->suspend_n = f->n;
+	}
 
 	if (enabled)
 		return clk_pll_sr2_enable(hw);
@@ -373,6 +386,8 @@ clk_pll_sr2_set_rate(struct clk_hw *hw, unsigned long rate, unsigned long prate)
 }
 
 const struct clk_ops clk_pll_sr2_ops = {
+	.prepare = clk_pll_suspend_prepare,
+	.unprepare = clk_pll_suspend_unprepare,
 	.enable = clk_pll_sr2_enable,
 	.disable = clk_pll_disable,
 	.set_rate = clk_pll_sr2_set_rate,
diff --git a/drivers/clk/qcom/clk-pll.h b/drivers/clk/qcom/clk-pll.h
index 73f7165809a8..d77250eba8fa 100644
--- a/drivers/clk/qcom/clk-pll.h
+++ b/drivers/clk/qcom/clk-pll.h
@@ -35,6 +35,12 @@ struct pll_freq_tbl {
  * @status_bit: ANDed with @status_reg to determine if PLL is enabled
  * @freq_tbl: PLL frequency table
  * @critical_rate: Stop on uncertain CPU PLL programming; CCF can discard errors
+ * @suspend_valid: MSM8226 configuration snapshot is available
+ * @suspend_armed: CCF unprepared the PLL after its last verified disable
+ * @suspend_config: original static configuration register
+ * @suspend_l: latest successfully programmed L value
+ * @suspend_m: latest successfully programmed M value
+ * @suspend_n: latest successfully programmed N value
  * @hw: handle between common and hardware-specific interfaces
  */
 struct clk_pll {
@@ -48,6 +54,12 @@ struct clk_pll {
 	u8	post_div_width;
 	u8	post_div_shift;
 	bool	critical_rate;
+	bool	suspend_valid;
+	bool	suspend_armed;
+	u32	suspend_config;
+	u32	suspend_l;
+	u32	suspend_m;
+	u32	suspend_n;
 
 	const struct pll_freq_tbl *freq_tbl;
 
