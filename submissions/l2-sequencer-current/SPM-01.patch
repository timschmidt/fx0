From eea388024394a49b750791a7e1161152f298dd05 Mon Sep 17 00:00:00 2001
From: Codex <codex@openai.com>
Date: Mon, 16 Nov 2026 18:08:43 -0500
Subject: [PATCH] soc: qcom: spm: Add verified MSM8226 L2 low-power programs

The MSM8226 L2 owner currently supplies APC voltage arbitration only.
Its CPU sequence buffer cannot hold the complete vendor L2 program set.
Add all four v2 RET, GDHS, PC-without-RPM and PC-with-RPM programs in a
separate 84-byte table, including two END padding bytes. Preserve the
vendor data attribution and leave the 64-byte CPU tables unchanged.

Load and verify the programs with the sequencer disabled before syscon
publication. Never issue voltage/reset commands or change APC data slots
during this setup. Fail before publication on partial or corrupt setup.

Add a separate fallible L2 mode API for CPU0 with local IRQs off; arming
also requires secondary CPUs offline. This serializes against CPU0 APC
IPIs, but does not substitute for the system coordinator's CPR, voltage,
clock and RPM/MPM quiescence contract. Verify controller state and all
program words before arming. Read back the selected index and enable.
An uncertain arm is disabled and verified before returning an error.
Two unverified disable attempts are fatal so generic WFI cannot run
with an unknown collapse enable. Initialization never enables a mode.

Host models cover every setup/arm I/O point, partial and corrupted state,
applied/unapplied errors, context rejection and both fatal recovery paths.
Native ARM/ARM64 ordinary/RT builds retain the exact parent RPMsg kernel
documentation warnings and introduce no new diagnostics. Strict style
checks pass. Actual firmware, cache/SCM handoff, global RPM/MPM entry and
physical acceptance remain unqualified; keep the CPR deep-suspend guard.

Codex generated this change and its host qualification. Human review and
DCO certification remain pending. Nothing has been submitted.
---
 drivers/soc/qcom/spm-msm8226-l2.h | 138 ++++++++++++++++++++++++++++++
 drivers/soc/qcom/spm.c            |  30 ++++++-
 include/soc/qcom/spm.h            |  13 +++
 3 files changed, 179 insertions(+), 2 deletions(-)

diff --git a/drivers/soc/qcom/spm-msm8226-l2.h b/drivers/soc/qcom/spm-msm8226-l2.h
index 1cb42580ac6..27ee64293b3 100644
--- a/drivers/soc/qcom/spm-msm8226-l2.h
+++ b/drivers/soc/qcom/spm-msm8226-l2.h
@@ -3,8 +3,146 @@
 #define __QCOM_SPM_MSM8226_L2_H__
 
 #include <linux/errno.h>
+#include <linux/kernel.h>
+#include <linux/panic.h>
 #include <linux/regmap.h>
 
+#include <soc/qcom/spm.h>
+
+/*
+ * MSM8226 v2 L2 RET, GDHS, PC without RPM and PC with RPM programs.
+ * From msm8226-v2-pm.dtsi, Copyright (c) 2013-2014 The Linux Foundation.
+ * The final two bytes are END padding; the hardware has 32 sequence words.
+ */
+static const u32 spm_8226_l2_sequence[] = {
+	0x0f000300, 0x6b322000, 0x42d0e0c0, 0x024e5003,
+	0xc0e0d002, 0x32026b22, 0x32000f50, 0xd0e010b0,
+	0xf042c06b, 0xb0010311, 0x02024e50, 0xe012d0c0,
+	0x5032026b, 0x32000ff0, 0xd0e010b0, 0xf042c06b,
+	0xb0010711, 0x02024e50, 0xe012d0c0, 0x5032026b,
+	0x0f0f0ff0,
+};
+
+#define SPM_8226_L2_CTL		0x30
+#define SPM_8226_L2_SEQ		0x80
+
+static inline int spm_8226_l2_sequence_verify(struct regmap *map)
+{
+	unsigned int i, value;
+	int ret;
+
+	for (i = 0; i < ARRAY_SIZE(spm_8226_l2_sequence); i++) {
+		ret = regmap_read(map, SPM_8226_L2_SEQ + 4 * i, &value);
+		if (ret)
+			return ret;
+		if (value != spm_8226_l2_sequence[i])
+			return -EIO;
+	}
+	return 0;
+}
+
+static inline int spm_8226_l2_sequence_init(struct regmap *map)
+{
+	unsigned int control, avs, i;
+	int ret;
+
+	ret = regmap_read(map, SPM_8226_L2_CTL, &control);
+	if (ret)
+		return ret;
+	if (control)
+		return -EBUSY;
+	ret = regmap_read(map, 0x20, &avs);
+	if (ret)
+		return ret;
+	if (avs & 1)
+		return -EBUSY;
+	/* Load and verify every program while the sequencer remains disabled. */
+	for (i = 0; i < ARRAY_SIZE(spm_8226_l2_sequence); i++) {
+		ret = regmap_write(map, SPM_8226_L2_SEQ + 4 * i,
+				   spm_8226_l2_sequence[i]);
+		if (ret)
+			return ret;
+	}
+	ret = spm_8226_l2_sequence_verify(map);
+	if (ret)
+		return ret;
+	ret = regmap_read(map, SPM_8226_L2_CTL, &control);
+	if (ret)
+		return ret;
+	if (control)
+		return -EBUSY;
+	ret = regmap_read(map, 0x20, &avs);
+	if (ret)
+		return ret;
+	return avs & 1 ? -EBUSY : 0;
+}
+
+static inline int spm_8226_l2_disarm(struct regmap *map)
+{
+	unsigned int control, attempt;
+	int ret = -EIO, read_ret;
+
+	for (attempt = 0; attempt < 2; attempt++) {
+		ret = regmap_write(map, SPM_8226_L2_CTL, 0);
+		read_ret = regmap_read(map, SPM_8226_L2_CTL, &control);
+		/* Readback also resolves an applied-but-failed write. */
+		if (!read_ret && !control)
+			return 0;
+		if (!ret)
+			ret = read_ret ?: -EIO;
+	}
+	return ret;
+}
+
+/* No permission for collapse is implied: the system coordinator owns it. */
+static inline int spm_8226_l2_set_mode(struct regmap *map,
+				       enum spm_l2_sleep_mode mode)
+{
+	static const unsigned int starts[] = { 0, 0, 4, 26, 54 };
+	static const unsigned int registers[] = {
+		0xfd0, 4, 8, 0x34, 0x40, 0x44, 0x20, 0x14,
+	};
+	static const unsigned int expected[] = {
+		0x20010000, 4, 0x14, 0x3c102800, 0x02030080, 0x00030000, 0, 0,
+	};
+	static const unsigned int masks[] = {
+		~0U, 4, ~0U, ~0U, ~0U, ~0U, 1, 0x30000,
+	};
+	unsigned int value, control, i;
+	int ret;
+
+	ret = spm_8226_l2_disarm(map);
+	if (ret)
+		panic("MSM8226 L2 disarm failed: %d", ret);
+	if ((unsigned int)mode >= SPM_L2_MODE_NR)
+		return -EINVAL;
+	if (mode == SPM_L2_MODE_DISABLED)
+		return 0;
+	for (i = 0; i < ARRAY_SIZE(registers); i++) {
+		ret = regmap_read(map, registers[i], &value);
+		if (ret)
+			return ret;
+		if ((value & masks[i]) != expected[i])
+			return -EOPNOTSUPP;
+	}
+	ret = spm_8226_l2_sequence_verify(map);
+	if (ret)
+		return ret;
+	control = starts[mode] << 4 | 1;
+	ret = regmap_write(map, SPM_8226_L2_CTL, control);
+	if (!ret) {
+		ret = regmap_read(map, SPM_8226_L2_CTL, &value);
+		if (!ret && value != control)
+			ret = -EIO;
+	}
+	if (!ret)
+		return 0;
+	/* A failed write may have armed collapse: never return with unknown EN. */
+	if (spm_8226_l2_disarm(map))
+		panic("MSM8226 L2 entry recovery failed\n");
+	return ret;
+}
+
 /* Compiled Madai L2 master configuration; never issue VCTL or run a sequence. */
 static inline int spm_8226_l2_master_init(struct regmap *map)
 {
diff --git a/drivers/soc/qcom/spm.c b/drivers/soc/qcom/spm.c
index 0bfa99fde0d..acf0863b1c3 100644
--- a/drivers/soc/qcom/spm.c
+++ b/drivers/soc/qcom/spm.c
@@ -7,10 +7,12 @@
  */
 
 #include <linux/bitfield.h>
+#include <linux/cpu.h>
 #include <linux/err.h>
 #include <linux/init.h>
 #include <linux/io.h>
 #include <linux/iopoll.h>
+#include <linux/irqflags.h>
 #include <linux/kernel.h>
 #include <linux/linear_range.h>
 #include <linux/mfd/syscon.h>
@@ -86,6 +88,7 @@ struct spm_reg_data {
 
 struct spm_driver_data {
 	void __iomem *reg_base;
+	struct regmap *l2_map;
 	const struct spm_reg_data *reg_data;
 	struct device *dev;
 	unsigned int volt_sel;
@@ -296,6 +299,20 @@ static inline u32 spm_register_read(struct spm_driver_data *drv,
 	return readl_relaxed(drv->reg_base + drv->reg_data->reg_offset[reg]);
 }
 
+int spm_set_l2_low_power_mode(struct spm_driver_data *drv,
+			      enum spm_l2_sleep_mode mode)
+{
+	if (!drv || !drv->reg_data->pmic_arbiter_master || !drv->l2_map)
+		return -ENODEV;
+	/* APC commands also run on CPU0 in IRQ-disabled synchronous IPI context. */
+	if (raw_smp_processor_id() || !irqs_disabled())
+		return -EPERM;
+	if (mode != SPM_L2_MODE_DISABLED && num_online_cpus() != 1)
+		return -EBUSY;
+
+	return spm_8226_l2_set_mode(drv->l2_map, mode);
+}
+
 void spm_set_low_power_mode(struct spm_driver_data *drv,
 			    enum pm_sleep_mode mode)
 {
@@ -527,14 +544,16 @@ static const struct regmap_range spm_8226_l2_read_ranges[] = {
 	regmap_reg_range(0x1c, 0x20),
 	regmap_reg_range(0x30, 0x34),
 	regmap_reg_range(0x40, 0x44),
+	regmap_reg_range(0x80, 0xd0),
 	regmap_reg_range(0xfd0, 0xfd0),
 };
 
 static const struct regmap_range spm_8226_l2_write_ranges[] = {
 	regmap_reg_range(0x08, 0x08),
 	regmap_reg_range(0x18, 0x1c),
-	regmap_reg_range(0x34, 0x34),
+	regmap_reg_range(0x30, 0x34),
 	regmap_reg_range(0x40, 0x44),
+	regmap_reg_range(0x80, 0xd0),
 };
 
 static const struct regmap_access_table spm_8226_l2_read_table = {
@@ -589,8 +608,15 @@ static int spm_8226_l2_register(struct platform_device *pdev,
 	ret = spm_8226_l2_master_init(map);
 	if (ret)
 		return dev_err_probe(dev, ret, "could not initialize L2 master\n");
+	ret = spm_8226_l2_sequence_init(map);
+	if (ret)
+		return dev_err_probe(dev, ret, "could not initialize L2 sequences\n");
 	/* Nothing fallible may follow publication of this permanent mapping. */
-	return of_syscon_register_regmap(dev->of_node, map);
+	ret = of_syscon_register_regmap(dev->of_node, map);
+	if (ret)
+		return ret;
+	drv->l2_map = map;
+	return 0;
 }
 
 static int spm_dev_probe(struct platform_device *pdev)
diff --git a/include/soc/qcom/spm.h b/include/soc/qcom/spm.h
index 5b263c68581..d4e994939ce 100644
--- a/include/soc/qcom/spm.h
+++ b/include/soc/qcom/spm.h
@@ -19,4 +19,17 @@ struct spm_driver_data;
 void spm_set_low_power_mode(struct spm_driver_data *drv,
 			    enum pm_sleep_mode mode);
 
+enum spm_l2_sleep_mode {
+	SPM_L2_MODE_DISABLED,
+	SPM_L2_MODE_RETENTION,
+	SPM_L2_MODE_GDHS,
+	SPM_L2_MODE_COLLAPSE,
+	SPM_L2_MODE_COLLAPSE_RPM,
+	SPM_L2_MODE_NR,
+};
+
+/* CPU0 with local IRQs off; arming also requires all secondary CPUs offline. */
+int spm_set_l2_low_power_mode(struct spm_driver_data *drv,
+			      enum spm_l2_sleep_mode mode);
+
 #endif /* __SPM_H__ */
