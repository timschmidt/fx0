From 5ffa9b205f22bfd8c86cb16d0d4d5446e7fad76e Mon Sep 17 00:00:00 2001
From: Codex <codex@openai.com>
Date: Mon, 16 Nov 2026 10:43:34 -0500
Subject: [PATCH] slimbus: qcom-ngd-ctrl: retire TX completion references on
 return

Carry this reviewed SLIMbus/BAM change into maintained Linux 6.18.
Preserve the existing LTS channel-removal/reconfigure protocol, socket
interfaces and DMA provider implementation. This stage is exact patch.

The completed eighteen-change series passes 3,221 source-bound synthetic
cases and 117 independent regression controls, with normal LeakSanitizer
and fail-fast address/undefined-behavior sanitizers. These cover
startup, child and parent ownership, QMI allocation, TX completion
lifetime, synchronous/asynchronous response ownership, DMA admission and
the retained LTS stream caller. Baselines from the appropriate
intermediate stages fail their targeted assertions. All 108 ARM, ARM64
and ARM64 RT component objects build with W=1 and nonpermissive CFI
without diagnostics; their ELF source checksums match the final
candidate.

Kernel waits, workqueues, IDR, PM, packets, DMA and device services in
the host models are synthetic. No real firmware, audio, hardware,
network, phone or installed package executes. Full current-kernel link,
physical DMA-stop/recovery and final-image acceptance remain
unqualified. Codex prepared the LTS adaptations and qualification.
Preserve original authors, dates, notices and assistance credits. Human
DCO and owner, security and subsystem review remain pending; no new
sign-off is added.

Original reviewed changelog and provenance:

The TX ring reservation publishes a pointer to an on-stack completion
before the transfer mutex is acquired. Preparation and TID allocation
failures leave that reservation behind, and a DMA timeout returns while
the submitted descriptor still holds the completion pointer. A callback
that was already using the pointer is also not synchronized with return.
Concurrent callers can reserve outside the mutex that orders submission.

Take tx_lock before reservation and keep assembly, submission and waits
under that mutex. On every return after reservation, clear its
completion reference under tx_buf_lock. This serializes with a callback
already using the reference. Roll back only a never-submitted
reservation; a submitted slot stays hardware-owned until its callback
advances the ring head, even after its caller times out.

Retain the submission cookie in the client-owned descriptor instead of
writing through the DMA descriptor pointer after ownership was handed to
the DMA engine. Preserve existing error values and packet bytes.

The host model executes seven exact driver/message helper callbacks. It
passes 1,093 cases/47,497 checks after 2,757 pre-change failures, and
rejects twelve regression controls. It covers every ring position,
failed new reservations with older DMA queued, late callbacks, ring
capacity, concurrent callers and return racing an active callback. All
41,147 packet-trace bytes match the pre-change run. Eight native
ARM/ARM64 objects build with LLVM21, W=1 and strict callback diagnostics
without warnings or errors.

Completion addresses, DMA, TIDs and callbacks are logical services; no
retired memory is dereferenced and no real DMA, audio or phone executes.
Response/TID and PM ownership, generic submission-error propagation,
RX/master/external transfer quiescence and hardware stop ordering remain
separate required work. Codex generated this fix and evidence; human
review and DCO certification remain pending.

Fixes: 917809e2280b ("slimbus: ngd: Add qcom SLIMBus NGD driver")

Backported from commit d9260717ca81 ("slimbus: qcom-ngd-ctrl: retire TX
completion references on return")
---
 drivers/slimbus/qcom-ngd-ctrl.c | 51 +++++++++++++++++++++++----------
 1 file changed, 36 insertions(+), 15 deletions(-)

diff --git a/drivers/slimbus/qcom-ngd-ctrl.c b/drivers/slimbus/qcom-ngd-ctrl.c
index 0eee5f0f85947..d9d34d70695c4 100644
--- a/drivers/slimbus/qcom-ngd-ctrl.c
+++ b/drivers/slimbus/qcom-ngd-ctrl.c
@@ -540,6 +540,7 @@ static u32 *qcom_slim_ngd_tx_msg_get(struct qcom_slim_ngd_ctrl *ctrl, int len,
 	struct qcom_slim_ngd_dma_desc *desc;
 	unsigned long flags;
 
+	lockdep_assert_held(&ctrl->tx_lock);
 	spin_lock_irqsave(&ctrl->tx_buf_lock, flags);
 
 	if ((ctrl->tx_tail + 1) % QCOM_SLIM_NGD_DESC_NUM == ctrl->tx_head) {
@@ -556,6 +557,21 @@ static u32 *qcom_slim_ngd_tx_msg_get(struct qcom_slim_ngd_ctrl *ctrl, int len,
 	return desc->base;
 }
 
+static void qcom_slim_ngd_tx_msg_put(struct qcom_slim_ngd_ctrl *ctrl,
+				     void *buf, bool submitted)
+{
+	unsigned long flags;
+	int index = (buf - ctrl->tx_base) / SLIM_MSGQ_BUF_LEN;
+
+	lockdep_assert_held(&ctrl->tx_lock);
+	spin_lock_irqsave(&ctrl->tx_buf_lock, flags);
+	ctrl->txdesc[index].comp = NULL;
+	/* A submitted buffer stays reserved until its DMA callback retires it. */
+	if (!submitted)
+		ctrl->tx_tail = index;
+	spin_unlock_irqrestore(&ctrl->tx_buf_lock, flags);
+}
+
 static void qcom_slim_ngd_tx_msg_dma_cb(void *args)
 {
 	struct qcom_slim_ngd_dma_desc *desc = args;
@@ -602,7 +618,7 @@ static int qcom_slim_ngd_tx_msg_post(struct qcom_slim_ngd_ctrl *ctrl,
 
 	desc->desc->callback = qcom_slim_ngd_tx_msg_dma_cb;
 	desc->desc->callback_param = desc;
-	desc->desc->cookie = dmaengine_submit(desc->desc);
+	desc->cookie = dmaengine_submit(desc->desc);
 	dma_async_issue_pending(ctrl->dma_tx_channel);
 	spin_unlock_irqrestore(&ctrl->tx_buf_lock, flags);
 
@@ -819,7 +835,7 @@ static int qcom_slim_ngd_xfer_msg(struct slim_controller *sctrl,
 	u32 *pbuf;
 	u8 *puc;
 	u8 la = txn->la;
-	bool usr_msg = false;
+	bool usr_msg = false, submitted = false;
 
 	if (txn->mt == SLIM_MSG_MT_CORE &&
 		(txn->mc >= SLIM_MSG_MC_BEGIN_RECONFIGURATION &&
@@ -835,10 +851,12 @@ static int qcom_slim_ngd_xfer_msg(struct slim_controller *sctrl,
 		return -EINVAL;
 	}
 
+	mutex_lock(&ctrl->tx_lock);
 	pbuf = qcom_slim_ngd_tx_msg_get(ctrl, txn->rl, &tx_sent);
 	if (!pbuf) {
 		dev_err(ctrl->dev, "Message buffer unavailable\n");
-		return -ENOMEM;
+		ret = -ENOMEM;
+		goto unlock;
 	}
 
 	if (txn->mt == SLIM_MSG_MT_CORE &&
@@ -857,7 +875,8 @@ static int qcom_slim_ngd_xfer_msg(struct slim_controller *sctrl,
 			txn->mc = SLIM_USR_MC_DISCONNECT_PORT;
 			break;
 		default:
-			return -EINVAL;
+			ret = -EINVAL;
+			goto put;
 		}
 
 		usr_msg = true;
@@ -872,7 +891,7 @@ static int qcom_slim_ngd_xfer_msg(struct slim_controller *sctrl,
 		ret = slim_alloc_txn_tid(sctrl, txn);
 		if (ret) {
 			dev_err(ctrl->dev, "Unable to allocate TID\n");
-			return ret;
+			goto put;
 		}
 
 		wbuf[i++] = txn->tid;
@@ -908,19 +927,17 @@ static int qcom_slim_ngd_xfer_msg(struct slim_controller *sctrl,
 	if (txn->msg && txn->msg->wbuf)
 		memcpy(puc, txn->msg->wbuf, txn->msg->num_bytes);
 
-	mutex_lock(&ctrl->tx_lock);
 	ret = qcom_slim_ngd_tx_msg_post(ctrl, pbuf, txn->rl);
-	if (ret) {
-		mutex_unlock(&ctrl->tx_lock);
-		return ret;
-	}
+	if (ret)
+		goto put;
+	submitted = true;
 
 	time_left = wait_for_completion_timeout(&tx_sent, HZ);
 	if (!time_left) {
 		dev_err(sctrl->dev, "TX timed out:MC:0x%x,mt:0x%x", txn->mc,
 					txn->mt);
-		mutex_unlock(&ctrl->tx_lock);
-		return -ETIMEDOUT;
+		ret = -ETIMEDOUT;
+		goto put;
 	}
 
 	if (usr_msg) {
@@ -928,13 +945,17 @@ static int qcom_slim_ngd_xfer_msg(struct slim_controller *sctrl,
 		if (!time_left) {
 			dev_err(sctrl->dev, "TX timed out:MC:0x%x,mt:0x%x",
 				txn->mc, txn->mt);
-			mutex_unlock(&ctrl->tx_lock);
-			return -ETIMEDOUT;
+			ret = -ETIMEDOUT;
+			goto put;
 		}
 	}
 
+	ret = 0;
+put:
+	qcom_slim_ngd_tx_msg_put(ctrl, pbuf, submitted);
+unlock:
 	mutex_unlock(&ctrl->tx_lock);
-	return 0;
+	return ret;
 }
 
 static int qcom_slim_ngd_xfer_msg_sync(struct slim_controller *ctrl,
-- 
2.56.0

