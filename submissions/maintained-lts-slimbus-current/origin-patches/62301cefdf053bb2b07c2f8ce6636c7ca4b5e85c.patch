From 62301cefdf053bb2b07c2f8ce6636c7ca4b5e85c Mon Sep 17 00:00:00 2001
From: Codex <codex@openai.com>
Date: Mon, 16 Nov 2026 05:35:24 -0500
Subject: [PATCH] slimbus: qcom-ngd-ctrl: track completed controller
 registration

Repeated UP work can initialize another QMI client, register the same
controller again and drop the bootstrap PM reference more than once.
Removal also unregisters the controller when registration never
finished. If controller registration fails, its QMI client remains
allocated and the PM bootstrap reference has already been dropped before
a retry.

Track completed controller registration. Reuse a registered controller's
QMI client while retaining its runtime wakeup path. Unregister only an
owned controller, and drop the bootstrap PM reference only after
registration succeeds. Release the newly created QMI client when
registration fails so a later attempt starts with balanced ownership.

The exact driver and SLIMbus-core callbacks run in 21 synthetic cases
covering completion outcomes, duplicate UP requests, PM
enabled/suspended combinations, registered-controller runtime wakeup,
QMI and registration failures, retry, disable and an SSR cycle. QMI, PM,
firmware, DMA and device services are models. Startup scheduling,
asynchronous teardown and physical acceptance remain open.

OpenAI Codex identified these bookkeeping errors and implemented the
fix, changelog and host qualification. Human review and DCO are pending.

Fixes: 94fe5f2b45c4 ("silmbus: ngd: register controller after power up.")
---
 drivers/slimbus/qcom-ngd-ctrl.c | 28 ++++++++++++++++++++--------
 1 file changed, 20 insertions(+), 8 deletions(-)

diff --git a/drivers/slimbus/qcom-ngd-ctrl.c b/drivers/slimbus/qcom-ngd-ctrl.c
index 8f9f870e718f..a4eba5aa962e 100644
--- a/drivers/slimbus/qcom-ngd-ctrl.c
+++ b/drivers/slimbus/qcom-ngd-ctrl.c
@@ -173,6 +173,7 @@ struct qcom_slim_ngd_ctrl {
 	void *notifier;
 	struct pdr_handle *pdr;
 	enum qcom_slim_ngd_state state;
+	bool registered;
 	dma_addr_t rx_phys_base;
 	dma_addr_t tx_phys_base;
 	void *rx_base;
@@ -1405,12 +1406,15 @@ static int qcom_slim_ngd_runtime_resume(struct device *dev)
 static int qcom_slim_ngd_enable(struct qcom_slim_ngd_ctrl *ctrl, bool enable)
 {
 	if (enable) {
-		int ret = qcom_slim_qmi_init(ctrl, false);
+		int ret;
 
-		if (ret) {
-			dev_err(ctrl->dev, "qmi init fail, ret:%d, state:%d\n",
-				ret, ctrl->state);
-			return ret;
+		if (!ctrl->registered) {
+			ret = qcom_slim_qmi_init(ctrl, false);
+			if (ret) {
+				dev_err(ctrl->dev, "qmi init fail, ret:%d, state:%d\n",
+					ret, ctrl->state);
+				return ret;
+			}
 		}
 		/* controller state should be in sync with framework state */
 		complete(&ctrl->qmi.qmi_comp);
@@ -1420,19 +1424,27 @@ static int qcom_slim_ngd_enable(struct qcom_slim_ngd_ctrl *ctrl, bool enable)
 		else
 			pm_runtime_resume(ctrl->ctrl.dev);
 
-		pm_runtime_mark_last_busy(ctrl->ctrl.dev);
-		pm_runtime_put(ctrl->ctrl.dev);
+		if (ctrl->registered)
+			return 0;
 
 		ret = slim_register_controller(&ctrl->ctrl);
 		if (ret) {
 			dev_err(ctrl->dev, "error adding slim controller\n");
+			qcom_slim_qmi_exit(ctrl);
 			return ret;
 		}
 
+		ctrl->registered = true;
+		pm_runtime_mark_last_busy(ctrl->ctrl.dev);
+		pm_runtime_put(ctrl->ctrl.dev);
+
 		dev_info(ctrl->dev, "SLIM controller Registered\n");
 	} else {
 		qcom_slim_qmi_exit(ctrl);
-		slim_unregister_controller(&ctrl->ctrl);
+		if (ctrl->registered) {
+			slim_unregister_controller(&ctrl->ctrl);
+			ctrl->registered = false;
+		}
 	}
 
 	return 0;
-- 
