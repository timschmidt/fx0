From 1072eae2f428b3f237be3d06b11c1beb52d6e5ff Mon Sep 17 00:00:00 2001
From: Timothy Schmidt <timschmidt@gmail.com>
Date: Sat, 31 Oct 2026 08:46:22 -0400
Subject: [PATCH] media: qcom: camss: bound RDI geometry before buffer
 ownership

The LTS frame-size hook lacks bounds and runs after buffer ownership.
Validate the VFE4.1 height and word fields before any buffer is
consumed, return errors before enabling DMA, and propagate its RDI
height limit through subdev/capture negotiation. Keep LTS alignment
and other SoC/PIX paths intact. A source-extracted vendor comparison
and boundary model passes 6433 checks; the partial prior code fails
241. Six targeted regressions are rejected. Geometry and register
services are synthetic.

The complete camera set builds 78 native ARM, ARM64 and ARM64 RT
objects without W=1 diagnostics or permissive CFI. Source checksums
match ELF line tables. Three source-only CAMSS partial links retain no
unresolved MIPI timing helper; these are not final Kbuild module or
kernel links. Low-level hardware, locks, full PM/driver core and
capture are modeled or untested. Physical acceptance and the r2
display fault remain open.

Original proposals are by Timothy Schmidt with Claude Opus 5.5
assistance; Codex (GPT-6) prepared this maintained-LTS reconciliation
and qualification. Original author/date and all source/license notices
are preserved. Human DCO and review remain pending; no sign-off, phone
action or publication is claimed.

Backported from commit f31e5cf93121 ("media: qcom: camss: Carry RDI
geometry and height negotiation")
---
 .../media/platform/qcom/camss/camss-vfe-4-1.c   | 17 ++++++++++++++---
 .../media/platform/qcom/camss/camss-vfe-gen1.c  | 14 +++++++++++---
 .../media/platform/qcom/camss/camss-vfe-gen1.h  |  5 +++--
 drivers/media/platform/qcom/camss/camss-vfe.c   | 11 ++++++++++-
 drivers/media/platform/qcom/camss/camss-video.c |  7 ++++---
 drivers/media/platform/qcom/camss/camss-video.h |  1 +
 6 files changed, 43 insertions(+), 12 deletions(-)

diff --git a/drivers/media/platform/qcom/camss/camss-vfe-4-1.c b/drivers/media/platform/qcom/camss/camss-vfe-4-1.c
index 2ba61a92cceaf..dd90cfd65fcf4 100644
--- a/drivers/media/platform/qcom/camss/camss-vfe-4-1.c
+++ b/drivers/media/platform/qcom/camss/camss-vfe-4-1.c
@@ -106,6 +106,8 @@
 #define VFE_0_BUS_IMAGE_MASTER_n_WR_UB_CFG_OFFSET_SHIFT	16
 #define VFE_0_BUS_IMAGE_MASTER_n_WR_IMAGE_SIZE(n)	(0x080 + 0x24 * (n))
 #define VFE_0_BUS_IMAGE_MASTER_n_WR_BUFFER_CFG(n)	(0x084 + 0x24 * (n))
+#define VFE_WM_BUFFER_CFG_MAX_HEIGHT		4096
+#define VFE_WM_BUFFER_CFG_MAX_WORDS		0xffff
 #define VFE_0_BUS_IMAGE_MASTER_n_WR_FRAMEDROP_PATTERN(n)	\
 							(0x088 + 0x24 * (n))
 #define VFE_0_BUS_IMAGE_MASTER_n_WR_IRQ_SUBSAMPLE_PATTERN(n)	\
@@ -282,14 +284,22 @@ static void vfe_wm_frame_based(struct vfe_device *vfe, u8 wm, u8 enable)
  * A frame-based write master on MSM8226's VFE 4.0 still takes the frame
  * geometry: line length in 64-bit words, height and burst length.
  */
-static void vfe_wm_frame_size(struct vfe_device *vfe, u8 wm,
-			      struct v4l2_pix_format_mplane *pix)
+static int vfe_wm_frame_size(struct vfe_device *vfe, u8 wm,
+			     struct v4l2_pix_format_mplane *pix)
 {
 	u32 words = DIV_ROUND_UP(pix->plane_fmt[0].bytesperline, 8);
 	u32 reg;
 
+	/* Height occupies bits 15:4 and words per line occupy bits 31:16. */
+	if (!pix->height || pix->height > VFE_WM_BUFFER_CFG_MAX_HEIGHT ||
+	    !words || words > VFE_WM_BUFFER_CFG_MAX_WORDS)
+		return -EINVAL;
+
 	reg = (words << 16) | ((pix->height - 1) << 4) | 1;
-	writel_relaxed(reg, vfe->base + VFE_0_BUS_IMAGE_MASTER_n_WR_BUFFER_CFG(wm));
+	writel_relaxed(reg, vfe->base +
+		       VFE_0_BUS_IMAGE_MASTER_n_WR_BUFFER_CFG(wm));
+
+	return 0;
 }
 
 static void vfe_get_wm_sizes(struct v4l2_pix_format_mplane *pix, u8 plane,
@@ -971,6 +981,7 @@ static int vfe_4_1_pm_domain_on(struct vfe_device *vfe)
 }
 
 static const struct vfe_hw_ops_gen1 vfe_ops_gen1_4_1 = {
+	.max_frame_height = VFE_WM_BUFFER_CFG_MAX_HEIGHT,
 	.bus_connect_wm_to_rdi = vfe_bus_connect_wm_to_rdi,
 	.bus_disconnect_wm_from_rdi = vfe_bus_disconnect_wm_from_rdi,
 	.bus_enable_wr_if = vfe_bus_enable_wr_if,
diff --git a/drivers/media/platform/qcom/camss/camss-vfe-gen1.c b/drivers/media/platform/qcom/camss/camss-vfe-gen1.c
index b82ed4bd9811c..db040fe685f6e 100644
--- a/drivers/media/platform/qcom/camss/camss-vfe-gen1.c
+++ b/drivers/media/platform/qcom/camss/camss-vfe-gen1.c
@@ -175,6 +175,7 @@ static int vfe_enable_output(struct vfe_line *line)
 	unsigned int frame_skip = 0;
 	unsigned int i;
 	u16 ub_size;
+	int ret;
 
 	ub_size = vfe->ops_gen1->get_ub_size(vfe->id);
 	if (!ub_size)
@@ -200,6 +201,16 @@ static int vfe_enable_output(struct vfe_line *line)
 		spin_unlock_irqrestore(&vfe->output_lock, flags);
 		return -EINVAL;
 	}
+	if (line->id != VFE_LINE_PIX && vfe->ops_gen1->wm_frame_size) {
+		struct v4l2_pix_format_mplane *pix =
+			&line->video_out.active_fmt.fmt.pix_mp;
+
+		ret = vfe->ops_gen1->wm_frame_size(vfe, output->wm_idx[0], pix);
+		if (ret) {
+			spin_unlock_irqrestore(&vfe->output_lock, flags);
+			return ret;
+		}
+	}
 	output->state = VFE_OUTPUT_IDLE;
 
 	output->buf[0] = vfe_buf_get_pending(output);
@@ -245,9 +256,6 @@ static int vfe_enable_output(struct vfe_line *line)
 		vfe->ops_gen1->wm_set_ub_cfg(vfe, output->wm_idx[0],
 					    (ub_size + 1) * output->wm_idx[0], ub_size);
 		vfe->ops_gen1->wm_frame_based(vfe, output->wm_idx[0], 1);
-		if (vfe->ops_gen1->wm_frame_size)
-			vfe->ops_gen1->wm_frame_size(vfe, output->wm_idx[0],
-						     &line->video_out.active_fmt.fmt.pix_mp);
 		vfe->ops_gen1->wm_enable(vfe, output->wm_idx[0], 1);
 		vfe->ops_gen1->bus_reload_wm(vfe, output->wm_idx[0]);
 	} else {
diff --git a/drivers/media/platform/qcom/camss/camss-vfe-gen1.h b/drivers/media/platform/qcom/camss/camss-vfe-gen1.h
index fb181849e1bd4..67e78bc6b0683 100644
--- a/drivers/media/platform/qcom/camss/camss-vfe-gen1.h
+++ b/drivers/media/platform/qcom/camss/camss-vfe-gen1.h
@@ -18,6 +18,7 @@ struct vfe_line;
 struct vfe_output;
 
 struct vfe_hw_ops_gen1 {
+	u32 max_frame_height;
 	void (*bus_connect_wm_to_rdi)(struct vfe_device *vfe, u8 wm, enum vfe_line_id id);
 	void (*bus_disconnect_wm_from_rdi)(struct vfe_device *vfe, u8 wm, enum vfe_line_id id);
 	void (*bus_enable_wr_if)(struct vfe_device *vfe, u8 enable);
@@ -45,8 +46,8 @@ struct vfe_hw_ops_gen1 {
 	void (*set_qos)(struct vfe_device *vfe);
 	void (*set_xbar_cfg)(struct vfe_device *vfe, struct vfe_output *output, u8 enable);
 	void (*wm_frame_based)(struct vfe_device *vfe, u8 wm, u8 enable);
-	void (*wm_frame_size)(struct vfe_device *vfe, u8 wm,
-			      struct v4l2_pix_format_mplane *pix);
+	int (*wm_frame_size)(struct vfe_device *vfe, u8 wm,
+			     struct v4l2_pix_format_mplane *pix);
 	void (*wm_line_based)(struct vfe_device *vfe, u32 wm, struct v4l2_pix_format_mplane *pix,
 			      u8 plane, u32 enable);
 	void (*wm_set_ub_cfg)(struct vfe_device *vfe, u8 wm, u16 offset, u16 depth);
diff --git a/drivers/media/platform/qcom/camss/camss-vfe.c b/drivers/media/platform/qcom/camss/camss-vfe.c
index 4427426d6a059..911fa0f063294 100644
--- a/drivers/media/platform/qcom/camss/camss-vfe.c
+++ b/drivers/media/platform/qcom/camss/camss-vfe.c
@@ -1328,9 +1328,15 @@ static void vfe_try_format(struct vfe_line *line,
 			   struct v4l2_mbus_framefmt *fmt,
 			   enum v4l2_subdev_format_whence which)
 {
+	struct vfe_device *vfe = to_vfe(line);
+	unsigned int max_height = 8191;
 	unsigned int i;
 	u32 code;
 
+	if (line->id != VFE_LINE_PIX && vfe->ops_gen1 &&
+	    vfe->ops_gen1->max_frame_height)
+		max_height = min(max_height, vfe->ops_gen1->max_frame_height);
+
 	switch (pad) {
 	case MSM_VFE_PAD_SINK:
 		/* Set format on sink pad */
@@ -1344,7 +1350,7 @@ static void vfe_try_format(struct vfe_line *line,
 			fmt->code = MEDIA_BUS_FMT_UYVY8_1X16;
 
 		fmt->width = clamp_t(u32, fmt->width, 1, 8191);
-		fmt->height = clamp_t(u32, fmt->height, 1, 8191);
+		fmt->height = clamp_t(u32, fmt->height, 1, max_height);
 
 		fmt->field = V4L2_FIELD_NONE;
 		fmt->colorspace = V4L2_COLORSPACE_SRGB;
@@ -2074,6 +2080,9 @@ int msm_vfe_register_entities(struct vfe_device *vfe,
 		if (i == VFE_LINE_PIX) {
 			video_out->bpl_alignment = 16;
 			video_out->line_based = 1;
+		} else {
+			video_out->max_height = vfe->ops_gen1 ?
+				vfe->ops_gen1->max_frame_height : 0;
 		}
 
 		video_out->nformats = vfe->line[i].nformats;
diff --git a/drivers/media/platform/qcom/camss/camss-video.c b/drivers/media/platform/qcom/camss/camss-video.c
index 59b21b3a723d1..e2cc598947df4 100644
--- a/drivers/media/platform/qcom/camss/camss-video.c
+++ b/drivers/media/platform/qcom/camss/camss-video.c
@@ -455,8 +455,8 @@ static int video_enum_framesizes(struct file *file, void *fh,
 	fsize->stepwise.min_width = CAMSS_FRAME_MIN_WIDTH;
 	fsize->stepwise.max_width = CAMSS_FRAME_MAX_WIDTH;
 	fsize->stepwise.min_height = CAMSS_FRAME_MIN_HEIGHT;
-	fsize->stepwise.max_height = (video->line_based) ?
-		CAMSS_FRAME_MAX_HEIGHT_PIX : CAMSS_FRAME_MAX_HEIGHT_RDI;
+	fsize->stepwise.max_height = video->max_height ?: (video->line_based ?
+		CAMSS_FRAME_MAX_HEIGHT_PIX : CAMSS_FRAME_MAX_HEIGHT_RDI);
 	fsize->stepwise.step_width = 1;
 	fsize->stepwise.step_height = 1;
 
@@ -479,6 +479,7 @@ static int __video_try_fmt(struct camss_video *video, struct v4l2_format *f)
 	struct v4l2_plane_pix_format *p;
 	u32 bytesperline[3] = { 0 };
 	u32 sizeimage[3] = { 0 };
+	u32 max_height = video->max_height ?: CAMSS_FRAME_MAX_HEIGHT_RDI;
 	u32 width, height;
 	u32 bpl, lines;
 	int i, j;
@@ -510,7 +511,7 @@ static int __video_try_fmt(struct camss_video *video, struct v4l2_format *f)
 
 	pix_mp->pixelformat = fi->pixelformat;
 	pix_mp->width = clamp_t(u32, width, 1, CAMSS_FRAME_MAX_WIDTH);
-	pix_mp->height = clamp_t(u32, height, 1, CAMSS_FRAME_MAX_HEIGHT_RDI);
+	pix_mp->height = clamp_t(u32, height, 1, max_height);
 	pix_mp->num_planes = fi->planes;
 	for (i = 0; i < pix_mp->num_planes; i++) {
 		bpl = pix_mp->width / fi->hsub[i].numerator *
diff --git a/drivers/media/platform/qcom/camss/camss-video.h b/drivers/media/platform/qcom/camss/camss-video.h
index d3e56e240a888..5be37bbd1d359 100644
--- a/drivers/media/platform/qcom/camss/camss-video.h
+++ b/drivers/media/platform/qcom/camss/camss-video.h
@@ -46,6 +46,7 @@ struct camss_video {
 	struct mutex q_lock;
 	unsigned int bpl_alignment;
 	unsigned int line_based;
+	unsigned int max_height;
 	const struct camss_format_info *formats;
 	unsigned int nformats;
 };
