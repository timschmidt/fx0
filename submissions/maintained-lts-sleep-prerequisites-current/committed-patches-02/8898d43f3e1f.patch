From 8040e87c91563b7fb5aec588f6a62053df0eb0e4 Mon Sep 17 00:00:00 2001
From: Codex <codex@openai.com>
Date: Mon, 16 Nov 2026 16:27:32 -0500
Subject: [PATCH] regulator: qcom_smd: Protect live APC before the first MX
 consumer vote

A separate AO voter prevents Pronto's fixed constraint from restricting
CPR, but it is initially empty. Pronto or registration voltage constraints
can write a lower normal L3 floor before CPU-domain attachment establishes
CPR's retained MX request. That can drop MX below inherited live APC.

For an opt-in boot APC supply, resolve and read APC before registering any
voter, outside regulator callback locks. Reject invalid/unreadable APC,
unsupported voltage bounds and automatic AO boot enables before publishing
resources or sending RPM requests. Seed a temporary ACTIVE enable and
maximum voltage hold. Normal and AO registration, disabled cached updates
and Pronto startup cannot lower or disable this boot request.

Remove the hold only after an enabled AO request covering the rounded-up
boot APC voltage is acknowledged. Keep it on all errors, including applied
and unapplied timeouts. The existing CPU bootstrap rechecks live APC before
its calibrated request/enable, and retains MX across attachment retries.
After handoff, ordinary paired voting permits CPU voltage scaling again;
the boot maximum is not a permanent floor. Do not read another regulator
from provider callbacks or add a sleep vote for a permanently live APC.

The host composition uses actual provider/core constraints, CPR voltage and
CPU clock handoff bodies. It reproduces the previous boot-order failure,
rejects stale CPU voltage plans and verifies failed-handoff retry and
successful voltage scaling with normal LSan and fail-fast ASan/UBSan.
Native ARM and ARM64 W=1 builds pass. Firmware, concurrency, electrical
behavior and complete deep suspend remain unqualified; the CPR guard stays.

Fixes: aedc16933cd0 ("regulator: qcom_smd: Add paired normal and active-only PM8226 L3 votes")

Codex generated this source, tests and audit. Human review and DCO remain
pending. No Signed-off-by is invented. Nothing has been submitted.

Backport this prerequisite to maintained Linux 6.18.63. The complete
seventeen-change batch passes native ARM, ARM64 and ARM64 RT object
builds with the MSM8926 feature enabled and disabled. CPU-idle is ARM
only. Host fault models use synthetic services and normal LeakSanitizer;
firmware, electrical and physical suspend acceptance remain open.

Codex prepared this local backport and verification. Original authors,
dates, licenses and human attribution tags are retained. Human DCO and
review remain pending. No phone access or publication occurred.

Backported from commit 8898d43f3e1f ("regulator: qcom_smd: Protect
live APC before the first MX consumer vote")
---
 drivers/regulator/qcom_smd-regulator.c | 73 +++++++++++++++++++++++---
 1 file changed, 65 insertions(+), 8 deletions(-)

diff --git a/drivers/regulator/qcom_smd-regulator.c b/drivers/regulator/qcom_smd-regulator.c
index 57cd2000923ad..4b530efa0e6b6 100644
--- a/drivers/regulator/qcom_smd-regulator.c
+++ b/drivers/regulator/qcom_smd-regulator.c
@@ -8,6 +8,7 @@
 #include <linux/mutex.h>
 #include <linux/of.h>
 #include <linux/platform_device.h>
+#include <linux/regulator/consumer.h>
 #include <linux/regulator/driver.h>
 #include <linux/regulator/of_regulator.h>
 #include <linux/soc/qcom/smd-rpm.h>
@@ -26,6 +27,8 @@ struct rpm_reg_pair {
 	/* Serializes the cached votes and their synchronous RPM writes. */
 	struct mutex lock;
 	struct rpm_reg_vote votes[2];
+	int boot_uV;
+	int boot_min_uV;
 	bool sleep_initialized;
 	bool sleep_enable_valid;
 	bool sleep_enabled;
@@ -92,6 +95,7 @@ static int rpm_reg_write_pair(struct qcom_rpm_reg *vreg)
 	struct rpm_reg_vote *active_only = &pair->votes[1];
 	struct rpm_reg_vote previous, active, sleep;
 	bool initialize_sleep;
+	bool boot_handoff;
 	u64 load;
 	int ret = 0;
 
@@ -104,7 +108,8 @@ static int rpm_reg_write_pair(struct qcom_rpm_reg *vreg)
 		.load_valid = previous.load_valid || vreg->load_updated,
 	};
 	/* Keep disabled voltage requests for the next enable, as the vendor does. */
-	if (!normal->enabled && !active_only->enabled && !vreg->enabled_updated) {
+	if (!normal->enabled && !active_only->enabled && !vreg->enabled_updated &&
+	    !pair->boot_uV) {
 		if (!vreg->active_only)
 			pair->sleep_initialized = false;
 		goto unlock;
@@ -125,12 +130,16 @@ static int rpm_reg_write_pair(struct qcom_rpm_reg *vreg)
 	}
 
 	load = (u64)normal->load + active_only->load;
+	boot_handoff = active_only->enabled &&
+		       active_only->uV >= pair->boot_min_uV;
 	active = (struct rpm_reg_vote) {
-		.enabled = normal->enabled || active_only->enabled,
+		.enabled = normal->enabled || active_only->enabled || pair->boot_uV,
 		.uV = max(normal->uV, active_only->uV),
 		.load = min_t(u64, load, U32_MAX),
 		.load_valid = normal->load_valid || active_only->load_valid,
 	};
+	if (!boot_handoff)
+		active.uV = max(active.uV, pair->boot_uV);
 	ret = rpm_reg_send_vote(vreg, QCOM_SMD_RPM_ACTIVE_STATE, &active);
 	if (ret)
 		goto restore;
@@ -144,6 +153,8 @@ static int rpm_reg_write_pair(struct qcom_rpm_reg *vreg)
 	vreg->enabled_updated = 0;
 	vreg->uv_updated = 0;
 	vreg->load_updated = 0;
+	if (boot_handoff)
+		pair->boot_uV = 0;
 	goto unlock;
 
 restore:
@@ -1624,6 +1635,40 @@ static int rpm_regulator_init_vreg(struct qcom_rpm_reg *vreg, struct device *dev
 	return 0;
 }
 
+static int rpm_reg_pair_init_boot(struct device *dev, struct rpm_reg_pair *pair,
+				  struct device_node *ao_node)
+{
+	struct regulator *apc;
+	u32 min_uV, max_uV;
+	int boot_uV;
+
+	if (!of_property_present(dev->of_node, "qcom,boot-apc-supply"))
+		return 0;
+	if (of_property_read_bool(ao_node, "regulator-boot-on") ||
+	    of_property_read_bool(ao_node, "regulator-always-on"))
+		return -EINVAL;
+	if (of_property_read_u32(ao_node, "regulator-min-microvolt", &min_uV) ||
+	    of_property_read_u32(ao_node, "regulator-max-microvolt", &max_uV) ||
+	    min_uV < 750000 || max_uV > 1537500 || min_uV > max_uV ||
+	    (min_uV - 750000) % 12500 || (max_uV - 750000) % 12500)
+		return -EINVAL;
+
+	/* Probe has no regulator callback locks; never nest this in vote writes. */
+	apc = devm_regulator_get(dev, "qcom,boot-apc");
+	if (IS_ERR(apc))
+		return PTR_ERR(apc);
+	boot_uV = regulator_get_voltage(apc);
+	if (boot_uV <= 0)
+		return boot_uV ?: -EINVAL;
+	if (boot_uV > max_uV)
+		return -ERANGE;
+
+	/* Hold the validated ceiling until CPR has a covering, enabled vote. */
+	pair->boot_min_uV = DIV_ROUND_UP(max_t(int, boot_uV, min_uV), 12500) * 12500;
+	pair->boot_uV = max_uV;
+	return 0;
+}
+
 static int rpm_reg_probe(struct platform_device *pdev)
 {
 	struct device *dev = &pdev->dev;
@@ -1632,6 +1677,7 @@ static int rpm_reg_probe(struct platform_device *pdev)
 	struct qcom_smd_rpm *rpm;
 	struct rpm_reg_pair *pair = NULL;
 	struct device_node *pair_node;
+	struct device_node *normal_node;
 	int ret;
 
 	rpm = dev_get_drvdata(pdev->dev.parent);
@@ -1651,17 +1697,28 @@ static int rpm_reg_probe(struct platform_device *pdev)
 
 	pair_node = of_get_available_child_by_name(dev->of_node, "l3-ao");
 	if (pair_node) {
-		of_node_put(pair_node);
-		if (vreg_data != rpm_pm8226_regulators)
+		if (vreg_data != rpm_pm8226_regulators) {
+			of_node_put(pair_node);
 			return dev_err_probe(dev, -EINVAL, "l3-ao requires PM8226\n");
-		pair_node = of_get_available_child_by_name(dev->of_node, "l3");
-		if (!pair_node)
+		}
+		normal_node = of_get_available_child_by_name(dev->of_node, "l3");
+		if (!normal_node) {
+			of_node_put(pair_node);
 			return dev_err_probe(dev, -EINVAL, "l3-ao requires l3\n");
-		of_node_put(pair_node);
+		}
+		of_node_put(normal_node);
 		pair = devm_kzalloc(dev, sizeof(*pair), GFP_KERNEL);
-		if (!pair)
+		if (!pair) {
+			of_node_put(pair_node);
 			return -ENOMEM;
+		}
 		mutex_init(&pair->lock);
+		ret = rpm_reg_pair_init_boot(dev, pair, pair_node);
+		of_node_put(pair_node);
+		if (ret)
+			return dev_err_probe(dev, ret, "L3 boot APC handoff unavailable\n");
+	} else if (of_property_present(dev->of_node, "qcom,boot-apc-supply")) {
+		return dev_err_probe(dev, -EINVAL, "boot APC requires l3-ao\n");
 	}
 
 	for_each_available_child_of_node_scoped(dev->of_node, node) {
-- 
2.56.0

