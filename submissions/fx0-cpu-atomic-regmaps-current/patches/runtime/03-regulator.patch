From 76068f3c6a4ed1b37d4c7499d7b673e1872839d7 Mon Sep 17 00:00:00 2001
From: Codex <codex@openai.com>
Date: Mon, 16 Nov 2026 00:45:35 -0500
Subject: [PATCH] regulator: qcom-spmi: retain current SAW mapping APIs in the
 runtime

Integrate the qualified standalone regulator port fa4d0bf7b86d onto the
combined runtime, preserving its complete fixed-range APC policy.
Only the permanent MSM8226 L2 master uses its published shared map;
legacy SAWs keep private raw-lock MMIO maps and errors stop probe.
Select REGMAP_MMIO for the driver's direct mapping dependency.

These bytes retain Dmitry Baryshkov's 053c50a70525 upstream raw-map fix
and Kees Cook's 4dd10fbbeb9c allocator API conversion from the pinned
regulator for-next base. Timothy Schmidt's fixed-range feature algorithm
and original attribution remain in the preceding source history. Codex
performed the current-base mapping split, integration and qualification.

The standalone source passes two native RT profiles, three actual
FTS2/provider/recovery methods, the 47-case/407-check acquisition model
and four rejected controls. The separate L2 and PMIC raw-lock fixes are
retained. Full package reproducibility, physical RT/lockdep, voltage and
power acceptance remain separate. Human review/DCO are pending; no
Signed-off-by is added.
---
 drivers/regulator/Kconfig               |  1 +
 drivers/regulator/qcom_spmi-regulator.c | 58 ++++++++++++++++++-------
 2 files changed, 44 insertions(+), 15 deletions(-)

diff --git a/drivers/regulator/Kconfig b/drivers/regulator/Kconfig
index be6b72daa76f..83a76b78e58c 100644
--- a/drivers/regulator/Kconfig
+++ b/drivers/regulator/Kconfig
@@ -1210,6 +1210,7 @@ config REGULATOR_QCOM_SMD_RPM
 config REGULATOR_QCOM_SPMI
 	tristate "Qualcomm SPMI regulator driver"
 	depends on SPMI || COMPILE_TEST
+	select REGMAP_MMIO
 	help
 	  If you say yes to this option, support will be included for the
 	  regulators found in Qualcomm SPMI PMICs.
diff --git a/drivers/regulator/qcom_spmi-regulator.c b/drivers/regulator/qcom_spmi-regulator.c
index 286d764dc03c..4652fa7dca94 100644
--- a/drivers/regulator/qcom_spmi-regulator.c
+++ b/drivers/regulator/qcom_spmi-regulator.c
@@ -12,6 +12,7 @@
 #include <linux/bitops.h>
 #include <linux/slab.h>
 #include <linux/of.h>
+#include <linux/of_address.h>
 #include <linux/of_device.h>
 #include <linux/platform_device.h>
 #include <linux/ktime.h>
@@ -1347,6 +1348,14 @@ struct spmi_saw_request {
 	int result;
 };
 
+static const struct regmap_config saw_regmap_config = {
+	.name = "saw",
+	.reg_bits = 32,
+	.val_bits = 32,
+	.reg_stride = 4,
+	.use_raw_spinlock = true,
+};
+
 static void spmi_saw_set_vdd(void *data)
 {
 	u32 vctl, data3, avs_ctl, pmic_sts;
@@ -2580,6 +2589,33 @@ static const struct of_device_id qcom_spmi_regulator_match[] = {
 };
 MODULE_DEVICE_TABLE(of, qcom_spmi_regulator_match);
 
+static struct regmap *spmi_regulator_get_saw_regmap(struct device *dev)
+{
+	struct device_node *saw;
+	struct regmap *map;
+	void __iomem *base;
+
+	saw = of_parse_phandle(dev->of_node, "qcom,saw-reg", 0);
+	if (!saw)
+		return NULL;
+
+	if (of_device_is_compatible(saw, "qcom,msm8226-saw2-v2.1-l2") &&
+	    of_property_read_bool(saw, "qcom,pmic-arbiter-master")) {
+		/* The permanent SPM owner publishes this map after L2 setup. */
+		map = syscon_node_to_regmap(saw);
+		of_node_put(saw);
+		return PTR_ERR_OR_ZERO(map) == -EINVAL ? ERR_PTR(-EPROBE_DEFER) : map;
+	}
+
+	/* Legacy SAWs retain the private raw-spinlock map required by the IPI. */
+	base = devm_of_iomap(dev, saw, 0, NULL);
+	of_node_put(saw);
+	if (IS_ERR(base))
+		return ERR_CAST(base);
+
+	return devm_regmap_init_mmio(dev, base, &saw_regmap_config);
+}
+
 static int qcom_spmi_regulator_probe(struct platform_device *pdev)
 {
 	const struct spmi_regulator_data *reg;
@@ -2591,12 +2627,12 @@ static int qcom_spmi_regulator_probe(struct platform_device *pdev)
 	const char *name;
 	struct device *dev = &pdev->dev;
 	struct device_node *node = pdev->dev.of_node;
-	struct device_node *syscon, *reg_node;
+	struct device_node *reg_node;
 	struct property *reg_prop;
 	int ret, lenp;
 	struct list_head *vreg_list;
 
-	vreg_list = devm_kzalloc(dev, sizeof(*vreg_list), GFP_KERNEL);
+	vreg_list = devm_kzalloc_obj(dev, *vreg_list);
 	if (!vreg_list)
 		return -ENOMEM;
 	INIT_LIST_HEAD(vreg_list);
@@ -2610,18 +2646,10 @@ static int qcom_spmi_regulator_probe(struct platform_device *pdev)
 	if (!reg)
 		return -ENODEV;
 
-	syscon = of_parse_phandle(node, "qcom,saw-reg", 0);
-	if (syscon) {
-		saw_regmap = syscon_node_to_regmap(syscon);
-		ret = PTR_ERR_OR_ZERO(saw_regmap);
-		if (ret == -EINVAL &&
-		    of_device_is_compatible(syscon, "qcom,msm8226-saw2-v2.1-l2") &&
-		    of_property_read_bool(syscon, "qcom,pmic-arbiter-master"))
-			ret = -EPROBE_DEFER;
-		of_node_put(syscon);
-		if (ret)
-			return dev_err_probe(dev, ret, "could not get SAW regmap\n");
-	}
+	saw_regmap = spmi_regulator_get_saw_regmap(dev);
+	if (IS_ERR(saw_regmap))
+		return dev_err_probe(dev, PTR_ERR(saw_regmap),
+				     "could not get SAW regmap\n");
 
 	for (; reg->name; reg++) {
 
@@ -2640,7 +2668,7 @@ static int qcom_spmi_regulator_probe(struct platform_device *pdev)
 			}
 		}
 
-		vreg = devm_kzalloc(dev, sizeof(*vreg), GFP_KERNEL);
+		vreg = devm_kzalloc_obj(dev, *vreg);
 		if (!vreg)
 			return -ENOMEM;
 
-- 
