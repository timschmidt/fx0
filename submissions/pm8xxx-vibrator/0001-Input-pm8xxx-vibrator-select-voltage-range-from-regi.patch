From 35ba93b296077e032feb98fd6ff22d72423f3840 Mon Sep 17 00:00:00 2001
From: Timothy Schmidt <timschmidt@gmail.com>
Date: Wed, 11 Nov 2026 03:38:40 -0500
Subject: [RFC PATCH 1/3] Input: pm8xxx-vibrator - select voltage range from
 register layout

drv2_addr includes the peripheral base even when drv2_offset is zero.
Testing this absolute address therefore selects the PMI632 voltage range
for PM8058 and PM8916-compatible devices, whose drive fields use 100 mV
steps instead of 8 mV steps. On the Fx0's PM8226, a strong magnitude of
39168 consequently selects drive code 21 instead of the intended code 24.

Select the range from drv2_mask, which identifies whether the second
drive field exists, independently of the peripheral's base address.

Fixes: 9e0631695eac ("input: pm8xxx-vibrator: add new SPMI vibrator support")
---
 drivers/input/misc/pm8xxx-vibrator.c | 6 +++---
 1 file changed, 3 insertions(+), 3 deletions(-)

diff --git a/drivers/input/misc/pm8xxx-vibrator.c b/drivers/input/misc/pm8xxx-vibrator.c
index 03a77443e0be..26476a3e3837 100644
--- a/drivers/input/misc/pm8xxx-vibrator.c
+++ b/drivers/input/misc/pm8xxx-vibrator.c
@@ -11,9 +11,9 @@
 #include <linux/regmap.h>
 #include <linux/slab.h>
 
-#define VIB_MAX_LEVEL_mV(vib)	(vib->drv2_addr ? 3544 : 3100)
-#define VIB_MIN_LEVEL_mV(vib)	(vib->drv2_addr ? 1504 : 1200)
-#define VIB_PER_STEP_mV(vib)	(vib->drv2_addr ? 8 : 100)
+#define VIB_MAX_LEVEL_mV(vib)	((vib)->regs->drv2_mask ? 3544 : 3100)
+#define VIB_MIN_LEVEL_mV(vib)	((vib)->regs->drv2_mask ? 1504 : 1200)
+#define VIB_PER_STEP_mV(vib)	((vib)->regs->drv2_mask ? 8 : 100)
 #define VIB_MAX_LEVELS(vib) \
 	(VIB_MAX_LEVEL_mV(vib) - VIB_MIN_LEVEL_mV(vib) + VIB_PER_STEP_mV(vib))
 
