From 727942c76d42c7c4738c9e8b35056aa74c171e0e Mon Sep 17 00:00:00 2001
From: Timothy Schmidt <timschmidt@gmail.com>
Date: Sun, 1 Nov 2026 14:31:19 -0500
Subject: [PATCH 3/4] dt-bindings: input: syna,rmi4: describe an in-cell I2C
 panel

An in-cell touchscreen needs its display panel powered before it can
communicate. Describe the panel phandle used by the I2C transport's
panel-follower support. Reject the property on SPI devices, whose
transport does not implement this sequencing.

Adapt Timothy Schmidt's original binding change 5adb175d6639, retaining
its Claude assistance attribution. This version gives the reference an
explicit phandle type and restricts it to the implemented transport.

Original AI assistance used Claude:claude-opus-5-5 with checkpatch.
Codex:GPT-6 assisted this current-tree adaptation and source-extracted
ASan/UBSan qualification. The task was to preserve the original hardware
description and sequencing while checking current APIs and error paths.
---
 Documentation/devicetree/bindings/input/syna,rmi4.yaml | 7 +++++++
 1 file changed, 7 insertions(+)

diff --git a/Documentation/devicetree/bindings/input/syna,rmi4.yaml b/Documentation/devicetree/bindings/input/syna,rmi4.yaml
index fb4804ac3544..25056e99c874 100644
--- a/Documentation/devicetree/bindings/input/syna,rmi4.yaml
+++ b/Documentation/devicetree/bindings/input/syna,rmi4.yaml
@@ -43,6 +43,12 @@ properties:
     maxItems: 1
     description: Active low signal
 
+  panel:
+    $ref: /schemas/types.yaml#/definitions/phandle
+    description:
+      Display panel that must be powered on before the in-cell touchscreen.
+      The I2C controller follows the panel's prepare and unprepare sequence.
+
   spi-cpha: true
   spi-cpol: true
 
@@ -219,6 +225,7 @@ allOf:
         spi-tx-delay-us: false
     else:
       properties:
+        panel: false
         syna,reset-delay-ms: false
         syna,startup-delay-ms: false
 
-- 
