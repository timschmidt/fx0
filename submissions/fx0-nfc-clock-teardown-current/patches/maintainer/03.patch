From 9c9357d2bc8877857b3884bbe78e13557946ad2f Mon Sep 17 00:00:00 2001
From: Timothy Schmidt <timschmidt@gmail.com>
Date: Sun, 8 Nov 2026 18:15:16 -0500
Subject: [PATCH] dt-bindings: net: nfc: nxp,nci: describe an optional
 reference clock

Describe one external reference clock named ref. Require clocks and
clock-names together and retain existing clockless descriptions.

Port of Timothy Schmidt's original implementation bca73ac16d42.
Author and timestamp are preserved. The port, changelog and qualification
used OpenAI Codex assistance. Human review and DCO certification remain
pending. No agent Signed-off-by tag is added.
---
 .../devicetree/bindings/net/nfc/nxp,nci.yaml          | 11 +++++++++++
 1 file changed, 11 insertions(+)

diff --git a/Documentation/devicetree/bindings/net/nfc/nxp,nci.yaml b/Documentation/devicetree/bindings/net/nfc/nxp,nci.yaml
index 4f3847f64..4dfb9690b 100644
--- a/Documentation/devicetree/bindings/net/nfc/nxp,nci.yaml
+++ b/Documentation/devicetree/bindings/net/nfc/nxp,nci.yaml
@@ -24,6 +24,13 @@ properties:
   enable-gpios:
     description: Output GPIO pin used for enabling/disabling the controller
 
+  clocks:
+    maxItems: 1
+    description: Optional external reference clock for the controller
+
+  clock-names:
+    const: ref
+
   firmware-gpios:
     description: Output GPIO pin used to enter firmware download mode
 
@@ -39,6 +46,10 @@ required:
   - interrupts
   - reg
 
+dependencies:
+  clocks: [clock-names]
+  clock-names: [clocks]
+
 additionalProperties: false
 
 examples:
