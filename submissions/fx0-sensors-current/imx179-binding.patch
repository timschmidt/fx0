From 0982febda6bb6446d13f800eb132938d41e873f2 Mon Sep 17 00:00:00 2001
From: Timothy Schmidt <timschmidt@gmail.com>
Date: Sat, 31 Oct 2026 06:13:25 -0400
Subject: [PATCH] dt-bindings: media: i2c: Add Sony IMX179

Describe the existing Sony sensor, supply rails, input clock, reset and
CSI-2 graph endpoint. Retain the original hardware description and example.
Add its proposed maintainer entry alongside the other Sony sensor entries.

Adapt Timothy Schmidt's original local proposal
6776d3a5415a6ac9a0754796f105528cb1b84727 to media-committers next at
48fe5a7834cc10081887d7bcd9ff0a4cadc3fa8c.
Original author/date are retained.
The original Claude Opus 5.5 assistance is retained here in prose; Codex
(GPT-6) assisted with adaptation and qualification.

Normal binding examples pass. Full hardware qualification, human review
of the proposed maintainer entry and human DCO remain pending.
---
 .../bindings/media/i2c/sony,imx179.yaml       | 105 ++++++++++++++++++
 MAINTAINERS                                   |   6 +
 2 files changed, 111 insertions(+)
 create mode 100644 Documentation/devicetree/bindings/media/i2c/sony,imx179.yaml

diff --git a/Documentation/devicetree/bindings/media/i2c/sony,imx179.yaml b/Documentation/devicetree/bindings/media/i2c/sony,imx179.yaml
new file mode 100644
index 000000000..22dfcc056
--- /dev/null
+++ b/Documentation/devicetree/bindings/media/i2c/sony,imx179.yaml
@@ -0,0 +1,105 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/media/i2c/sony,imx179.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Sony IMX179 8Mpixel CMOS Digital Image Sensor
+
+maintainers:
+  - Timothy Schmidt <timschmidt@gmail.com>
+
+description:
+  The Sony IMX179 is a CMOS active pixel digital image sensor with an active
+  array size of 3280H x 2464V. It is programmable through I2C at address 0x10
+  and sends image data through four MIPI CSI-2 data lanes.
+
+allOf:
+  - $ref: /schemas/media/video-interface-devices.yaml#
+
+properties:
+  compatible:
+    const: sony,imx179
+
+  reg:
+    maxItems: 1
+
+  clocks:
+    description: Input clock, 24 MHz.
+    maxItems: 1
+
+  dovdd-supply:
+    description: Digital I/O voltage supply, 1.8 volts.
+
+  avdd-supply:
+    description: Analogue voltage supply, 2.8 volts.
+
+  dvdd-supply:
+    description: Digital core voltage supply, 1.2 volts.
+
+  reset-gpios:
+    maxItems: 1
+    description: Reference to the GPIO connected to the XCLR pin.
+
+  port:
+    $ref: /schemas/graph.yaml#/$defs/port-base
+    additionalProperties: false
+
+    properties:
+      endpoint:
+        $ref: /schemas/media/video-interfaces.yaml#
+        unevaluatedProperties: false
+
+        properties:
+          data-lanes:
+            items:
+              - const: 1
+              - const: 2
+              - const: 3
+              - const: 4
+
+          link-frequencies: true
+
+        required:
+          - data-lanes
+          - link-frequencies
+
+required:
+  - compatible
+  - reg
+  - clocks
+  - dovdd-supply
+  - avdd-supply
+  - dvdd-supply
+  - reset-gpios
+  - port
+
+unevaluatedProperties: false
+
+examples:
+  - |
+    #include <dt-bindings/gpio/gpio.h>
+
+    i2c {
+        #address-cells = <1>;
+        #size-cells = <0>;
+
+        sensor@10 {
+            compatible = "sony,imx179";
+            reg = <0x10>;
+            clocks = <&cam_mclk0>;
+            dovdd-supply = <&vreg_1v8>;
+            avdd-supply = <&vreg_2v8>;
+            dvdd-supply = <&vreg_1v2>;
+            reset-gpios = <&tlmm 114 GPIO_ACTIVE_LOW>;
+
+            port {
+                endpoint {
+                    remote-endpoint = <&csiphy0_ep>;
+                    data-lanes = <1 2 3 4>;
+                    link-frequencies = /bits/ 64 <324000000>;
+                };
+            };
+        };
+    };
+...
