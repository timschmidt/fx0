+/* Keep an unavailable or malformed value distinct from a valid zero. */
+gboolean
+up_device_supply_read_number (GUdevDevice *native, const gchar *attribute,
+                             gdouble *number)
+{
+	const gchar *text;
+	gchar *end;
+	gdouble value;
+
+	text = g_udev_device_get_sysfs_attr_uncached (native, attribute);
+	if (!text)
+		return FALSE;
+
+	errno = 0;
+	value = g_ascii_strtod (text, &end);
+	if (end == text || errno == ERANGE || !isfinite (value) ||
+	    value < (gdouble) G_MININT64 || value >= -(gdouble) G_MININT64)
+		return FALSE;
+	while (g_ascii_isspace (*end))
+		end++;
+	if (*end)
+		return FALSE;
+
+	*number = value;
+	return TRUE;
+}
