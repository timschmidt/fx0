From a92cd32547b35c45db6acdf03bf92efeaa2b76d3 Mon Sep 17 00:00:00 2001
From: Timothy Schmidt <timschmidt@gmail.com>
Date: Mon, 16 Nov 2026 23:22:59 -0500
Subject: [PATCH] dt-bindings: power: Describe MSM8226 system sleep
 coordination

Describe the RPM child that coordinates CPR, CPU/L2 SAW and MPM during
MSM8226 system sleep. Restrict that child to the MSM8226 resource
service and describe the MPM interrupt controller's zero address-cell
form. Route the new binding through the existing Qualcomm architecture
maintainers.

Backport onto maintained Linux 6.18.63 while preserving its platform
context and APIs. The ten-change batch passes 5009 synthetic model cases,
85 fault controls and 175 selected native objects across seven supported
feature/config profiles. ARM32 RT is unsupported and is not counted.

All 18 family DTBs build and 180 selected schema checks are silent;
the 17 prior DTBs are byte-identical. The new target repeats three
existing DTC warnings. Unfiltered schema validation still rejects the
existing PM8226 torch child; that independent port remains pending.

Services and faults are synthetic. Firmware, kernel concurrency, normal
package integration and physical acceptance remain open. Codex prepared
this local backport and verification. Original authors, dates and source
notices are retained; no human DCO or publication is claimed.

Backported from commit 5684a2e2d774 ("dt-bindings: power: Describe
MSM8226 system sleep coordination")
---
 .../interrupt-controller/qcom,mpm.yaml        |  3 ++
 .../power/qcom,msm8226-system-pm.yaml         | 45 +++++++++++++++++++
 .../bindings/soc/qcom/qcom,smd-rpm.yaml       | 16 +++++++
 MAINTAINERS                                   |  1 +
 4 files changed, 65 insertions(+)
 create mode 100644 Documentation/devicetree/bindings/power/qcom,msm8226-system-pm.yaml

diff --git a/Documentation/devicetree/bindings/interrupt-controller/qcom,mpm.yaml b/Documentation/devicetree/bindings/interrupt-controller/qcom,mpm.yaml
index ebb40c48950ab..1efb3dceb057d 100644
--- a/Documentation/devicetree/bindings/interrupt-controller/qcom,mpm.yaml
+++ b/Documentation/devicetree/bindings/interrupt-controller/qcom,mpm.yaml
@@ -48,6 +48,9 @@ properties:
 
   interrupt-controller: true
 
+  '#address-cells':
+    const: 0
+
   '#interrupt-cells':
     const: 2
     description:
diff --git a/Documentation/devicetree/bindings/power/qcom,msm8226-system-pm.yaml b/Documentation/devicetree/bindings/power/qcom,msm8226-system-pm.yaml
new file mode 100644
index 0000000000000..5b4b6a0fb2765
--- /dev/null
+++ b/Documentation/devicetree/bindings/power/qcom,msm8226-system-pm.yaml
@@ -0,0 +1,45 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/power/qcom,msm8226-system-pm.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Qualcomm MSM8226 CPU cluster system power coordination
+
+maintainers:
+  - Bjorn Andersson <andersson@kernel.org>
+
+description: |
+  MSM8226 and MSM8926 combine CPU and L2 SAW sequencers, CPR-controlled CPU
+  voltage, RPM resource votes and the MPM wake controller for system power
+  collapse. This child of the RPM resource service identifies the providers
+  that participate in the shared cluster transition. CPU SAW and ACC blocks
+  are described by the CPU nodes themselves.
+
+properties:
+  $nodename:
+    const: system-sleep
+
+  compatible:
+    const: qcom,msm8226-system-pm
+
+  qcom,cpr:
+    $ref: /schemas/types.yaml#/definitions/phandle
+    description: MSM8926 CPR controller for the CPU cluster.
+
+  qcom,mpm:
+    $ref: /schemas/types.yaml#/definitions/phandle
+    description: Always-on MPM wake controller.
+
+  qcom,l2-spm:
+    $ref: /schemas/types.yaml#/definitions/phandle
+    description: L2 SAW sequencer and shared PMIC arbiter master.
+
+required:
+  - compatible
+  - qcom,cpr
+  - qcom,mpm
+  - qcom,l2-spm
+
+additionalProperties: false
+...
diff --git a/Documentation/devicetree/bindings/soc/qcom/qcom,smd-rpm.yaml b/Documentation/devicetree/bindings/soc/qcom/qcom,smd-rpm.yaml
index 270bcd079f886..8831b84d1ef09 100644
--- a/Documentation/devicetree/bindings/soc/qcom/qcom,smd-rpm.yaml
+++ b/Documentation/devicetree/bindings/soc/qcom/qcom,smd-rpm.yaml
@@ -62,6 +62,9 @@ properties:
               - qcom,rpm-sm6375
           - const: qcom,glink-smd-rpm
 
+  system-sleep:
+    $ref: /schemas/power/qcom,msm8226-system-pm.yaml#
+
   clock-controller:
     $ref: /schemas/clock/qcom,rpmcc.yaml#
     unevaluatedProperties: false
@@ -81,6 +84,19 @@ properties:
     items:
       - const: rpm_requests
 
+allOf:
+  - if:
+      properties:
+        compatible:
+          contains:
+            const: qcom,rpm-msm8226
+    then:
+      properties:
+        system-sleep: true
+    else:
+      properties:
+        system-sleep: false
+
 patternProperties:
   "^regulators(-[01])?$":
     $ref: /schemas/regulator/qcom,smd-rpm-regulator.yaml#
diff --git a/MAINTAINERS b/MAINTAINERS
index e6bf0757aa2bf..9fdc86dd82c85 100644
--- a/MAINTAINERS
+++ b/MAINTAINERS
@@ -3207,6 +3207,7 @@ F:	Documentation/devicetree/bindings/arm/qcom.yaml
 F:	Documentation/devicetree/bindings/bus/qcom*
 F:	Documentation/devicetree/bindings/cache/qcom,llcc.yaml
 F:	Documentation/devicetree/bindings/firmware/qcom,scm.yaml
+F:	Documentation/devicetree/bindings/power/qcom,msm8226-system-pm.yaml
 F:	Documentation/devicetree/bindings/reserved-memory/qcom*
 F:	Documentation/devicetree/bindings/soc/qcom/
 F:	arch/arm/boot/dts/qcom/
