     const: 2
     description:
diff --git a/Documentation/devicetree/bindings/power/qcom,msm8226-system-pm.yaml b/Documentation/devicetree/bindings/power/qcom,msm8226-system-pm.yaml
new file mode 100644
index 000000000000..5b4b6a0fb276
--- /dev/null
+++ b/Documentation/devicetree/bindings/power/qcom,msm8226-system-pm.yaml
@@ -0,0 +1,45 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/power/qcom,msm8226-system-pm.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Qualcomm MSM8226 CPU cluster system power coordination
+
+maintainers:
+  - Bjorn Andersson <andersson@kernel.org>
+
+description: |
+  MSM8226 and MSM8926 combine CPU and L2 SAW sequencers, CPR-controlled CPU
+  voltage, RPM resource votes and the MPM wake controller for system power
+  collapse. This child of the RPM resource service identifies the providers
+  that participate in the shared cluster transition. CPU SAW and ACC blocks
+  are described by the CPU nodes themselves.
+
+properties:
+  $nodename:
+    const: system-sleep
+
+  compatible:
+    const: qcom,msm8226-system-pm
+
+  qcom,cpr:
+    $ref: /schemas/types.yaml#/definitions/phandle
+    description: MSM8926 CPR controller for the CPU cluster.
+
+  qcom,mpm:
+    $ref: /schemas/types.yaml#/definitions/phandle
+    description: Always-on MPM wake controller.
+
+  qcom,l2-spm:
+    $ref: /schemas/types.yaml#/definitions/phandle
+    description: L2 SAW sequencer and shared PMIC arbiter master.
+
+required:
+  - compatible
+  - qcom,cpr
+  - qcom,mpm
+  - qcom,l2-spm
+
+additionalProperties: false
+...
diff --git a/Documentation/devicetree/bindings/soc/qcom/qcom,smd-rpm.yaml b/Documentation/devicetree/bindings/soc/qcom/qcom,smd-rpm.yaml
index bd1d32898461..11d8326c33d5 100644
--- a/Documentation/devicetree/bindings/soc/qcom/qcom,smd-rpm.yaml
+++ b/Documentation/devicetree/bindings/soc/qcom/qcom,smd-rpm.yaml
@@ -63,6 +63,9 @@ properties:
               - qcom,rpm-sm6375
           - const: qcom,glink-smd-rpm
 
+  system-sleep:
+    $ref: /schemas/power/qcom,msm8226-system-pm.yaml#
+
   clock-controller:
     $ref: /schemas/clock/qcom,rpmcc.yaml#
     unevaluatedProperties: false
@@ -82,6 +85,19 @@ properties:
     items:
       - const: rpm_requests
 
+allOf:
+  - if:
+      properties:
+        compatible:
+          contains:
+            const: qcom,rpm-msm8226
+    then:
+      properties:
+        system-sleep: true
+    else:
+      properties:
+        system-sleep: false
+
 patternProperties:
   "^regulators(-[01])?$":
     $ref: /schemas/regulator/qcom,smd-rpm-regulator.yaml#
diff --git a/MAINTAINERS b/MAINTAINERS
