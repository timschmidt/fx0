From 90e124443e734b29660a96a9019cac3dce49e15b Mon Sep 17 00:00:00 2001
From: Timothy Schmidt <timschmidt@gmail.com>
Date: Sun, 8 Nov 2026 16:33:09 +0000
Subject: [PATCH 08/35] ARM: dts: qcom: madai: describe raw CPU calibration
 cells

Describe the complete raw fuse rows used for the CPU calibration path. Leave protected conditional calibration behind the secure-monitor service.

Source-patch: patches/linux-integration/fx0-msm8926-raw-qfprom-dt.diff
Source-sha256: 08e458d5cca9c00441fa177cf38fbf74984a680bebc66ff014a80e73835f7aa1
---
 .../boot/dts/qcom/qcom-msm8926-lg-madai.dts   | 23 +++++++++++++++++++
 1 file changed, 23 insertions(+)

diff --git a/arch/arm/boot/dts/qcom/qcom-msm8926-lg-madai.dts b/arch/arm/boot/dts/qcom/qcom-msm8926-lg-madai.dts
index 881ea210b8b5..4e09310c6609 100644
--- a/arch/arm/boot/dts/qcom/qcom-msm8926-lg-madai.dts
+++ b/arch/arm/boot/dts/qcom/qcom-msm8926-lg-madai.dts
@@ -706,3 +706,26 @@ cdc_mclk_default: cdc-mclk-default-state {
 		qcom,drive-strength = <PMIC_GPIO_STRENGTH_HIGH>;
 	};
 };
+
+/* CPU/CPR fuses use the raw view; TSENS retains the corrected provider. */
+&soc {
+	qfprom_raw: efuse@fc4b8000 {
+		compatible = "qcom,msm8926-qfprom-raw";
+		reg = <0xfc4b8000 0x1000>;
+		read-only;
+		#address-cells = <1>;
+		#size-cells = <1>;
+
+		cpu_speedbin: cpu-bin@b0 {
+			reg = <0xb0 0x4>;
+		};
+
+		cpr_primary: cpr-primary@450 {
+			reg = <0x450 0x8>;
+		};
+
+		cpr_redundant: cpr-redundant@458 {
+			reg = <0x458 0x8>;
+		};
+	};
+};
