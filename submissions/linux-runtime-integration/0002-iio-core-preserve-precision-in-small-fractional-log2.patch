From 383c3b717e5d4d16a7fad5ef5da471b71b23b645 Mon Sep 17 00:00:00 2001
From: Timothy Schmidt <timschmidt@gmail.com>
Date: Sun, 8 Nov 2026 16:33:09 +0000
Subject: [PATCH 02/35] iio: core: preserve precision in small fractional log2
 values

Format small signed binary fractions without truncating them to zero. Bound supported shifts and keep the integer arithmetic valid at the signed numerator limits.

Source-patch: patches/linux-integration/iio-preserve-tiny-log2-scale.diff
Source-sha256: 7b01db1be9db0b1e73a4cb3034cd05d5b3eb164990fe6024fc58804278aaa0b0
---
 drivers/iio/industrialio-core.c    | 23 +++++++++++++++++++++++
 drivers/iio/test/iio-test-format.c | 20 ++++++++++++++++++++
 2 files changed, 43 insertions(+)

diff --git a/drivers/iio/industrialio-core.c b/drivers/iio/industrialio-core.c
index be2b3259c8e7..74c085ee3628 100644
--- a/drivers/iio/industrialio-core.c
+++ b/drivers/iio/industrialio-core.c
@@ -20,6 +20,7 @@
 #include <linux/kdev_t.h>
 #include <linux/kernel.h>
 #include <linux/module.h>
+#include <linux/math64.h>
 #include <linux/mutex.h>
 #include <linux/poll.h>
 #include <linux/property.h>
@@ -650,6 +651,25 @@ int iio_read_mount_matrix(struct device *dev, struct iio_mount_matrix *matrix)
 }
 EXPORT_SYMBOL(iio_read_mount_matrix);
 
+/* Power-of-two fractions terminate after at most shift decimal places. */
+static ssize_t iio_format_tiny_log2(char *buf, size_t offset, int numerator, unsigned int shift)
+{
+	u64 remainder = numerator < 0 ? -(s64)numerator : numerator;
+	u64 divisor = BIT_ULL(shift);
+	char fraction[64];
+	unsigned int digit, count = 0;
+
+	while (remainder && count < shift) {
+		digit = mul_u64_u64_div_u64(remainder, 10, divisor);
+		/* Unsigned wrap cancels here; the resulting remainder is < divisor. */
+		remainder = remainder * 10 - digit * divisor;
+		fraction[count++] = '0' + digit;
+	}
+	fraction[count] = '\0';
+
+	return sysfs_emit_at(buf, offset, "%s0.%s", numerator < 0 ? "-" : "", fraction);
+}
+
 static ssize_t __iio_format_value(char *buf, size_t offset, unsigned int type,
 				  int size, const int *vals)
 {
@@ -688,6 +708,9 @@ static ssize_t __iio_format_value(char *buf, size_t offset, unsigned int type,
 					     abs(tmp1));
 	case IIO_VAL_FRACTIONAL_LOG2:
 		tmp2 = shift_right((s64)vals[0] * 1000000000LL, vals[1]);
+		/* Preserve nonzero scales smaller than the usual nine decimal places. */
+		if (!tmp2 && vals[0] && vals[1] > 0 && vals[1] < 64)
+			return iio_format_tiny_log2(buf, offset, vals[0], vals[1]);
 		tmp0 = (int)div_s64_rem(tmp2, 1000000000LL, &tmp1);
 		if (tmp0 == 0 && tmp2 < 0)
 			return sysfs_emit_at(buf, offset, "-0.%09u", abs(tmp1));
diff --git a/drivers/iio/test/iio-test-format.c b/drivers/iio/test/iio-test-format.c
index 872dd8582003..3abf39e74f9c 100644
--- a/drivers/iio/test/iio-test-format.c
+++ b/drivers/iio/test/iio-test-format.c
@@ -181,6 +181,26 @@ static void iio_test_iio_format_value_fractional_log2(struct kunit *test)
 	values[1] = 10;
 	ret = iio_format_value(buf, IIO_VAL_FRACTIONAL_LOG2, ARRAY_SIZE(values), values);
 	IIO_TEST_FORMAT_EXPECT_EQ(test, buf, ret, "0.000000000\n");
+
+	/* Q30 quaternion scale must not be rounded to zero. */
+	values[0] = 1;
+	values[1] = 30;
+	ret = iio_format_value(buf, IIO_VAL_FRACTIONAL_LOG2, ARRAY_SIZE(values), values);
+	IIO_TEST_FORMAT_EXPECT_EQ(test, buf, ret, "0.000000000931322574615478515625\n");
+	values[0] = -1;
+	ret = iio_format_value(buf, IIO_VAL_FRACTIONAL_LOG2, ARRAY_SIZE(values), values);
+	IIO_TEST_FORMAT_EXPECT_EQ(test, buf, ret, "-0.000000000931322574615478515625\n");
+
+	/* Maximum supported shift and signed numerator boundary. */
+	values[0] = 1;
+	values[1] = 63;
+	ret = iio_format_value(buf, IIO_VAL_FRACTIONAL_LOG2, ARRAY_SIZE(values), values);
+	IIO_TEST_FORMAT_EXPECT_EQ(test, buf, ret,
+		"0.000000000000000000108420217248550443400745280086994171142578125\n");
+	values[0] = INT_MIN;
+	ret = iio_format_value(buf, IIO_VAL_FRACTIONAL_LOG2, ARRAY_SIZE(values), values);
+	IIO_TEST_FORMAT_EXPECT_EQ(test, buf, ret, "-0.00000000023283064365386962890625\n");
+
 }
 
 static void iio_test_iio_format_value_multiple(struct kunit *test)
