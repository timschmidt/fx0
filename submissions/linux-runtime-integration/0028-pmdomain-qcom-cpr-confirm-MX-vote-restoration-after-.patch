From 2a8130e74de8d74607729231d8d2249271d5d18d Mon Sep 17 00:00:00 2001
From: Timothy Schmidt <timschmidt@gmail.com>
Date: Sun, 8 Nov 2026 16:33:09 +0000
Subject: [PATCH 28/35] pmdomain: qcom: cpr: confirm MX vote restoration after
 errors

Force the previous MX vote through the provider after an uncertain request failure instead of trusting a same-value core cache hit. Stop execution if physical vote restoration cannot be confirmed.

Source-patch: patches/linux-integration/fx0-cpr-mx-vote-recovery.diff
Source-sha256: bd0ed2c8b2d5eb24017e1e209e67cdeb1e61fe1c116658e16a118f09eeee127e
---
 drivers/pmdomain/qcom/cpr-voltage.h | 18 ++++++++++++++++--
 1 file changed, 16 insertions(+), 2 deletions(-)

diff --git a/drivers/pmdomain/qcom/cpr-voltage.h b/drivers/pmdomain/qcom/cpr-voltage.h
index 55201cd59833..3fd485939920 100644
--- a/drivers/pmdomain/qcom/cpr-voltage.h
+++ b/drivers/pmdomain/qcom/cpr-voltage.h
@@ -3,6 +3,7 @@
 #define __QCOM_CPR_VOLTAGE_H__
 
 #include <linux/errno.h>
+#include <linux/panic.h>
 #include <linux/regulator/consumer.h>
 
 /* The caller owns locking and must retain MX while APC can remain live. */
@@ -17,14 +18,27 @@ struct cpr_voltage {
 
 static inline int cpr_voltage_vote_mx(struct cpr_voltage *rails, int min_uV)
 {
-	int ret;
+	int ret, recovery;
 
 	if (!rails->mx || min_uV <= 0 || min_uV > rails->mx_max_uV)
 		return -EINVAL;
 
 	ret = regulator_set_voltage(rails->mx, min_uV, rails->mx_max_uV);
-	if (!ret)
+	if (!ret) {
 		rails->mx_min_uV = min_uV;
+	} else if (rails->mx_enabled && rails->mx_min_uV > 0) {
+		/*
+		 * A timed-out RPM request may already have changed the vote.
+		 * Core restored the old consumer request on failure; force it
+		 * through the provider instead of accepting a cached same vote.
+		 * RPM must correlate replies before this can confirm restoration.
+		 */
+		recovery = regulator_sync_voltage(rails->mx);
+		if (recovery)
+			recovery = regulator_sync_voltage(rails->mx);
+		if (recovery)
+			panic("CPR MX vote recovery failed: %d", recovery);
+	}
 
 	return ret;
 }
