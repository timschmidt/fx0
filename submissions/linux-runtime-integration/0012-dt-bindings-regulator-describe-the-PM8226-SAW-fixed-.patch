From c24c35f69fc4becd77ebd0b43d40489a9c160ace Mon Sep 17 00:00:00 2001
From: Timothy Schmidt <timschmidt@gmail.com>
Date: Sun, 8 Nov 2026 16:33:09 +0000
Subject: [PATCH 12/35] dt-bindings: regulator: describe the PM8226 SAW fixed
 range

Describe the fixed-range PM8226 APC regulator used through SAW. Constrain the range representation needed by the CPU voltage plan.

Source-patch: patches/linux-integration/fx0-pm8226-saw-fixed-range-binding.diff
Source-sha256: 23cdad9ce596deed1beed66cdf898c4e2bad7c194f1e16762eb52f9bea323451
---
 .../regulator/qcom,spmi-regulator.yaml        | 33 +++++++++++++++++++
 1 file changed, 33 insertions(+)

diff --git a/Documentation/devicetree/bindings/regulator/qcom,spmi-regulator.yaml b/Documentation/devicetree/bindings/regulator/qcom,spmi-regulator.yaml
index aea849e8eadf..1b14316cee1e 100644
--- a/Documentation/devicetree/bindings/regulator/qcom,spmi-regulator.yaml
+++ b/Documentation/devicetree/bindings/regulator/qcom,spmi-regulator.yaml
@@ -101,15 +101,48 @@ patternProperties:
         description: SAW controlled gang slave. Will not be configured.
         type: boolean
 
+      qcom,saw-fixed-range:
+        description:
+          PM8226 S2 uses its immutable power-on FTS2 voltage range through
+          the L2 SAW controller. Expose only that range, acknowledge voltage
+          commands and allow the PMIC slew time before returning success.
+          Requires a SAW leader, an initialized Madai L2 master controller
+          and disabled hardware AVS.
+        type: boolean
+
       qcom,saw-leader:
         description:
           SAW controlled gang leader. Will be configured as SAW regulator.
         type: boolean
 
+    allOf:
+      - if:
+          required: ["qcom,saw-fixed-range"]
+        then:
+          required: ["qcom,saw-leader"]
+          properties:
+            qcom,saw-slave: false
+
+  "^(?!s2$)(5vs[1-2]|(l|s)[1-9][0-9]?|lvs[1-4])$":
+    type: object
+    properties:
+      qcom,saw-fixed-range: false
+
 required:
   - compatible
 
 allOf:
+  - if:
+      required: [s2]
+      properties:
+        s2:
+          required: ["qcom,saw-fixed-range"]
+    then:
+      required: ["qcom,saw-reg"]
+      properties:
+        compatible:
+          const: qcom,pm8226-regulators
+
   - if:
       properties:
         compatible:
