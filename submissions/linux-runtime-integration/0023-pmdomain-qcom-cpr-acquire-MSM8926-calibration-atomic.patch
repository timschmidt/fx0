From 02d2367460be2ce84b24dfba9bf71590e632684f Mon Sep 17 00:00:00 2001
From: Timothy Schmidt <timschmidt@gmail.com>
Date: Sun, 8 Nov 2026 16:33:09 +0000
Subject: [PATCH 23/35] pmdomain: qcom: cpr: acquire MSM8926 calibration
 atomically

Read complete raw rows and use the secure service for the protected conditional selector. Publish calibration only after all reads and nominal decoding succeed.

Source-patch: patches/linux-integration/fx0-msm8926-calibration-load.diff
Source-sha256: 09c459db1158f514fec1ba940e4ddea0e88ced74bcfe8883b627e73a0aa6aa8e
---
 .../boot/dts/qcom/qcom-msm8926-lg-madai.dts   |  2 +-
 drivers/pmdomain/qcom/cpr-msm8926-fuses.h     | 73 +++++++++++++++++++
 2 files changed, 74 insertions(+), 1 deletion(-)
 create mode 100644 drivers/pmdomain/qcom/cpr-msm8926-fuses.h

diff --git a/arch/arm/boot/dts/qcom/qcom-msm8926-lg-madai.dts b/arch/arm/boot/dts/qcom/qcom-msm8926-lg-madai.dts
index 4842beee4bf2..005e0ee9b171 100644
--- a/arch/arm/boot/dts/qcom/qcom-msm8926-lg-madai.dts
+++ b/arch/arm/boot/dts/qcom/qcom-msm8926-lg-madai.dts
@@ -734,7 +734,7 @@ qfprom_raw: efuse@fc4b8000 {
 		#size-cells = <1>;
 
 		cpu_speedbin: cpu-bin@b0 {
-			reg = <0xb0 0x4>;
+			reg = <0xb0 0x8>;
 		};
 
 		cpr_primary: cpr-primary@450 {
diff --git a/drivers/pmdomain/qcom/cpr-msm8926-fuses.h b/drivers/pmdomain/qcom/cpr-msm8926-fuses.h
new file mode 100644
index 000000000000..7bc8e8400a36
--- /dev/null
+++ b/drivers/pmdomain/qcom/cpr-msm8926-fuses.h
@@ -0,0 +1,73 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef __QCOM_CPR_MSM8926_FUSES_H__
+#define __QCOM_CPR_MSM8926_FUSES_H__
+
+#include <linux/err.h>
+#include <linux/firmware/qcom/qcom_scm.h>
+#include <linux/nvmem-consumer.h>
+#include <linux/slab.h>
+#include <linux/unaligned.h>
+
+#include "cpr-msm8926.h"
+
+/* Both halves of row22 are needed: the uplift selector is bit53. */
+static inline int cpr_msm8926_read_row(struct device *dev, const char *name,
+				       u64 *row)
+{
+	struct nvmem_cell *cell;
+	size_t length;
+	void *data;
+	int ret = 0;
+
+	cell = nvmem_cell_get(dev, name);
+	if (IS_ERR(cell))
+		return PTR_ERR(cell);
+	data = nvmem_cell_read(cell, &length);
+	nvmem_cell_put(cell);
+	if (IS_ERR(data))
+		return PTR_ERR(data);
+	if (length != sizeof(*row))
+		ret = -EINVAL;
+	else
+		*row = get_unaligned_le64(data);
+	kfree_sensitive(data);
+
+	return ret;
+}
+
+/*
+ * Sleepable acquisition for the MSM8926 CPR consumer. NVMEM cells must name
+ * full, unshifted raw rows22/138/139. Protected row54 is read only through the
+ * legacy SCM service; a failed read must never select a voltage rule. Publish
+ * calibration only after all reads and the nominal decoder have succeeded.
+ * This does not enable CPR, activate regulators or authorize any CPU OPP.
+ */
+static inline int
+cpr_msm8926_read_calibration(struct device *dev,
+			     struct cpr_msm8926_calibration *calibration)
+{
+	struct cpr_msm8926_fuses fuses = {};
+	u64 conditional;
+	int ret;
+
+	if (!dev || !calibration)
+		return -EINVAL;
+
+	ret = qcom_scm_legacy_fuse_read(0xfc4b81b0, &conditional);
+	if (ret)
+		return ret < 0 ? ret : -EIO;
+	fuses.conditional_matches = ((conditional >> 42) & 63) == 7;
+	ret = cpr_msm8926_read_row(dev, "cpu_calibration", &fuses.row22);
+	if (ret)
+		return ret;
+	ret = cpr_msm8926_read_row(dev, "cpr_primary", &fuses.row138);
+	if (ret)
+		return ret;
+	ret = cpr_msm8926_read_row(dev, "cpr_redundant", &fuses.row139);
+	if (ret)
+		return ret;
+
+	return cpr_msm8926_decode(&fuses, calibration);
+}
+
+#endif
