From 846f609040cfdc2dba49020eb4d048458e8dbe59 Mon Sep 17 00:00:00 2001
From: Timothy Schmidt <timschmidt@gmail.com>
Date: Sun, 8 Nov 2026 16:33:09 +0000
Subject: [PATCH 15/35] soc: qcom: spm: register the MSM8226 L2 master owner

Bind the MSM8226 L2 master and expose its shared APC register interface without programming per-CPU idle controls through that owner. Keep the CPU0 execution and ownership restrictions explicit.

Source-patch: patches/linux-integration/fx0-msm8226-l2-master-driver.diff
Source-sha256: 67b29ca5dd4f5a62225abc29253d890c72ecfebe6c06d4856170ba9d8efaeaab
---
 drivers/regulator/qcom_spmi-regulator.c | 10 ++-
 drivers/soc/qcom/Kconfig                |  1 +
 drivers/soc/qcom/spm-msm8226-l2.h       | 88 +++++++++++++++++++++++
 drivers/soc/qcom/spm.c                  | 92 +++++++++++++++++++++++++
 4 files changed, 188 insertions(+), 3 deletions(-)
 create mode 100644 drivers/soc/qcom/spm-msm8226-l2.h

diff --git a/drivers/regulator/qcom_spmi-regulator.c b/drivers/regulator/qcom_spmi-regulator.c
index 10c8d0d09ed5..17944710cc62 100644
--- a/drivers/regulator/qcom_spmi-regulator.c
+++ b/drivers/regulator/qcom_spmi-regulator.c
@@ -2598,10 +2598,14 @@ static int qcom_spmi_regulator_probe(struct platform_device *pdev)
 	syscon = of_parse_phandle(node, "qcom,saw-reg", 0);
 	if (syscon) {
 		saw_regmap = syscon_node_to_regmap(syscon);
+		ret = PTR_ERR_OR_ZERO(saw_regmap);
+		if (ret == -EINVAL &&
+		    of_device_is_compatible(syscon, "qcom,msm8226-saw2-v2.1-l2") &&
+		    of_property_read_bool(syscon, "qcom,pmic-arbiter-master"))
+			ret = -EPROBE_DEFER;
 		of_node_put(syscon);
-		if (IS_ERR(saw_regmap))
-			return dev_err_probe(dev, PTR_ERR(saw_regmap),
-					     "could not get SAW regmap\n");
+		if (ret)
+			return dev_err_probe(dev, ret, "could not get SAW regmap\n");
 	}
 
 	for (; reg->name; reg++) {
diff --git a/drivers/soc/qcom/Kconfig b/drivers/soc/qcom/Kconfig
index 2caadbbcf830..bb7881c38624 100644
--- a/drivers/soc/qcom/Kconfig
+++ b/drivers/soc/qcom/Kconfig
@@ -230,6 +230,7 @@ config QCOM_SOCINFO
 config QCOM_SPM
 	tristate "Qualcomm Subsystem Power Manager (SPM)"
 	depends on ARCH_QCOM || COMPILE_TEST
+	select MFD_SYSCON
 	select QCOM_SCM
 	help
 	  Enable the support for the Qualcomm Subsystem Power Manager, used
diff --git a/drivers/soc/qcom/spm-msm8226-l2.h b/drivers/soc/qcom/spm-msm8226-l2.h
new file mode 100644
index 000000000000..1cb42580ac68
--- /dev/null
+++ b/drivers/soc/qcom/spm-msm8226-l2.h
@@ -0,0 +1,88 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef __QCOM_SPM_MSM8226_L2_H__
+#define __QCOM_SPM_MSM8226_L2_H__
+
+#include <linux/errno.h>
+#include <linux/regmap.h>
+
+/* Compiled Madai L2 master configuration; never issue VCTL or run a sequence. */
+static inline int spm_8226_l2_master_init(struct regmap *map)
+{
+	static const unsigned int registers[] = { 8, 0x34, 0x40, 0x44 };
+	static const unsigned int expected[] = {
+		0x14, 0x3c102800, 0x02030080, 0x00030000,
+	};
+	unsigned int values[4], version, id, avs, control, value;
+	bool complete = true;
+	unsigned int i;
+	int ret;
+
+	ret = regmap_read(map, 0xfd0, &version);
+	if (ret)
+		return ret;
+	if (version != 0x20010000)
+		return -ENODEV;
+	ret = regmap_read(map, 4, &id);
+	if (ret)
+		return ret;
+	if (!(id & 4))
+		return -ENODEV;
+	ret = regmap_read(map, 0x20, &avs);
+	if (ret)
+		return ret;
+	if (avs & 1)
+		return -EBUSY;
+	ret = regmap_read(map, 0x30, &control);
+	if (ret)
+		return ret;
+	if (control)
+		return -EBUSY;
+
+	for (i = 0; i < 4; i++) {
+		ret = regmap_read(map, registers[i], &values[i]);
+		if (ret)
+			return ret;
+		if (values[i] && values[i] != expected[i])
+			return -EOPNOTSUPP;
+		complete &= values[i] == expected[i];
+	}
+	/* Never repair a live, inconsistently configured arbiter. */
+	if (values[0] && !complete)
+		return -EOPNOTSUPP;
+
+	/* Retry known partial setup safely while CFG is still disabled. */
+	for (i = 1; i < 4; i++) {
+		if (values[i] != expected[i]) {
+			ret = regmap_write(map, registers[i], expected[i]);
+			if (ret)
+				return ret;
+		}
+		ret = regmap_read(map, registers[i], &value);
+		if (ret)
+			return ret;
+		if (value != expected[i])
+			return -EIO;
+	}
+	/* Publish the master configuration only after its data is verified. */
+	if (!values[0]) {
+		ret = regmap_write(map, registers[0], expected[0]);
+		if (ret)
+			return ret;
+	}
+	ret = regmap_read(map, registers[0], &value);
+	if (ret)
+		return ret;
+	if (value != expected[0])
+		return -EIO;
+	ret = regmap_read(map, 0x30, &control);
+	if (ret)
+		return ret;
+	if (control)
+		return -EBUSY;
+	ret = regmap_read(map, 0x20, &avs);
+	if (ret)
+		return ret;
+	return avs & 1 ? -EBUSY : 0;
+}
+
+#endif
diff --git a/drivers/soc/qcom/spm.c b/drivers/soc/qcom/spm.c
index f75659fff287..c4a70565ad6b 100644
--- a/drivers/soc/qcom/spm.c
+++ b/drivers/soc/qcom/spm.c
@@ -13,6 +13,8 @@
 #include <linux/iopoll.h>
 #include <linux/kernel.h>
 #include <linux/linear_range.h>
+#include <linux/mfd/syscon.h>
+#include <linux/regmap.h>
 #include <linux/module.h>
 #include <linux/of.h>
 #include <linux/platform_device.h>
@@ -23,6 +25,8 @@
 
 #include <soc/qcom/spm.h>
 
+#include "spm-msm8226-l2.h"
+
 #define FIELD_SET(current, mask, val)	\
 	(((current) & ~(mask)) | FIELD_PREP((mask), (val)))
 
@@ -62,6 +66,7 @@ enum spm_reg {
 #define MAX_SEQ_DATA		64
 
 struct spm_reg_data {
+	bool pmic_arbiter_master;
 	const u16 *reg_offset;
 	u32 spm_cfg;
 	u32 spm_dly;
@@ -207,6 +212,10 @@ static const struct spm_reg_data spm_reg_8974_8084_cpu  = {
 };
 
 /* SPM register data for 8226 */
+static const struct spm_reg_data spm_reg_8226_l2 = {
+	.pmic_arbiter_master = true,
+};
+
 static const struct spm_reg_data spm_reg_8226_cpu  = {
 	.reg_offset = spm_reg_offset_v2_1,
 	.spm_cfg = 0x0,
@@ -293,6 +302,11 @@ void spm_set_low_power_mode(struct spm_driver_data *drv,
 	u32 start_index;
 	u32 ctl_val;
 
+	/* This owner supplies voltage arbitration, not L2 low-power sequences. */
+	if (drv->reg_data->pmic_arbiter_master) {
+		dev_warn_ratelimited(drv->dev, "L2 master has no low-power sequence\n");
+		return;
+	}
 	start_index = drv->reg_data->start_index[mode];
 
 	ctl_val = spm_register_read(drv, SPM_REG_SPM_CTL);
@@ -479,6 +493,8 @@ static const struct of_device_id spm_match_table[] = {
 	  .data = &spm_reg_660_gold_l2 },
 	{ .compatible = "qcom,sdm660-silver-saw2-v4.1-l2",
 	  .data = &spm_reg_660_silver_l2 },
+	{ .compatible = "qcom,msm8226-saw2-v2.1-l2",
+	  .data = &spm_reg_8226_l2 },
 	{ .compatible = "qcom,msm8226-saw2-v2.1-cpu",
 	  .data = &spm_reg_8226_cpu },
 	{ .compatible = "qcom,msm8909-saw2-v3.0-cpu",
@@ -505,6 +521,77 @@ static const struct of_device_id spm_match_table[] = {
 };
 MODULE_DEVICE_TABLE(of, spm_match_table);
 
+static const struct regmap_range spm_8226_l2_read_ranges[] = {
+	regmap_reg_range(0x04, 0x08),
+	regmap_reg_range(0x14, 0x14),
+	regmap_reg_range(0x1c, 0x20),
+	regmap_reg_range(0x30, 0x34),
+	regmap_reg_range(0x40, 0x44),
+	regmap_reg_range(0xfd0, 0xfd0),
+};
+
+static const struct regmap_range spm_8226_l2_write_ranges[] = {
+	regmap_reg_range(0x08, 0x08),
+	regmap_reg_range(0x18, 0x1c),
+	regmap_reg_range(0x34, 0x34),
+	regmap_reg_range(0x40, 0x44),
+};
+
+static const struct regmap_access_table spm_8226_l2_read_table = {
+	.yes_ranges = spm_8226_l2_read_ranges,
+	.n_yes_ranges = ARRAY_SIZE(spm_8226_l2_read_ranges),
+};
+
+static const struct regmap_access_table spm_8226_l2_write_table = {
+	.yes_ranges = spm_8226_l2_write_ranges,
+	.n_yes_ranges = ARRAY_SIZE(spm_8226_l2_write_ranges),
+};
+
+static const struct regmap_config spm_8226_l2_regmap_config = {
+	.name = "l2-master",
+	.reg_bits = 32,
+	.val_bits = 32,
+	.reg_stride = 4,
+	.max_register = 0xffc,
+	.fast_io = true,
+	.rd_table = &spm_8226_l2_read_table,
+	.wr_table = &spm_8226_l2_write_table,
+};
+
+static int spm_8226_l2_register(struct platform_device *pdev,
+				struct spm_driver_data *drv)
+{
+	struct device *dev = &pdev->dev;
+	struct resource *resource;
+	struct regmap *map;
+	int ret;
+
+	if (!of_property_read_bool(dev->of_node, "qcom,pmic-arbiter-master"))
+		return -ENODEV;
+	/* The syscon registry has no unregister operation: this owner persists. */
+	if (IS_MODULE(CONFIG_QCOM_SPM))
+		return -EOPNOTSUPP;
+	resource = platform_get_resource(pdev, IORESOURCE_MEM, 0);
+	if (!resource || resource_size(resource) < 0x1000)
+		return -EINVAL;
+	/* A generic syscon could expose the map before setup has completed. */
+	if (of_device_is_compatible(dev->of_node, "syscon"))
+		return -EINVAL;
+	map = syscon_node_to_regmap(dev->of_node);
+	if (!IS_ERR(map))
+		return -EEXIST;
+	if (PTR_ERR(map) != -EINVAL)
+		return PTR_ERR(map);
+	map = devm_regmap_init_mmio(dev, drv->reg_base, &spm_8226_l2_regmap_config);
+	if (IS_ERR(map))
+		return PTR_ERR(map);
+	ret = spm_8226_l2_master_init(map);
+	if (ret)
+		return dev_err_probe(dev, ret, "could not initialize L2 master\n");
+	/* Nothing fallible may follow publication of this permanent mapping. */
+	return of_syscon_register_regmap(dev->of_node, map);
+}
+
 static int spm_dev_probe(struct platform_device *pdev)
 {
 	const struct of_device_id *match_id;
@@ -527,6 +614,9 @@ static int spm_dev_probe(struct platform_device *pdev)
 	drv->dev = &pdev->dev;
 	platform_set_drvdata(pdev, drv);
 
+	if (drv->reg_data->pmic_arbiter_master)
+		return spm_8226_l2_register(pdev, drv);
+
 	/* Write the SPM sequences first.. */
 	addr = drv->reg_base + drv->reg_data->reg_offset[SPM_REG_SEQ_ENTRY];
 	__iowrite32_copy(addr, drv->reg_data->seq,
@@ -562,6 +652,8 @@ static struct platform_driver spm_driver = {
 	.probe = spm_dev_probe,
 	.driver = {
 		.name = "qcom_spm",
+		/* CPU users and the syscon registry retain controller references. */
+		.suppress_bind_attrs = true,
 		.of_match_table = spm_match_table,
 	},
 };
