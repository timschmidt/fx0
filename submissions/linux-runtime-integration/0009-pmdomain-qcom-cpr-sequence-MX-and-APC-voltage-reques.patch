From 86969789ab8decafd97681edb240dd214487bafe Mon Sep 17 00:00:00 2001
From: Timothy Schmidt <timschmidt@gmail.com>
Date: Sun, 8 Nov 2026 16:33:09 +0000
Subject: [PATCH 09/35] pmdomain: qcom: cpr: sequence MX and APC voltage
 requests

Establish an MX floor covering the actual boot APC target before changing APC. Order upward and downward voltage requests so neither rail transition violates the shared requirement.

Source-patch: patches/linux-integration/fx0-cpr-mx-voltage-sequencing.diff
Source-sha256: f5bdd80531d944f84c41eaabd7c381c988a9b6ae233956327d542a6f4c05a119
---
 drivers/pmdomain/qcom/cpr-voltage.h | 86 +++++++++++++++++++++++++++++
 drivers/pmdomain/qcom/cpr.c         | 31 +++++++----
 2 files changed, 105 insertions(+), 12 deletions(-)
 create mode 100644 drivers/pmdomain/qcom/cpr-voltage.h

diff --git a/drivers/pmdomain/qcom/cpr-voltage.h b/drivers/pmdomain/qcom/cpr-voltage.h
new file mode 100644
index 000000000000..6c4354d90e24
--- /dev/null
+++ b/drivers/pmdomain/qcom/cpr-voltage.h
@@ -0,0 +1,86 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef __QCOM_CPR_VOLTAGE_H__
+#define __QCOM_CPR_VOLTAGE_H__
+
+#include <linux/errno.h>
+#include <linux/regulator/consumer.h>
+
+/* The caller owns regulator activation, handoff and locking. */
+struct cpr_voltage {
+	struct regulator *apc;
+	struct regulator *mx;
+	int mx_max_uV;
+	int mx_min_uV;
+	int mx_lower_error;
+};
+
+static inline int cpr_voltage_vote_mx(struct cpr_voltage *rails, int min_uV)
+{
+	int ret;
+
+	if (!rails->mx || min_uV <= 0 || min_uV > rails->mx_max_uV)
+		return -EINVAL;
+
+	ret = regulator_set_voltage(rails->mx, min_uV, rails->mx_max_uV);
+	if (!ret)
+		rails->mx_min_uV = min_uV;
+
+	return ret;
+}
+
+/*
+ * Establish a floor covering every possible boot corner before any APC
+ * transition. Repeating handoff must not lower an existing MX vote.
+ */
+static inline int cpr_voltage_bootstrap(struct cpr_voltage *rails, int boot_min_uV)
+{
+	if (!rails->mx)
+		return 0;
+	if (boot_min_uV <= 0 || boot_min_uV > rails->mx_max_uV ||
+	    rails->mx_min_uV < 0 || rails->mx_min_uV > rails->mx_max_uV)
+		return -EINVAL;
+	if (rails->mx_min_uV >= boot_min_uV)
+		return 0;
+
+	return cpr_voltage_vote_mx(rails, boot_min_uV);
+}
+
+static inline int cpr_voltage_set(struct cpr_voltage *rails, int apc_uV,
+				 int mx_min_uV)
+{
+	int ret;
+
+	rails->mx_lower_error = 0;
+	if (!rails->apc || apc_uV <= 0)
+		return -EINVAL;
+	if (!rails->mx)
+		return regulator_set_voltage(rails->apc, apc_uV, apc_uV);
+
+	/* Never infer an initial vote from a rounded-down boot clock corner. */
+	if (rails->mx_min_uV <= 0 || rails->mx_min_uV > rails->mx_max_uV ||
+	    mx_min_uV <= 0 || mx_min_uV > rails->mx_max_uV ||
+	    apc_uV > mx_min_uV)
+		return -EINVAL;
+
+	if (mx_min_uV > rails->mx_min_uV) {
+		ret = cpr_voltage_vote_mx(rails, mx_min_uV);
+		if (ret)
+			return ret;
+	}
+
+	ret = regulator_set_voltage(rails->apc, apc_uV, apc_uV);
+	if (ret)
+		/* Keep any raised MX vote: dropping it on an APC error is unsafe. */
+		return ret;
+
+	if (mx_min_uV < rails->mx_min_uV) {
+		ret = cpr_voltage_vote_mx(rails, mx_min_uV);
+		if (ret)
+			/* APC succeeded; keep MX high without provoking OPP rollback. */
+			rails->mx_lower_error = ret;
+	}
+
+	return 0;
+}
+
+#endif
