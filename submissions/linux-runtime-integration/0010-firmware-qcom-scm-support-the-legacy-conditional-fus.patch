From 789d5197844d5268197a17a94605316eedae9fdb Mon Sep 17 00:00:00 2001
From: Timothy Schmidt <timschmidt@gmail.com>
Date: Sun, 8 Nov 2026 16:33:09 +0000
Subject: [PATCH 10/35] firmware: qcom: scm: support the legacy conditional
 fuse read

Add the legacy secure-monitor operation required for conditional MSM8926 calibration. Propagate failures instead of selecting a voltage rule from an unsuccessful read.

Source-patch: patches/linux-integration/fx0-scm-legacy-fuse-read.diff
Source-sha256: a5d6a54661c3755d38112fe97aa84bbc10742b591fd782257e3cf11680474ac4
---
 drivers/firmware/qcom/qcom_scm.c       | 42 ++++++++++++++++++++++++++
 drivers/firmware/qcom/qcom_scm.h       |  3 ++
 include/linux/firmware/qcom/qcom_scm.h |  1 +
 3 files changed, 46 insertions(+)

diff --git a/drivers/firmware/qcom/qcom_scm.c b/drivers/firmware/qcom/qcom_scm.c
index 226265b311fe..5f2d09046817 100644
--- a/drivers/firmware/qcom/qcom_scm.c
+++ b/drivers/firmware/qcom/qcom_scm.c
@@ -883,6 +883,48 @@ static const struct reset_control_ops qcom_scm_pas_reset_ops = {
 	.deassert = qcom_scm_pas_reset_deassert,
 };
 
+/**
+ * qcom_scm_legacy_fuse_read() - Read a fuse row using the legacy firmware ABI
+ * @address: Eight-byte-aligned physical address of the fuse row.
+ * @value: Receives the row; unchanged on error.
+ *
+ * MSM8226/MSM8926 CPR calibration uses a two-word request (physical address,
+ * address type zero) and a three-word reply (low data, high data, status).
+ * Do not apply that response layout to the newer SMCCC conventions. Callers
+ * must use a sleepable context.
+ *
+ * Return: 0 on success, or a negative error code.
+ */
+int qcom_scm_legacy_fuse_read(u32 address, u64 *value)
+{
+	const struct qcom_scm_desc desc = {
+		.svc = QCOM_SCM_SVC_FUSE,
+		.cmd = QCOM_SCM_FUSE_READ_LEGACY,
+		.arginfo = QCOM_SCM_ARGS(2),
+		.args = { address, 0 },
+		.owner = ARM_SMCCC_OWNER_SIP,
+	};
+	struct qcom_scm_res res = {};
+	int ret;
+
+	if (!value || (address & 7))
+		return -EINVAL;
+	if (!qcom_scm_is_available())
+		return -EPROBE_DEFER;
+	if (__get_convention() != SMC_CONVENTION_LEGACY)
+		return -EOPNOTSUPP;
+
+	ret = qcom_scm_call(__scm->dev, &desc, &res);
+	if (ret)
+		return ret < 0 ? ret : -EIO;
+	if (res.result[2])
+		return -EIO;
+
+	*value = ((u64)(u32)res.result[1] << 32) | (u32)res.result[0];
+	return 0;
+}
+EXPORT_SYMBOL_GPL(qcom_scm_legacy_fuse_read);
+
 int qcom_scm_io_readl(phys_addr_t addr, unsigned int *val)
 {
 	struct qcom_scm_desc desc = {
diff --git a/drivers/firmware/qcom/qcom_scm.h b/drivers/firmware/qcom/qcom_scm.h
index 2111188f9fad..caf03d659b5b 100644
--- a/drivers/firmware/qcom/qcom_scm.h
+++ b/drivers/firmware/qcom/qcom_scm.h
@@ -110,6 +110,9 @@ int qcom_scm_shm_bridge_enable(struct device *scm_dev);
 #define QCOM_SCM_IO_READ		0x01
 #define QCOM_SCM_IO_WRITE		0x02
 
+#define QCOM_SCM_SVC_FUSE		0x08
+#define QCOM_SCM_FUSE_READ_LEGACY		0x07
+
 #define QCOM_SCM_SVC_INFO		0x06
 #define QCOM_SCM_INFO_IS_CALL_AVAIL	0x01
 
diff --git a/include/linux/firmware/qcom/qcom_scm.h b/include/linux/firmware/qcom/qcom_scm.h
index 5045f8fe876d..2bf19b409622 100644
--- a/include/linux/firmware/qcom/qcom_scm.h
+++ b/include/linux/firmware/qcom/qcom_scm.h
@@ -60,6 +60,7 @@ enum qcom_scm_ice_cipher {
 #define QCOM_SCM_PERM_RWX (QCOM_SCM_PERM_RW | QCOM_SCM_PERM_EXEC)
 
 bool qcom_scm_is_available(void);
+int qcom_scm_legacy_fuse_read(u32 address, u64 *value);
 
 int qcom_scm_set_cold_boot_addr(void *entry);
 int qcom_scm_set_warm_boot_addr(void *entry);
