From 272f4eb2214b420167edced50abd07cfa132a75c Mon Sep 17 00:00:00 2001
From: Timothy Schmidt <timschmidt@gmail.com>
Date: Thu, 29 Oct 2026 07:02:23 -0400
Subject: [PATCH] dt-bindings: display: panel: Add LG Fx0 production panel

Describe the four-lane JDI in-cell panel used by production LG Fx0
boards. The panel has separate IO-switch and positive/negative bias
enables, a 3.1 V main supply, a PMIC backlight and a DSI graph endpoint.
Include an example using the production board's GPIO assignments.

Adapt Timothy Schmidt's original local proposal
dc2430e91f814477ccfaf22077a468235b30b096 to drm-misc-next at
39e407b553ec15d4a233b651531ad431ed7542be. Original authorship and date
are retained. Codex (GPT-6) assisted with the example and qualification.

The normal binding example and the complete unchanged Fx0 DTB pass the
selected panel schema. This does not qualify the full board or hardware.
Human review and DCO certification remain pending.
---
 .../bindings/display/panel/lg,fx0-panel.yaml  | 86 +++++++++++++++++++
 MAINTAINERS                                   |  6 ++
 2 files changed, 92 insertions(+)
 create mode 100644 Documentation/devicetree/bindings/display/panel/lg,fx0-panel.yaml

diff --git a/Documentation/devicetree/bindings/display/panel/lg,fx0-panel.yaml b/Documentation/devicetree/bindings/display/panel/lg,fx0-panel.yaml
new file mode 100644
index 000000000000..1e1b9ee64176
--- /dev/null
+++ b/Documentation/devicetree/bindings/display/panel/lg,fx0-panel.yaml
@@ -0,0 +1,86 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/display/panel/lg,fx0-panel.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: LG Fx0 JDI 720x1280 in-cell panel
+
+maintainers:
+  - Timothy Schmidt <timschmidt@gmail.com>
+
+description:
+  Four-lane RGB888 DSI video-mode JDI panel used by production LG Fx0
+  handsets. The IO switch and the positive and negative display bias
+  enables are individually controlled, in that order, before reset.
+
+allOf:
+  - $ref: panel-common.yaml#
+
+properties:
+  compatible:
+    const: lg,fx0-panel
+
+  reg:
+    maxItems: 1
+
+  vdd-supply:
+    description: Main 3.1 V analogue supply.
+
+  reset-gpios:
+    maxItems: 1
+
+  io-enable-gpios:
+    maxItems: 1
+    description: Active-high enable for the panel IO supply switch.
+
+  positive-enable-gpios:
+    maxItems: 1
+    description: Active-high enable for the positive display bias.
+
+  negative-enable-gpios:
+    maxItems: 1
+    description: Active-high enable for the negative display bias.
+
+  backlight: true
+  port: true
+
+required:
+  - compatible
+  - reg
+  - vdd-supply
+  - reset-gpios
+  - io-enable-gpios
+  - positive-enable-gpios
+  - negative-enable-gpios
+  - backlight
+  - port
+
+additionalProperties: false
+
+examples:
+  - |
+    #include <dt-bindings/gpio/gpio.h>
+
+    dsi {
+        #address-cells = <1>;
+        #size-cells = <0>;
+
+        panel@0 {
+            compatible = "lg,fx0-panel";
+            reg = <0>;
+
+            vdd-supply = <&pm8226_l28>;
+            reset-gpios = <&tlmm 25 GPIO_ACTIVE_LOW>;
+            io-enable-gpios = <&tlmm 113 GPIO_ACTIVE_HIGH>;
+            positive-enable-gpios = <&tlmm 111 GPIO_ACTIVE_HIGH>;
+            negative-enable-gpios = <&tlmm 112 GPIO_ACTIVE_HIGH>;
+            backlight = <&pm8226_wled>;
+
+            port {
+                endpoint {
+                    remote-endpoint = <&mdss_dsi0_out>;
+                };
+            };
+        };
+    };
