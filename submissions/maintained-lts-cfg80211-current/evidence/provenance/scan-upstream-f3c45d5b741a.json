      "patch": "@@ -2453,6 +2453,7 @@ cfg80211_inform_single_bss_data(struct wiphy *wiphy,\n \t\tif (cfg80211_add_nontrans_list(data->source_bss, &res->pub)) {\n \t\t\tif (__cfg80211_unlink_bss(rdev, res)) {\n \t\t\t\trdev->bss_generation++;\n+\t\t\t\tbss_ref_put(rdev, res);\n \t\t\t\tres = NULL;\n \t\t\t}\n \t\t}"
