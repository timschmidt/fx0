From 33ea1245630b02f6110fadc5bf9567ebcee4ddf5 Mon Sep 17 00:00:00 2001
From: Timothy Schmidt <timschmidt@gmail.com>
Date: Sat, 31 Oct 2026 03:56:19 -0400
Subject: [PATCH] phy: qcom-usb-hs: consolidate counted initialization storage

Keep the maintained LTS driver's existing offset-zero handling and
odd-length rejection. Replace its separate initialization-sequence
allocation with the reviewed counted flexible array, rejecting
incomplete pairs before allocation. The MSM8226, MSM8916 and MSM8939
tuning bytes remain unchanged.

Reconcile Timothy Schmidt's reviewed current-tree change rather than
claiming that the LTS baseline still uses the old zero-address sentinel.
The original draft used Claude Opus 5.5; Codex assisted the refresh and
this LTS qualification. The candidate model passes 782 cases and 47691
checks with address, undefined-behavior and leak sanitizers. The LTS
baseline also passes, including its additional separate-allocation OOM
case. Three independent sequence/count regressions fail.

Native PHY, ULPI and dependent IIO objects compile in three supported
profiles. Resources, bus operations and rollback are modeled. Physical
USB, electrical tuning and other-SoC acceptance remain open. Human DCO
and final integration review remain pending.

Backported from commit 76a08c219e84 ("phy: qcom-usb-hs: apply
initialization sequences starting at offset zero")
---
 drivers/phy/qualcomm/phy-qcom-usb-hs.c | 27 +++++++++++++-------------
 1 file changed, 13 insertions(+), 14 deletions(-)

diff --git a/drivers/phy/qualcomm/phy-qcom-usb-hs.c b/drivers/phy/qualcomm/phy-qcom-usb-hs.c
index 9fb7b5b5e68c6..778641d35e736 100644
--- a/drivers/phy/qualcomm/phy-qcom-usb-hs.c
+++ b/drivers/phy/qualcomm/phy-qcom-usb-hs.c
@@ -34,10 +34,10 @@ struct qcom_usb_hs_phy {
 	struct regulator *v1p8;
 	struct regulator *v3p3;
 	struct reset_control *reset;
-	struct ulpi_seq *init_seq;
-	unsigned int num_init_seq;
 	struct extcon_dev *vbus_edev;
 	struct notifier_block vbus_notify;
+	unsigned int num_init_seq;
+	struct ulpi_seq init_seq[] __counted_by(num_init_seq);
 };
 
 static int qcom_usb_hs_phy_set_mode(struct phy *phy,
@@ -111,8 +111,8 @@ static int qcom_usb_hs_phy_power_on(struct phy *phy)
 	struct qcom_usb_hs_phy *uphy = phy_get_drvdata(phy);
 	struct ulpi *ulpi = uphy->ulpi;
 	const struct ulpi_seq *seq;
-	int ret, state;
 	unsigned int i;
+	int ret, state;
 
 	ret = clk_prepare_enable(uphy->ref_clk);
 	if (ret)
@@ -212,22 +212,21 @@ static int qcom_usb_hs_phy_probe(struct ulpi *ulpi)
 	int size;
 	int ret;
 
-	uphy = devm_kzalloc(&ulpi->dev, sizeof(*uphy), GFP_KERNEL);
-	if (!uphy)
-		return -ENOMEM;
-	ulpi_set_drvdata(ulpi, uphy);
-	uphy->ulpi = ulpi;
-
 	size = of_property_count_u8_elems(ulpi->dev.of_node, "qcom,init-seq");
 	if (size < 0)
 		size = 0;
-	if (size % sizeof(*uphy->init_seq))
+	if (size % sizeof(struct ulpi_seq))
 		return -EINVAL;
-	uphy->num_init_seq = size / sizeof(*uphy->init_seq);
-	uphy->init_seq = devm_kmalloc_array(&ulpi->dev, uphy->num_init_seq,
-					   sizeof(*uphy->init_seq), GFP_KERNEL);
-	if (!uphy->init_seq)
+
+	uphy = devm_kzalloc(&ulpi->dev,
+			    struct_size(uphy, init_seq, size / sizeof(struct ulpi_seq)),
+			    GFP_KERNEL);
+	if (!uphy)
 		return -ENOMEM;
+	uphy->num_init_seq = size / sizeof(struct ulpi_seq);
+	ulpi_set_drvdata(ulpi, uphy);
+	uphy->ulpi = ulpi;
+
 	ret = of_property_read_u8_array(ulpi->dev.of_node, "qcom,init-seq",
 					(u8 *)uphy->init_seq, size);
 	if (ret && size)
-- 
2.56.0

