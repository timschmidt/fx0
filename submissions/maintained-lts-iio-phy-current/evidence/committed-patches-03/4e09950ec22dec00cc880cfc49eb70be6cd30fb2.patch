diff --git a/drivers/iio/imu/inv_mpu6050/inv_mpu_dmp.c b/drivers/iio/imu/inv_mpu6050/inv_mpu_dmp.c
index 5fab34cfee79c..3097de43f4825 100644
--- a/drivers/iio/imu/inv_mpu6050/inv_mpu_dmp.c
+++ b/drivers/iio/imu/inv_mpu6050/inv_mpu_dmp.c
@@ -28,7 +28,7 @@
  * cursor. The memory port itself must not increment the register address.
  */
 static int inv_mpu6515_dmp_mem_transfer(struct inv_mpu6050_state *st,
-				      unsigned int address, u8 *data,
+					unsigned int address, u8 *data,
 				      size_t len, bool write)
 {
 	unsigned int ctrl;
@@ -72,14 +72,14 @@ static int inv_mpu6515_dmp_mem_transfer(struct inv_mpu6050_state *st,
 }
 
 int inv_mpu6515_dmp_mem_read(struct inv_mpu6050_state *st,
-			   unsigned int address, u8 *data, size_t len)
+			     unsigned int address, u8 *data, size_t len)
 {
 	return inv_mpu6515_dmp_mem_transfer(st, address, data, len, false);
 }
 
 /* A failed write/verify leaves execution disabled; caller must invalidate FW. */
 int inv_mpu6515_dmp_mem_write(struct inv_mpu6050_state *st,
-			    unsigned int address, const u8 *data, size_t len)
+			      unsigned int address, const u8 *data, size_t len)
 {
 	u8 verify[INV_DMP_CHUNK];
 	size_t chunk, offset = 0;
@@ -92,7 +92,7 @@ int inv_mpu6515_dmp_mem_write(struct inv_mpu6050_state *st,
 	while (offset < len) {
 		chunk = min_t(size_t, len - offset, sizeof(verify));
 		ret = inv_mpu6515_dmp_mem_transfer(st, address + offset,
-						(u8 *)data + offset, chunk, true);
+						   (u8 *)data + offset, chunk, true);
 		if (ret)
 			return ret;
 		ret = inv_mpu6515_dmp_mem_read(st, address + offset, verify, chunk);
@@ -209,7 +209,7 @@ int inv_mpu6515_dmp_configure(struct inv_mpu6050_state *st)
 	lockdep_assert_held(&st->lock);
 	for (i = 0; i < ARRAY_SIZE(patches); i++) {
 		ret = inv_mpu6515_dmp_mem_write(st, patches[i].address,
-					      patches[i].data, patches[i].length);
+						patches[i].data, patches[i].length);
 		if (ret)
 			return ret;
 	}
@@ -283,7 +283,7 @@ static int inv_mpu6515_dmp_configure_smd(struct inv_mpu6050_state *st)
 
 	for (i = 0; i < ARRAY_SIZE(patches); i++) {
 		ret = inv_mpu6515_dmp_mem_write(st, patches[i].address,
-					      patches[i].data, patches[i].length);
+						patches[i].data, patches[i].length);
 		if (ret)
 			return ret;
 	}
@@ -457,8 +457,8 @@ int inv_mpu6515_dmp_read_fifo(struct iio_dev *indio_dev, s64 timestamp)
 {
 	struct inv_mpu6050_state *st = iio_priv(indio_dev);
 	struct inv_mpu6515_dmp_packet packet;
-	/* Repeated quaternion storage aligns the complete timestamped scan to 16. */
-	struct { s32 q[4]; s64 padding; s64 timestamp; } sample __aligned(16) = { };
+	/* The core computes the timestamp offset and the final scan padding. */
+	struct { s32 q[4]; u8 padding[16]; } sample __aligned(16) = { };
 	unsigned int hi, lo, check, tries, count, quats = 0;
 	size_t len, offset;
 	u64 norm;
diff --git a/drivers/iio/test/iio-test-format.c b/drivers/iio/test/iio-test-format.c
index 3abf39e74f9cf..5012f33be5da2 100644
--- a/drivers/iio/test/iio-test-format.c
+++ b/drivers/iio/test/iio-test-format.c
@@ -181,26 +181,38 @@ static void iio_test_iio_format_value_fractional_log2(struct kunit *test)
 	values[1] = 10;
 	ret = iio_format_value(buf, IIO_VAL_FRACTIONAL_LOG2, ARRAY_SIZE(values), values);
 	IIO_TEST_FORMAT_EXPECT_EQ(test, buf, ret, "0.000000000\n");
+}
 
-	/* Q30 quaternion scale must not be rounded to zero. */
-	values[0] = 1;
-	values[1] = 30;
-	ret = iio_format_value(buf, IIO_VAL_FRACTIONAL_LOG2, ARRAY_SIZE(values), values);
-	IIO_TEST_FORMAT_EXPECT_EQ(test, buf, ret, "0.000000000931322574615478515625\n");
-	values[0] = -1;
-	ret = iio_format_value(buf, IIO_VAL_FRACTIONAL_LOG2, ARRAY_SIZE(values), values);
-	IIO_TEST_FORMAT_EXPECT_EQ(test, buf, ret, "-0.000000000931322574615478515625\n");
+static void iio_test_iio_format_value_tiny_fractional_log2(struct kunit *test)
+{
+	static const struct {
+		int numerator;
+		int shift;
+		const char *expected;
+	} cases[] = {
+		{ 1, 30, "0.000000000931322574615478515625\n" },
+		{ -1, 30, "-0.000000000931322574615478515625\n" },
+		{ 1, 63,
+		  "0.000000000000000000108420217248550443400745280086994171142578125\n" },
+		{ INT_MIN, 63, "-0.00000000023283064365386962890625\n" },
+		{ INT_MAX, 63,
+		  "0.000000000232830643545449411657699556599254719913005828857421875\n" },
+		{ 0, 63, "0.000000000\n" },
+	};
+	char *buf;
+	unsigned int i;
+	int ret;
 
-	/* Maximum supported shift and signed numerator boundary. */
-	values[0] = 1;
-	values[1] = 63;
-	ret = iio_format_value(buf, IIO_VAL_FRACTIONAL_LOG2, ARRAY_SIZE(values), values);
-	IIO_TEST_FORMAT_EXPECT_EQ(test, buf, ret,
-		"0.000000000000000000108420217248550443400745280086994171142578125\n");
-	values[0] = INT_MIN;
-	ret = iio_format_value(buf, IIO_VAL_FRACTIONAL_LOG2, ARRAY_SIZE(values), values);
-	IIO_TEST_FORMAT_EXPECT_EQ(test, buf, ret, "-0.00000000023283064365386962890625\n");
+	buf = kunit_kmalloc(test, PAGE_SIZE, GFP_KERNEL);
+	KUNIT_ASSERT_NOT_ERR_OR_NULL(test, buf);
+
+	for (i = 0; i < ARRAY_SIZE(cases); i++) {
+		int values[] = { cases[i].numerator, cases[i].shift };
 
+		ret = iio_format_value(buf, IIO_VAL_FRACTIONAL_LOG2,
+				       ARRAY_SIZE(values), values);
+		IIO_TEST_FORMAT_EXPECT_EQ(test, buf, ret, cases[i].expected);
+	}
 }
 
 static void iio_test_iio_format_value_multiple(struct kunit *test)
@@ -275,6 +287,7 @@ static struct kunit_case iio_format_test_cases[] = {
 		KUNIT_CASE(iio_test_iio_format_value_fixedpoint),
 		KUNIT_CASE(iio_test_iio_format_value_fractional),
 		KUNIT_CASE(iio_test_iio_format_value_fractional_log2),
+		KUNIT_CASE(iio_test_iio_format_value_tiny_fractional_log2),
 		KUNIT_CASE(iio_test_iio_format_value_multiple),
 		KUNIT_CASE(iio_test_iio_format_value_integer_64),
 		{ }
