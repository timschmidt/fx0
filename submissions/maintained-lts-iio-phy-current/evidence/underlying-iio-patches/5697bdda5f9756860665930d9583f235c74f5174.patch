    iio: core: Preserve tiny nonzero fractional log2 scales
    
    The nine-place formatter reports 1/2^30 as zero. Generate exact decimal
    digits when an otherwise nonzero scale truncates below that precision.
    Leave ordinary scales unchanged. Cover signed limits, shifts 30 and 63,
    and zero in the real iio-format KUnit suite.
    
    The unmodified formatter passes seven tests and fails the added test;
    the candidate passes all eight. Inherited UML build diagnostics are
    recorded separately. Native Qualcomm ARM and ARM64 builds are clean.
    
    Fixes: 103d9fb90705 ("iio: Add a logarithmic fractional value type")
    
    Ported from Fx0 commit 383c3b717e5d4d16a7fad5ef5da471b71b23b645.
    Port and qualification used OpenAI Codex assistance.

diff --git a/drivers/iio/industrialio-core.c b/drivers/iio/industrialio-core.c
index 825cf7f320..9c6948b185 100644
--- a/drivers/iio/industrialio-core.c
+++ b/drivers/iio/industrialio-core.c
@@ -732,6 +732,26 @@ int iio_read_mount_matrix(struct device *dev, struct iio_mount_matrix *matrix)
 }
 EXPORT_SYMBOL(iio_read_mount_matrix);
 
+/* Power-of-two fractions terminate after at most shift decimal places. */
+static ssize_t iio_format_tiny_log2(char *buf, size_t offset, int numerator,
+				    unsigned int shift)
+{
+	u64 remainder = numerator < 0 ? -(s64)numerator : numerator;
+	u64 divisor = BIT_ULL(shift);
+	char fraction[64];
+	unsigned int digit, count = 0;
+
+	while (remainder && count < shift) {
+		digit = mul_u64_u64_div_u64(remainder, 10, divisor);
+		/* Unsigned wrap cancels here; the resulting remainder is < divisor. */
+		remainder = remainder * 10 - digit * divisor;
+		fraction[count++] = '0' + digit;
+	}
+	fraction[count] = '\0';
+
+	return sysfs_emit_at(buf, offset, "%s0.%s", numerator < 0 ? "-" : "", fraction);
+}
+
 static ssize_t __iio_format_value(char *buf, size_t offset, unsigned int type,
 				  int size, const int *vals)
 {
@@ -771,6 +791,9 @@ static ssize_t __iio_format_value(char *buf, size_t offset, unsigned int type,
 					     abs(tmp1));
 	case IIO_VAL_FRACTIONAL_LOG2:
 		tmp2 = shift_right((s64)vals[0] * 1000000000LL, vals[1]);
+		/* Keep nonzero scales below the usual nine decimal places. */
+		if (!tmp2 && vals[0] && vals[1] > 0 && vals[1] < 64)
+			return iio_format_tiny_log2(buf, offset, vals[0], vals[1]);
 		tmp0 = (int)div_s64_rem(tmp2, 1000000000LL, &tmp1);
 		if (tmp0 == 0 && tmp2 < 0)
 			return sysfs_emit_at(buf, offset, "-0.%09u", abs(tmp1));
diff --git a/drivers/iio/test/iio-test-format.c b/drivers/iio/test/iio-test-format.c
index e5d0a2ac46..e42b900e5d 100644
--- a/drivers/iio/test/iio-test-format.c
+++ b/drivers/iio/test/iio-test-format.c
@@ -183,6 +183,38 @@ static void iio_test_iio_format_value_fractional_log2(struct kunit *test)
 	IIO_TEST_FORMAT_EXPECT_EQ(test, buf, ret, "0.000000000\n");
 }
 
+static void iio_test_iio_format_value_tiny_fractional_log2(struct kunit *test)
+{
+	static const struct {
+		int numerator;
+		int shift;
+		const char *expected;
+	} cases[] = {
+		{ 1, 30, "0.000000000931322574615478515625\n" },
+		{ -1, 30, "-0.000000000931322574615478515625\n" },
+		{ 1, 63,
+		  "0.000000000000000000108420217248550443400745280086994171142578125\n" },
+		{ INT_MIN, 63, "-0.00000000023283064365386962890625\n" },
+		{ INT_MAX, 63,
+		  "0.000000000232830643545449411657699556599254719913005828857421875\n" },
+		{ 0, 63, "0.000000000\n" },
+	};
+	char *buf;
+	unsigned int i;
+	int ret;
+
+	buf = kunit_kmalloc(test, PAGE_SIZE, GFP_KERNEL);
+	KUNIT_ASSERT_NOT_ERR_OR_NULL(test, buf);
+
+	for (i = 0; i < ARRAY_SIZE(cases); i++) {
+		int values[] = { cases[i].numerator, cases[i].shift };
+
+		ret = iio_format_value(buf, IIO_VAL_FRACTIONAL_LOG2,
+				       ARRAY_SIZE(values), values);
+		IIO_TEST_FORMAT_EXPECT_EQ(test, buf, ret, cases[i].expected);
+	}
+}
+
 static void iio_test_iio_format_value_multiple(struct kunit *test)
 {
 	int values[] = {1, -2, 3, -4, 5};
@@ -307,6 +339,7 @@ static struct kunit_case iio_format_test_cases[] = {
 		KUNIT_CASE(iio_test_iio_format_value_fixedpoint),
 		KUNIT_CASE(iio_test_iio_format_value_fractional),
 		KUNIT_CASE(iio_test_iio_format_value_fractional_log2),
+		KUNIT_CASE(iio_test_iio_format_value_tiny_fractional_log2),
 		KUNIT_CASE(iio_test_iio_format_value_multiple),
 		KUNIT_CASE(iio_test_iio_format_value_integer_64),
 		KUNIT_CASE(iio_test_iio_format_value_decimal_64),
