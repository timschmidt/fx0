From 8616767b2b9e01846b1a61af2055ab7965a2f245 Mon Sep 17 00:00:00 2001
From: Timothy Schmidt <timschmidt@gmail.com>
Date: Sun, 8 Nov 2026 18:15:17 -0500
Subject: [PATCH 2/2] nfc: nxp-nci: balance an optional reference clock across
 modes

Acquire an optional reference clock at probe and propagate provider errors
before claiming the GPIOs or registering NCI state. Enable it before
raising the controller enable pin and release it after entering cold mode.
Track the clock vote across repeated NCI and firmware mode transitions.

Return a failed mode transition from the NCI open callback before changing
the software mode. A failed clock enable then leaves the device cold and
allows a later open to retry. Keep boards without the optional clock valid.

Assisted-by: LLM
---
 drivers/nfc/nxp-nci/core.c |  5 ++++-
 drivers/nfc/nxp-nci/i2c.c  | 23 ++++++++++++++++++++++-
 2 files changed, 26 insertions(+), 2 deletions(-)

diff --git a/drivers/nfc/nxp-nci/core.c b/drivers/nfc/nxp-nci/core.c
index 448e5a4e7338..20ae5b3a6f68 100644
--- a/drivers/nfc/nxp-nci/core.c
+++ b/drivers/nfc/nxp-nci/core.c
@@ -43,8 +43,11 @@ static int nxp_nci_open(struct nci_dev *ndev)
 		goto open_exit;
 	}
 
-	if (info->phy_ops->set_mode)
+	if (info->phy_ops->set_mode) {
 		r = info->phy_ops->set_mode(info->phy_id, NXP_NCI_MODE_NCI);
+		if (r)
+			goto open_exit;
+	}
 
 	info->mode = NXP_NCI_MODE_NCI;
 
diff --git a/drivers/nfc/nxp-nci/i2c.c b/drivers/nfc/nxp-nci/i2c.c
index 92ce096e9b18..62b8aa52569a 100644
--- a/drivers/nfc/nxp-nci/i2c.c
+++ b/drivers/nfc/nxp-nci/i2c.c
@@ -13,6 +13,7 @@
  */
 
 #include <linux/acpi.h>
+#include <linux/clk.h>
 #include <linux/delay.h>
 #include <linux/i2c.h>
 #include <linux/interrupt.h>
@@ -36,6 +37,8 @@ struct nxp_nci_i2c_phy {
 
 	struct gpio_desc *gpiod_en;
 	struct gpio_desc *gpiod_fw;
+	struct clk *ref_clk;
+	bool ref_clk_enabled;
 
 	int hard_fault; /*
 			 * < 0 if hardware error occurred (e.g. i2c err)
@@ -47,13 +50,26 @@ static int nxp_nci_i2c_set_mode(void *phy_id,
 				    enum nxp_nci_mode mode)
 {
 	struct nxp_nci_i2c_phy *phy = (struct nxp_nci_i2c_phy *) phy_id;
+	int r;
+
+	if (mode != NXP_NCI_MODE_COLD && !phy->ref_clk_enabled) {
+		r = clk_prepare_enable(phy->ref_clk);
+		if (r)
+			return r;
+		phy->ref_clk_enabled = true;
+	}
 
 	gpiod_set_value_cansleep(phy->gpiod_fw, (mode == NXP_NCI_MODE_FW) ? 1 : 0);
 	gpiod_set_value_cansleep(phy->gpiod_en, (mode != NXP_NCI_MODE_COLD) ? 1 : 0);
 	usleep_range(10000, 15000);
 
-	if (mode == NXP_NCI_MODE_COLD)
+	if (mode == NXP_NCI_MODE_COLD) {
+		if (phy->ref_clk_enabled) {
+			clk_disable_unprepare(phy->ref_clk);
+			phy->ref_clk_enabled = false;
+		}
 		phy->hard_fault = 0;
+	}
 
 	return 0;
 }
@@ -292,6 +308,11 @@ static int nxp_nci_i2c_probe(struct i2c_client *client)
 	phy->i2c_dev = client;
 	i2c_set_clientdata(client, phy);
 
+	phy->ref_clk = devm_clk_get_optional(dev, "ref");
+	if (IS_ERR(phy->ref_clk))
+		return dev_err_probe(dev, PTR_ERR(phy->ref_clk),
+				     "Failed to get reference clock\n");
+
 	r = devm_acpi_dev_add_driver_gpios(dev, acpi_nxp_nci_gpios);
 	if (r)
 		dev_dbg(dev, "Unable to add GPIO mapping table\n");
