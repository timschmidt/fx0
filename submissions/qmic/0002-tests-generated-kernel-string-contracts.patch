From 67f59de38399e580de7ec3e7fc36f14937f93b7d Mon Sep 17 00:00:00 2001
From: Timothy Schmidt <timschmidt@gmail.com>
Date: Sat, 14 Nov 2026 08:39:20 -0500
Subject: [PATCH] tests: check generated kernel string output with make check

Compare complete C and header output for the RMTFS interface and required, optional and nested strings. Run in an empty temporary directory, propagate compiler or comparison failures, and preserve the default build target. Keep these finite output contracts separate from codec and device qualification.
---
 Makefile                     |   5 +
 tests/README                 |  19 +++
 tests/check-generated.sh     |  26 ++++
 tests/expected-qmicstrings.c |  83 ++++++++++++
 tests/expected-qmicstrings.h |  34 +++++
 tests/expected-rmtfs.c       | 256 +++++++++++++++++++++++++++++++++++
 tests/expected-rmtfs.h       | 101 ++++++++++++++
 tests/qmicstrings.qmi        |  17 +++
 tests/rmtfs.qmi              |  77 +++++++++++
 9 files changed, 618 insertions(+)
 create mode 100644 tests/README
 create mode 100755 tests/check-generated.sh
 create mode 100644 tests/expected-qmicstrings.c
 create mode 100644 tests/expected-qmicstrings.h
 create mode 100644 tests/expected-rmtfs.c
 create mode 100644 tests/expected-rmtfs.h
 create mode 100644 tests/qmicstrings.qmi
 create mode 100644 tests/rmtfs.qmi

diff --git a/Makefile b/Makefile
index a3a81d7..a78ee9f 100644
--- a/Makefile
+++ b/Makefile
@@ -10,9 +10,14 @@ OBJS := $(SRCS:.c=.o)
 $(OUT): $(OBJS)
 	$(CC) $(LDFLAGS) -o $@ $^
 
+check: $(OUT)
+	sh tests/check-generated.sh "$(CURDIR)/$(OUT)"
+
 install: $(OUT)
 	install -D -m 755 $< $(DESTDIR)$(prefix)/bin/$<
 
 clean:
 	rm -f $(OUT) $(OBJS)
 
+.PHONY: check install clean
+
diff --git a/tests/README b/tests/README
new file mode 100644
index 0000000..ec61fe0
--- /dev/null
+++ b/tests/README
@@ -0,0 +1,19 @@
+Run `make check` after building qmic. The check uses the built executable and
+compares its kernel C/header output byte for byte with four fixed contracts.
+It uses an empty temporary directory and removes only that directory on exit.
+
+rmtfs.qmi is the RMTFS 1.3 interface from linux-msm/rmtfs at
+b30a3eb38f9af283f18dbd3c7755653efc52c094. Its expected header retains the
+256-byte wire maximum and includes storage for the C string terminator.
+Its generated descriptor C output remains identical to the original.
+
+qmicstrings.qmi checks required, optional and nested string descriptors,
+including optional validity members and the matching OPT_FLAG descriptor.
+The golden files pin the complete generated output, not selected substrings.
+
+These are finite generator output contracts. They do not exercise a device,
+transport or full codec, and do not establish that every supported descriptor
+or legacy nested-string wire length is handled correctly. Review fixture and
+golden changes together when intentionally changing the output format.
+
+The fixtures and generated contracts use the repository's BSD-3-Clause license.
diff --git a/tests/check-generated.sh b/tests/check-generated.sh
new file mode 100755
index 0000000..9b17e5b
--- /dev/null
+++ b/tests/check-generated.sh
@@ -0,0 +1,26 @@
+#!/bin/sh
+# SPDX-License-Identifier: BSD-3-Clause
+set -eu
+
+if [ "$#" -ne 1 ]; then
+	echo "usage: $0 /absolute/path/to/qmic" >&2
+	exit 2
+fi
+qmic=$1
+case "$qmic" in
+/*) ;;
+*) echo "qmic path must be absolute" >&2; exit 2 ;;
+esac
+fixtures=$(CDPATH= cd "$(dirname "$0")" && pwd)
+temporary=$(mktemp -d "${TMPDIR:-/tmp}/qmic-check.XXXXXX")
+trap 'rm -rf "$temporary"' 0
+trap 'exit 1' 1 2 15
+
+for fixture in rmtfs qmicstrings; do
+	(
+		cd "$temporary"
+		"$qmic" -k < "$fixtures/$fixture.qmi"
+		cmp "qmi_$fixture.c" "$fixtures/expected-$fixture.c"
+		cmp "qmi_$fixture.h" "$fixtures/expected-$fixture.h"
+	)
+done
