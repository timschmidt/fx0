From c94c9248174c7712e0c960a1bf5cf0afde7ceebb Mon Sep 17 00:00:00 2001
From: Timothy Schmidt <timschmidt@gmail.com>
Date: Wed, 11 Nov 2026 00:17:59 -0500
Subject: [PATCH] dt-bindings: nvmem: qcom,qfprom: Add MSM8926 raw read-only
 view

Describe the standalone raw calibration view used by MSM8926 CPU/PVS and
CPR consumers. It has one read-only register region, without the
corrected-provider fallback or programming clock and supply resources.
Keep the corrected provider independent and retain every current SoC
compatible entry and both existing examples.

Adapt the binding part of Timothy Schmidt's original local r50 overlay
5624c0158e00149c03f6d1ae53f96092015274bd to NVMEM for-next at
6628e7d4c6b25c8d18f1345e3a20d21829aae7e4. Preserve original author/date.
Codex (GPT-6) assisted with adaptation and qualification.

Normal binding examples pass, including the unchanged corrected-provider
examples. Full-board and hardware qualification remain open. Human DCO
certification remains pending.
---
 .../bindings/nvmem/qcom,qfprom.yaml           | 143 +++++++++++-------
 1 file changed, 88 insertions(+), 55 deletions(-)

diff --git a/Documentation/devicetree/bindings/nvmem/qcom,qfprom.yaml b/Documentation/devicetree/bindings/nvmem/qcom,qfprom.yaml
index 566304ed4c..bf3215940a 100644
--- a/Documentation/devicetree/bindings/nvmem/qcom,qfprom.yaml
+++ b/Documentation/devicetree/bindings/nvmem/qcom,qfprom.yaml
@@ -6,74 +6,94 @@ $schema: http://devicetree.org/meta-schemas/core.yaml#
 
 title: Qualcomm Technologies Inc, QFPROM Efuse
 
+description: |
+  Most consumers use corrected fuse data. MSM8926 CPU and CPR calibration
+  instead use a standalone raw view. That interface has one read-only region
+  and no programming resources; the corrected provider remains independent.
+
 maintainers:
   - Srinivas Kandagatla <srinivas.kandagatla@linaro.org>
 
 allOf:
   - $ref: nvmem.yaml#
   - $ref: nvmem-deprecated-cells.yaml#
+  - if:
+      properties:
+        compatible:
+          contains:
+            const: qcom,msm8926-qfprom-raw
+    then:
+      properties:
+        reg:
+          maxItems: 1
+        clocks: false
+        clock-names: false
+        vcc-supply: false
+      required:
+        - read-only
 
 properties:
   compatible:
-    items:
-      - enum:
-          - qcom,apq8064-qfprom
-          - qcom,apq8084-qfprom
-          - qcom,glymur-qfprom
-          - qcom,hawi-qfprom
-          - qcom,ipq5018-qfprom
-          - qcom,ipq5210-qfprom
-          - qcom,ipq5332-qfprom
-          - qcom,ipq5424-qfprom
-          - qcom,ipq6018-qfprom
-          - qcom,ipq8064-qfprom
-          - qcom,ipq8074-qfprom
-          - qcom,ipq9574-qfprom
-          - qcom,ipq9650-qfprom
-          - qcom,kaanapali-qfprom
-          - qcom,maili-qfprom
-          - qcom,milos-qfprom
-          - qcom,msm8226-qfprom
-          - qcom,msm8916-qfprom
-          - qcom,msm8917-qfprom
-          - qcom,msm8937-qfprom
-          - qcom,msm8960-qfprom
-          - qcom,msm8974-qfprom
-          - qcom,msm8976-qfprom
-          - qcom,msm8996-qfprom
-          - qcom,msm8998-qfprom
-          - qcom,qcm2290-qfprom
-          - qcom,qcs404-qfprom
-          - qcom,qcs615-qfprom
-          - qcom,qcs8300-qfprom
-          - qcom,sa8775p-qfprom
-          - qcom,sar2130p-qfprom
-          - qcom,sc7180-qfprom
-          - qcom,sc7280-qfprom
-          - qcom,sc8280xp-qfprom
-          - qcom,sdm630-qfprom
-          - qcom,sdm670-qfprom
-          - qcom,sdm845-qfprom
-          - qcom,shikra-qfprom
-          - qcom,sm6115-qfprom
-          - qcom,sm6350-qfprom
-          - qcom,sm6375-qfprom
-          - qcom,sm8150-qfprom
-          - qcom,sm8250-qfprom
-          - qcom,sm8450-qfprom
-          - qcom,sm8550-qfprom
-          - qcom,sm8650-qfprom
-          - qcom,sm8750-qfprom
-          - qcom,x1e80100-qfprom
-      - const: qcom,qfprom
+    oneOf:
+      - const: qcom,msm8926-qfprom-raw
+      - items:
+          - enum:
+              - qcom,apq8064-qfprom
+              - qcom,apq8084-qfprom
+              - qcom,glymur-qfprom
+              - qcom,hawi-qfprom
+              - qcom,ipq5018-qfprom
+              - qcom,ipq5210-qfprom
+              - qcom,ipq5332-qfprom
+              - qcom,ipq5424-qfprom
+              - qcom,ipq6018-qfprom
+              - qcom,ipq8064-qfprom
+              - qcom,ipq8074-qfprom
+              - qcom,ipq9574-qfprom
+              - qcom,ipq9650-qfprom
+              - qcom,kaanapali-qfprom
+              - qcom,maili-qfprom
+              - qcom,milos-qfprom
+              - qcom,msm8226-qfprom
