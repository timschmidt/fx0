From 6c4c04ede46b2c81ba2971e869e3887deeb620db Mon Sep 17 00:00:00 2001
From: Timothy Schmidt <timschmidt@gmail.com>
Date: Wed, 11 Nov 2026 00:17:59 -0500
Subject: [PATCH] nvmem: qfprom: Add a restricted MSM8926 raw calibration
 reader

Provide a separate raw view for MSM8926 CPU/PVS and primary/redundant CPR
rows. Retain the existing aligned reader and cell fixup, using region
zero as the raw window for this match. Fill other offsets through the
NVMEM keepout mechanism. Make the provider root-only and read-only and
reject additional programming regions before entering their setup path.
Leave the corrected provider and its existing write support unchanged.

Reject raw views wider than the 4 KiB range covered by the keepout table.
A synthetic-resource reproducer using the actual probe and NVMEM read
helpers showed the previous local proposal registering an 8 KiB view and
reading beyond the final keepout. The production board uses 4 KiB and
retains its existing behavior. Fold this guard into the new feature;
there is no corresponding mainline MSM8926 raw-reader feature to fix.

Adapt the driver part of Timothy Schmidt's original local r50 overlay
5624c0158e00149c03f6d1ae53f96092015274bd. Preserve original author/date
and existing copyrights. Codex (GPT-6) assisted with the resource guard,
source adaptation and qualification.

Qualcomm ARM built-in and ARM64 module profiles compile the driver and
NVMEM core with W=1 and no warnings. The extracted real probe, read,
keepout and sysfs helpers and registration assignment fragments pass
18393 checks over synthetic aligned reads, boundaries, permissions,
resource rejection, legacy profiles and acquisition errors. The earlier
proposal fails the over-wide-view case. Deliberate root-policy,
extra-resource and keepout regressions are rejected under address,
undefined-behavior and leak sanitizers.

MMIO, full registration, runtime PM and SRCU are mocked; no fuse data is
read and no fuse programming is executed. Physical CPU/CPR behavior and
full kernel qualification remain open. Human DCO certification remains
pending.
---
 drivers/nvmem/qfprom.c | 37 ++++++++++++++++++++++++++++++++++---
 1 file changed, 34 insertions(+), 3 deletions(-)

diff --git a/drivers/nvmem/qfprom.c b/drivers/nvmem/qfprom.c
index 1de3435df1..906aced5c2 100644
--- a/drivers/nvmem/qfprom.c
+++ b/drivers/nvmem/qfprom.c
@@ -61,7 +61,8 @@ struct qfprom_soc_data {
  * @qfpraw:       iomapped memory space for qfprom-efuse raw address space.
  * @qfpconf:      iomapped memory space for qfprom-efuse configuration address
  *                space.
- * @qfpcorrected: iomapped memory space for qfprom corrected address space.
+ * @qfpcorrected: primary read window: corrected normally, raw for the
+ *                standalone read-only view.
  * @qfpsecurity:  iomapped memory space for qfprom security control space.
  * @dev:          qfprom device structure.
  * @secclk:       Clock supply.
@@ -98,10 +99,25 @@ struct qfprom_touched_values {
  *
  * @keepout: Array of keepout regions for this SoC.
  * @nkeepout: Number of elements in the keepout array.
+ * @raw_read_only: Standalone raw view without programming access.
  */
 struct qfprom_soc_compatible_data {
 	const struct nvmem_keepout *keepout;
 	unsigned int nkeepout;
+	bool raw_read_only;
+};
+
+/* Only the documented CPU/PVS and primary/redundant CPR rows are readable. */
+static const struct nvmem_keepout msm8926_raw_keepout[] = {
+	{ .start = 0, .end = 0xb0 },
+	{ .start = 0xb8, .end = 0x450 },
+	{ .start = 0x460, .end = 0x1000 },
+};
+
+static const struct qfprom_soc_compatible_data msm8926_raw_qfprom = {
+	.keepout = msm8926_raw_keepout,
+	.nkeepout = ARRAY_SIZE(msm8926_raw_keepout),
+	.raw_read_only = true,
 };
 
 static const struct nvmem_keepout sc7180_qfprom_keepout[] = {
@@ -383,21 +399,35 @@ static int qfprom_probe(struct platform_device *pdev)
 	struct qfprom_priv *priv;
 	int ret;
 
+	soc_data = device_get_match_data(dev);
+	if (soc_data && soc_data->raw_read_only) {
+		/* A raw reader must never enter the programming-resource path. */
+		if (platform_get_resource(pdev, IORESOURCE_MEM, 1))
+			return dev_err_probe(dev, -EINVAL,
+					     "read-only raw view requires one region\n");
+		econfig.name = "qfprom-raw";
+		econfig.read_only = true;
+		econfig.root_only = true;
+	}
+
 	priv = devm_kzalloc(dev, sizeof(*priv), GFP_KERNEL);
 	if (!priv)
 		return -ENOMEM;
 
-	/* The corrected section is always provided */
+	/* Region zero is corrected, except for the standalone read-only raw view. */
 	priv->qfpcorrected = devm_platform_get_and_ioremap_resource(pdev, 0, &res);
 	if (IS_ERR(priv->qfpcorrected))
 		return PTR_ERR(priv->qfpcorrected);
 
+	/* Keep the raw view within the range covered by its keepout table. */
+	if (soc_data && soc_data->raw_read_only && resource_size(res) > 0x1000)
+		return dev_err_probe(dev, -EINVAL, "read-only raw view exceeds 4 KiB\n");
+
 	econfig.size = resource_size(res);
 	econfig.dev = dev;
 	econfig.priv = priv;
 
 	priv->dev = dev;
-	soc_data = device_get_match_data(dev);
 	if (soc_data) {
 		econfig.keepout = soc_data->keepout;
 		econfig.nkeepout = soc_data->nkeepout;
@@ -457,6 +487,7 @@ static int qfprom_probe(struct platform_device *pdev)
 }
 
 static const struct of_device_id qfprom_of_match[] = {
+	{ .compatible = "qcom,msm8926-qfprom-raw", .data = &msm8926_raw_qfprom },
 	{ .compatible = "qcom,qfprom",},
 	{ .compatible = "qcom,sc7180-qfprom", .data = &sc7180_qfprom},
 	{ .compatible = "qcom,sc7280-qfprom", .data = &sc7280_qfprom},
-- 
2.56.0

