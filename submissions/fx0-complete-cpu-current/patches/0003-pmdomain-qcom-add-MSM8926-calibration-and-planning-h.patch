From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Timothy Schmidt <timschmidt@gmail.com>
Date: Wed, 11 Nov 2026 08:29:12 -0500
Subject: [PATCH 03/11] pmdomain: qcom: add MSM8926 calibration and planning
 helpers

Decode the nominal fuse/PVS plan, require complete raw rows and the
legacy secure conditional rule, quantize only to supported regulator
points and derive one canonical frequency mask. These helpers do not
activate hardware. The standalone decoder passes 4068 synthetic cases
and 178907 checks against the independent vendor-array oracle, with
three deliberately broken variants rejected under sanitizers.

Composite port from Fx0 CPU source
790c9c5407e17ad1d2395c2ec4bdfcfc8dc82826. Original component author and
date retained; the scoped original source history is recorded in the
qualification evidence. Port, current API merges, changelog and
qualification used OpenAI Codex assistance.

diff --git a/drivers/pmdomain/qcom/cpr-msm8926-corner.h b/drivers/pmdomain/qcom/cpr-msm8926-corner.h
new file mode 100644
index 000000000000..ac2e8ea9ec8a
--- /dev/null
+++ b/drivers/pmdomain/qcom/cpr-msm8926-corner.h
@@ -0,0 +1,134 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef __QCOM_CPR_MSM8926_CORNER_H__
+#define __QCOM_CPR_MSM8926_CORNER_H__
+
+#include <linux/array_size.h>
+
+#include "cpr-msm8926-voltage.h"
+
+struct cpr_msm8926_corner {
+	u32 virtual_corner;
+	u32 fuse_corner;
+	u32 quotient;
+	u32 ring_osc;
+	int floor_uV;
+	int ceiling_uV;
+	int initial_uV;
+	int mx_min_uV;
+};
+
+static const unsigned long cpr_msm8926_rates[] = {
+	300000000, 384000000, 600000000, 787200000, 998400000,
+	1094400000, 1190400000, 1305600000, 1344000000,
+	1401600000, 1497600000, 1593600000, 1689600000, 1785600000,
+};
+
+/*
+ * Reproduce clock-a7's first covering fmax entry, including its conservative
+ * speed0/v0 fallback. Clock and CPR speed-bin selectors are intentionally
+ * independent. This maps metadata only; the caller must validate the clock's
+ * supported rates and activate the rail plan before installing an OPP.
+ */
+static inline int
+cpr_msm8926_map_corner(const struct cpr_msm8926_calibration *calibration,
+		       const struct cpr_msm8926_voltage_plan *plan,
+		       unsigned long rate, struct cpr_msm8926_corner *corner)
+{
+	const unsigned long *frequency = cpr_msm8926_rates;
+	struct cpr_msm8926_corner result = {};
+	unsigned int maximum = 7, selected, fuse, i;
+	bool extended = false;
+
+	if (!calibration || !plan || !corner || !rate)
+		return -EINVAL;
+	if (calibration->clock_speed_bin > 7 || calibration->pvs_version > 3)
+		return -EINVAL;
+	if (rate > 787200000 &&
+	    (!calibration->clock_bin_valid || !calibration->fuse_allows_loop))
+		return -ERANGE;
+	if (calibration->pvs_version == 1) {
+		switch (calibration->clock_speed_bin) {
+		case 0:
+			extended = true;
+			break;
+		case 1:
+			maximum = 12;
+			extended = true;
+			break;
+		case 2:
+			maximum = 10;
+			extended = true;
+			break;
+		case 5:
+			maximum = 14;
+			extended = true;
+			break;
+		}
+	}
+	if (rate > frequency[maximum - 1])
+		return -ERANGE;
+	if (rate <= frequency[1]) {
+		selected = 2;
+	} else if (rate <= frequency[3]) {
+		selected = 4;
+	} else if (!extended) {
+		selected = 7;
+	} else {
+		for (i = 4; i < maximum; i++)
+			if (rate <= frequency[i])
+				break;
+		selected = i + 1;
+	}
+	fuse = selected <= 2 ? 0 : selected <= 4 ? 1 : 2;
+	if (plan->floor_uV[fuse] <= 0 ||
+	    plan->floor_uV[fuse] > plan->initial_uV[fuse] ||
+	    plan->initial_uV[fuse] > plan->ceiling_uV[fuse] ||
+	    plan->ceiling_uV[fuse] > plan->mx_min_uV[fuse])
+		return -EINVAL;
+	if (calibration->fuse_allows_loop &&
+	    (calibration->quotient_adjust[selected - 1] >= calibration->quotient[fuse] ||
+	     calibration->quotient[fuse] > 4095 || calibration->ring_osc[fuse] > 7))
+		return -EINVAL;
+	result.virtual_corner = selected;
+	result.fuse_corner = fuse + 1;
+	if (calibration->fuse_allows_loop) {
+		result.quotient = calibration->quotient[fuse] -
+				  calibration->quotient_adjust[selected - 1];
+		result.ring_osc = calibration->ring_osc[fuse];
+	}
+	result.floor_uV = plan->floor_uV[fuse];
+	result.ceiling_uV = plan->ceiling_uV[fuse];
+	result.initial_uV = plan->initial_uV[fuse];
+	result.mx_min_uV = plan->mx_min_uV[fuse];
+	*corner = result;
+	return 0;
+}
+
+/* One bit per canonical rate; CPU and CPR tables must use the same mask. */
+static inline int
+cpr_msm8926_supported_hw(const struct cpr_msm8926_calibration *calibration,
+			 const struct cpr_msm8926_voltage_plan *plan, u32 *mask)
+{
+	struct cpr_msm8926_corner corner;
+	u32 result = 0;
+	unsigned int i;
+	int ret;
+
+	if (!mask)
+		return -EINVAL;
+	for (i = 0; i < ARRAY_SIZE(cpr_msm8926_rates); i++) {
+		ret = cpr_msm8926_map_corner(calibration, plan, cpr_msm8926_rates[i],
+					     &corner);
+		if (ret == -ERANGE)
+			break;
+		if (ret)
+			return ret;
+		result |= 1U << i;
+	}
+	if (!result)
+		return -ERANGE;
+	*mask = result;
+	return 0;
+}
+
+#endif
diff --git a/drivers/pmdomain/qcom/cpr-msm8926-fuses.h b/drivers/pmdomain/qcom/cpr-msm8926-fuses.h
new file mode 100644
index 000000000000..0c4ec3ea7339
--- /dev/null
+++ b/drivers/pmdomain/qcom/cpr-msm8926-fuses.h
@@ -0,0 +1,84 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef __QCOM_CPR_MSM8926_FUSES_H__
+#define __QCOM_CPR_MSM8926_FUSES_H__
+
+#include <linux/device.h>
+#include <linux/err.h>
+#include <linux/firmware/qcom/qcom_scm.h>
+#include <linux/nvmem-consumer.h>
+#include <linux/slab.h>
+#include <linux/unaligned.h>
+
+#include "cpr-msm8926.h"
+
+/* Both halves of row22 are needed: the uplift selector is bit53. */
+static inline int cpr_msm8926_read_row(struct device *dev, const char *name,
+				       u64 *row)
+{
+	struct nvmem_cell *cell;
+	size_t length;
+	void *data;
+	int ret = 0;
+
+	cell = nvmem_cell_get(dev, name);
+	if (IS_ERR(cell))
+		return dev_err_probe(dev, PTR_ERR(cell),
+				     "%s cell lookup failed\n", name);
+	data = nvmem_cell_read(cell, &length);
+	nvmem_cell_put(cell);
+	if (IS_ERR(data))
+		return dev_err_probe(dev, PTR_ERR(data),
+				     "%s cell read failed\n", name);
+	if (length != sizeof(*row))
+		ret = dev_err_probe(dev, -EINVAL,
+				    "%s cell has %zu bytes, expected %zu\n",
+				    name, length, sizeof(*row));
+	else
+		*row = get_unaligned_le64(data);
+	kfree_sensitive(data);
+
+	return ret;
+}
+
+/*
+ * Sleepable acquisition for the MSM8926 CPR consumer. NVMEM cells must name
+ * full, unshifted raw rows22/138/139. Protected row54 is read only through the
+ * legacy SCM service; a failed read must never select a voltage rule. Publish
+ * calibration only after all reads and the nominal decoder have succeeded.
+ * This does not enable CPR, activate regulators or authorize any CPU OPP.
+ */
+static inline int
+cpr_msm8926_read_calibration(struct device *dev,
+			     struct cpr_msm8926_calibration *calibration)
+{
+	struct cpr_msm8926_fuses fuses = {};
+	u64 conditional;
+	int ret;
+
+	if (!dev || !calibration)
+		return -EINVAL;
+
+	ret = qcom_scm_legacy_fuse_read(0xfc4b81b0, &conditional);
+	if (ret)
+		return dev_err_probe(dev, ret < 0 ? ret : -EIO,
+				     "conditional fuse SCM read failed\n");
+	fuses.conditional_matches = ((conditional >> 42) & 63) == 7;
+	ret = cpr_msm8926_read_row(dev, "cpu_calibration", &fuses.row22);
+	if (ret)
+		return ret;
+	ret = cpr_msm8926_read_row(dev, "cpr_primary", &fuses.row138);
+	if (ret)
+		return ret;
+	ret = cpr_msm8926_read_row(dev, "cpr_redundant", &fuses.row139);
+	if (ret)
+		return ret;
+
+	ret = cpr_msm8926_decode(&fuses, calibration);
+	if (ret)
+		return dev_err_probe(dev, ret,
+				     "MSM8926 fuse calibration decode failed\n");
+
+	return 0;
+}
+
+#endif
diff --git a/drivers/pmdomain/qcom/cpr-msm8926-voltage.h b/drivers/pmdomain/qcom/cpr-msm8926-voltage.h
new file mode 100644
index 000000000000..6bd5cc929102
--- /dev/null
+++ b/drivers/pmdomain/qcom/cpr-msm8926-voltage.h
@@ -0,0 +1,117 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef __QCOM_CPR_MSM8926_VOLTAGE_H__
+#define __QCOM_CPR_MSM8926_VOLTAGE_H__
+
+#include <linux/kernel.h>
+#include <linux/regulator/consumer.h>
+
+#include "cpr-msm8926.h"
+
+struct cpr_msm8926_voltage_plan {
+	int floor_uV[3];
+	int ceiling_uV[3];
+	int initial_uV[3];
+	int mx_min_uV[3];
+	int bootstrap_mx_uV;
+};
+
+/* Read-only provider metadata: never substitute a higher point for a hole. */
+static inline int cpr_msm8926_check_voltage(struct regulator *regulator,
+					    int count, int wanted_uV)
+{
+	bool found = false;
+	int selector, voltage;
+
+	for (selector = 0; selector < count; selector++) {
+		voltage = regulator_list_voltage(regulator, selector);
+		if (voltage < 0)
+			return voltage;
+		found |= voltage == wanted_uV;
+	}
+	return found ? 0 : -ERANGE;
+}
+
+/*
+ * Map nominal Madai limits to the fixed FTS2 boot range and PM8226 L3 grid.
+ * This computes a plan only: rail activation, votes and OPP eligibility belong
+ * to the caller. Preserve the nominal global APC ceiling, and include actual
+ * boot APC voltage in the initial MX floor instead of inferring it from Hz.
+ */
+static inline int
+cpr_msm8926_plan_voltages(const struct cpr_msm8926_calibration *calibration,
+			  struct regulator *apc, struct regulator *mx,
+			  int boot_apc_uV, int mx_max_uV,
+			  struct cpr_msm8926_voltage_plan *plan)
+{
+	struct cpr_msm8926_voltage_plan result = {};
+	unsigned int global_max_uV = 0, step_uV;
+	int apc_count, mx_count, bootstrap_apc_uV, ret;
+	unsigned int i;
+
+	if (!calibration || !apc || !mx || !plan)
+		return -EINVAL;
+	if (boot_apc_uV < 0)
+		return boot_apc_uV;
+	if (!boot_apc_uV || boot_apc_uV > 1350000 ||
+	    mx_max_uV < 750000 || mx_max_uV > 1337500)
+		return -EINVAL;
+	for (i = 0; i < 3; i++) {
+		if (!calibration->floor_uV[i] ||
+		    calibration->floor_uV[i] > calibration->initial_uV[i] ||
+		    calibration->initial_uV[i] > calibration->ceiling_uV[i] ||
+		    calibration->ceiling_uV[i] > 1350000)
+			return -EINVAL;
+		global_max_uV = max(global_max_uV, calibration->ceiling_uV[i]);
+	}
+	step_uV = regulator_get_linear_step(apc);
+	if (step_uV != 5000 && step_uV != 10000)
+		return -EOPNOTSUPP;
+	apc_count = regulator_count_voltages(apc);
+	if (apc_count <= 0)
+		return apc_count ? apc_count : -ENODEV;
+	mx_count = regulator_count_voltages(mx);
+	if (mx_count <= 0)
+		return mx_count ? mx_count : -ENODEV;
+	ret = cpr_msm8926_check_voltage(apc, apc_count, boot_apc_uV);
+	if (ret)
+		return ret;
+
+	bootstrap_apc_uV = boot_apc_uV;
+	for (i = 0; i < 3; i++) {
+		result.floor_uV[i] = DIV_ROUND_UP(calibration->floor_uV[i], step_uV) *
+				    step_uV;
+		result.ceiling_uV[i] = DIV_ROUND_UP(calibration->ceiling_uV[i], step_uV) *
+				      step_uV;
+		result.initial_uV[i] = DIV_ROUND_UP(calibration->initial_uV[i], step_uV) *
+				      step_uV;
+		if ((unsigned int)result.ceiling_uV[i] > global_max_uV)
+			return -ERANGE;
+		ret = cpr_msm8926_check_voltage(apc, apc_count, result.floor_uV[i]);
+		if (ret)
+			return ret;
+		ret = cpr_msm8926_check_voltage(apc, apc_count, result.ceiling_uV[i]);
+		if (ret)
+			return ret;
+		ret = cpr_msm8926_check_voltage(apc, apc_count, result.initial_uV[i]);
+		if (ret)
+			return ret;
+		/* L3's verified 750mV + n*12.5mV grid covers actual APC ceiling. */
+		result.mx_min_uV[i] = DIV_ROUND_UP(result.ceiling_uV[i], 12500) * 12500;
+		if (result.mx_min_uV[i] > mx_max_uV)
+			return -ERANGE;
+		ret = cpr_msm8926_check_voltage(mx, mx_count, result.mx_min_uV[i]);
+		if (ret)
+			return ret;
+		bootstrap_apc_uV = max(bootstrap_apc_uV, result.ceiling_uV[i]);
+	}
+	result.bootstrap_mx_uV = DIV_ROUND_UP(bootstrap_apc_uV, 12500) * 12500;
+	if (result.bootstrap_mx_uV > mx_max_uV)
+		return -ERANGE;
+	ret = cpr_msm8926_check_voltage(mx, mx_count, result.bootstrap_mx_uV);
+	if (ret)
+		return ret;
+	*plan = result;
+	return 0;
+}
+
+#endif
diff --git a/drivers/pmdomain/qcom/cpr-msm8926.h b/drivers/pmdomain/qcom/cpr-msm8926.h
new file mode 100644
index 000000000000..8c8233b81ab3
--- /dev/null
+++ b/drivers/pmdomain/qcom/cpr-msm8926.h
@@ -0,0 +1,149 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef __QCOM_CPR_MSM8926_H__
+#define __QCOM_CPR_MSM8926_H__
+
+#include <linux/errno.h>
+#include <linux/minmax.h>
+#include <linux/types.h>
+
+/*
+ * Madai nominal calibration; no hardware access or regulator activation.
+ * Quantize voltages to the fixed PMIC boot range before forming rail votes.
+ */
+struct cpr_msm8926_fuses {
+	u64 row22;
+	u64 row138;
+	u64 row139;
+	int read_status;
+	int conditional_read_status;
+	int conditional_matches;
+};
+
+struct cpr_msm8926_calibration {
+	u32 pvs_bin;
+	u32 pvs_version;
+	u32 clock_speed_bin;
+	u32 cpr_speed_bin;
+	u32 floor_uV[3];
+	u32 ceiling_uV[3];
+	u32 initial_uV[3];
+	u32 quotient[3];
+	u32 ring_osc[3];
+	u32 quotient_adjust[14];
+	u32 quotient_scaling;
+	bool clock_bin_valid;
+	bool pvs_redundant;
+	bool cpr_redundant;
+	bool local_scheme;
+	bool minimum_override;
+	bool uplift;
+	bool fuse_allows_loop;
+	bool mx_ceiling_supported;
+	bool interpolation_applied;
+};
+
+static inline int
+cpr_msm8926_decode(const struct cpr_msm8926_fuses *fuses,
+		   struct cpr_msm8926_calibration *calibration)
+{
+	struct cpr_msm8926_calibration result = {};
+	static const u32 quotient_shift[] = { 24, 12, 0 };
+	static const u32 primary_ro_shift[] = { 54, 38, 41 };
+	static const u32 redundant_ro_shift[] = { 46, 36, 39 };
+	static const u32 base_floor[] = { 1075000, 1075000, 1125000 };
+	static const u32 base_ceiling[] = { 1075000, 1175000, 1280000 };
+	static const u32 frequency_mhz[] = {
+		300, 384, 600, 787, 998, 1094, 1190,
+		1305, 1344, 1401, 1497, 1593, 1689, 1785,
+	};
+	static const u32 max_corners[][3] = {
+		{ 0, 1, 7 }, { 1, 1, 12 }, { 2, 1, 10 }, { 5, 1, 14 },
+	};
+	const u32 *ro_shift;
+	u64 row;
+	u32 selector, turbo_corner = 0;
+	unsigned int i;
+
+	if (!fuses || !calibration)
+		return -EINVAL;
+	if (fuses->read_status)
+		return fuses->read_status < 0 ? fuses->read_status : -EIO;
+	if (fuses->conditional_read_status)
+		return fuses->conditional_read_status < 0 ?
+			fuses->conditional_read_status : -EIO;
+	if (fuses->conditional_matches != 0 && fuses->conditional_matches != 1)
+		return -EINVAL;
+
+	selector = (fuses->row22 >> 24) & 7;
+	result.clock_bin_valid = !!(fuses->row22 & 8);
+	result.clock_speed_bin = selector == 1 ?
+		(fuses->row22 >> 27) & 7 : fuses->row22 & 7;
+	if (!result.clock_bin_valid)
+		result.clock_speed_bin = 0;
+	/* The vendor CPR selector uses primary bits, unlike clock-a7. */
+	result.cpr_speed_bin = fuses->row22 & 7;
+	result.pvs_version = (fuses->row22 >> 4) & 3;
+	result.pvs_redundant = selector == 2;
+	result.pvs_bin = (fuses->row22 >> (result.pvs_redundant ? 27 : 6)) & 31;
+	result.cpr_redundant = !!(fuses->row138 & (1ULL << 57));
+	row = result.cpr_redundant ? fuses->row139 : fuses->row138;
+	ro_shift = result.cpr_redundant ? redundant_ro_shift : primary_ro_shift;
+	/* Madai has no redundant override for these two control bits. */
+	result.local_scheme = !!(fuses->row138 & (1ULL << 37));
+	result.minimum_override = !fuses->conditional_matches;
+	result.uplift = !result.minimum_override && result.cpr_speed_bin == 1 &&
+		!(fuses->row22 & (1ULL << 53));
+
+	for (i = 0; i < 3; i++) {
+		result.floor_uV[i] = base_floor[i];
+		result.ceiling_uV[i] = base_ceiling[i];
+		if (result.minimum_override) {
+			result.floor_uV[i] = max(result.floor_uV[i], 1140000U);
+			result.ceiling_uV[i] = max(result.ceiling_uV[i], 1140000U);
+		}
+		result.quotient[i] = (row >> quotient_shift[i]) & 4095;
+		if (i)
+			result.quotient[i] += 72;
+		result.ring_osc[i] = (row >> ro_shift[i]) & 7;
+	}
+	/* Exact 32-bin compiled PVS table, expressed as its three sequences. */
+	result.initial_uV[0] = 1050000;
+	result.initial_uV[1] = result.pvs_bin <= 8 ? 1150000 :
+		max(1050000, 1230000 - (int)result.pvs_bin * 10000);
+	result.initial_uV[2] = max(1140000, 1350000 - (int)result.pvs_bin * 10000);
+	if (result.uplift) {
+		result.initial_uV[2] = min(result.initial_uV[2] + 50000, 1330000U);
+		result.quotient[2] += 120;
+	}
+	result.ceiling_uV[2] = max(result.ceiling_uV[2], result.initial_uV[2]);
+	for (i = 0; i < 2; i++)
+		result.initial_uV[i] = clamp(result.initial_uV[i],
+					     result.floor_uV[i], result.ceiling_uV[i]);
+	/* Vendor leaves the turbo PVS value unclamped, including below its floor. */
+	result.fuse_allows_loop = row && !(fuses->row138 & (1ULL << 36)) &&
+		result.quotient[2] > result.quotient[1] + 50 &&
+		result.quotient[1] > result.quotient[0];
+	for (i = 0; i < 3; i++)
+		if (result.quotient[i] > 4095)
+			result.fuse_allows_loop = false;
+	result.mx_ceiling_supported = result.ceiling_uV[2] <= 1337500;
+
+	for (i = 0; i < 4; i++)
+		if (result.cpr_speed_bin == max_corners[i][0] &&
+		    result.pvs_version == max_corners[i][1])
+			turbo_corner = max_corners[i][2];
+	/* Invalid quotients never enter unsigned interpolation arithmetic. */
+	if (turbo_corner && result.fuse_allows_loop) {
+		result.quotient_scaling = min(650U,
+					      1000 * (result.quotient[2] - result.quotient[1]) /
+					      (frequency_mhz[turbo_corner - 1] - frequency_mhz[3]));
+		for (i = 4; i < turbo_corner; i++)
+			result.quotient_adjust[i] = result.quotient_scaling *
+				(frequency_mhz[turbo_corner - 1] - frequency_mhz[i]) / 1000;
+		result.interpolation_applied = true;
+	}
+	*calibration = result;
+	return 0;
+}
+
+#endif
