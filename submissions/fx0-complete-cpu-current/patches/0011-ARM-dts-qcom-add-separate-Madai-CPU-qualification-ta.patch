index f16fda5090eb..672d5aa6c816 100644
--- a/arch/arm/boot/dts/qcom/Makefile
+++ b/arch/arm/boot/dts/qcom/Makefile
@@ -66,3 +66,4 @@ dtb-$(CONFIG_ARCH_QCOM) += \
 
 # Validation-only complete Fx0 board, preserved byte-for-byte.
 dtb-$(CONFIG_ARCH_QCOM) += qcom-msm8926-lg-madai.dtb
+dtb-$(CONFIG_ARCH_QCOM) += qcom-msm8926-lg-madai-cpr.dtb
