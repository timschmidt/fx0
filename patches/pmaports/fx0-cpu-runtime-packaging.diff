++	ret = spmi_saw_fts2_verify(state, old_selector);
++	if (ret)
++		return ret;
++	/* Failed AUTO restoration leaves the confirmed rail in safe PWM mode. */
++	spmi_saw_fts2_restore_mode(state);
++	return 0;
++}
