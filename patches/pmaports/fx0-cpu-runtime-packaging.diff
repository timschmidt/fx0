diff --git a/device/testing/linux-postmarketos-qcom-msm8226/fx0-cpr-attach-retry.patch b/device/testing/linux-postmarketos-qcom-msm8226/fx0-cpr-attach-retry.patch
new file mode 100644
index 000000000..f9067df27
--- /dev/null
+++ b/device/testing/linux-postmarketos-qcom-msm8226/fx0-cpr-attach-retry.patch
@@ -0,0 +1,74 @@
+diff --git a/drivers/pmdomain/qcom/cpr.c b/drivers/pmdomain/qcom/cpr.c
+--- a/drivers/pmdomain/qcom/cpr.c
++++ b/drivers/pmdomain/qcom/cpr.c
+@@ -1069,7 +1069,7 @@
+ 	return 0;
+ }
+ 
+-static int cpr_corner_init(struct cpr_drv *drv)
++static int cpr_corner_init(struct cpr_drv *drv, struct device *cpu_dev)
+ {
+ 	const struct cpr_desc *desc = drv->desc;
+ 	const struct cpr_fuse *fuses = drv->cpr_fuses;
+@@ -1112,7 +1112,7 @@
+ 			return -EINVAL;
+ 		}
+ 		fnum = fc - 1;
+-		freq = cpr_get_opp_hz_for_req(opp, drv->attached_cpu_dev);
++		freq = cpr_get_opp_hz_for_req(opp, cpu_dev);
+ 		if (!freq) {
+ 			dev_pm_opp_put(opp);
+ 			return -EINVAL;
+@@ -1470,10 +1470,7 @@
+ 		return dev_err_probe(drv->dev, PTR_ERR(drv->cpu_clk),
+ 				     "could not get cpu clk\n");
+ 
+-	drv->attached_cpu_dev = dev;
+-
+-	dev_dbg(drv->dev, "using cpu clk from: %s\n",
+-		dev_name(drv->attached_cpu_dev));
++	dev_dbg(drv->dev, "using cpu clk from: %s\n", dev_name(dev));
+ 
+ 	/*
+ 	 * Everything related to (virtual) corners has to be initialized
+@@ -1501,7 +1498,7 @@
+ 	if (!drv->corners)
+ 		return -ENOMEM;
+ 
+-	ret = cpr_corner_init(drv);
++	ret = cpr_corner_init(drv, dev);
+ 	if (ret)
+ 		return ret;
+ 
+@@ -1520,15 +1517,24 @@
+ 	if (ret)
+ 		return ret;
+ 
+-	if (acc_desc->config)
+-		regmap_multi_reg_write(drv->tcsr, acc_desc->config,
+-				       acc_desc->num_regs_per_fuse);
++	if (acc_desc->config) {
++		ret = regmap_multi_reg_write(drv->tcsr, acc_desc->config,
++				     acc_desc->num_regs_per_fuse);
++		if (ret)
++			return ret;
++	}
+ 
+ 	/* Enable ACC if required */
+-	if (acc_desc->enable_mask)
+-		regmap_update_bits(drv->tcsr, acc_desc->enable_reg,
+-				   acc_desc->enable_mask,
+-				   acc_desc->enable_mask);
++	if (acc_desc->enable_mask) {
++		ret = regmap_update_bits(drv->tcsr, acc_desc->enable_reg,
++				 acc_desc->enable_mask,
++				 acc_desc->enable_mask);
++		if (ret)
++			return ret;
++	}
++
++	/* Only a fully initialized attachment may bypass setup on retry. */
++	drv->attached_cpu_dev = dev;
+ 
+ 	dev_info(drv->dev, "driver initialized with %u OPPs\n",
+ 		 drv->num_corners);
diff --git a/device/testing/linux-postmarketos-qcom-msm8226/fx0-cpr-mx-activation.patch b/device/testing/linux-postmarketos-qcom-msm8226/fx0-cpr-mx-activation.patch
new file mode 100644
index 000000000..b2e30065c
--- /dev/null
+++ b/device/testing/linux-postmarketos-qcom-msm8226/fx0-cpr-mx-activation.patch
@@ -0,0 +1,67 @@
+diff --git a/drivers/pmdomain/qcom/cpr-voltage.h b/drivers/pmdomain/qcom/cpr-voltage.h
+--- a/drivers/pmdomain/qcom/cpr-voltage.h
++++ b/drivers/pmdomain/qcom/cpr-voltage.h
+@@ -5,13 +5,14 @@
+ #include <linux/errno.h>
+ #include <linux/regulator/consumer.h>
+ 
+-/* The caller owns regulator activation, handoff and locking. */
++/* The caller owns locking and must retain MX while APC can remain live. */
+ struct cpr_voltage {
+ 	struct regulator *apc;
+ 	struct regulator *mx;
+ 	int mx_max_uV;
+ 	int mx_min_uV;
+ 	int mx_lower_error;
++	bool mx_enabled;
+ };
+ 
+ static inline int cpr_voltage_vote_mx(struct cpr_voltage *rails, int min_uV)
+@@ -29,20 +30,34 @@
+ }
+ 
+ /*
+- * Establish a floor covering every possible boot corner before any APC
+- * transition. Repeating handoff must not lower an existing MX vote.
++ * Establish and activate a floor covering every possible boot corner before
++ * any APC transition. Repeating handoff never lowers an existing MX vote or
++ * takes another enable reference. A failed enable retains the requested floor
++ * for retry, but cannot authorize APC transitions. There is deliberately no
++ * automatic disable: an always-on APC rail can outlive CPR domain power-off.
+  */
+ static inline int cpr_voltage_bootstrap(struct cpr_voltage *rails, int boot_min_uV)
+ {
++	int ret;
++
+ 	if (!rails->mx)
+ 		return 0;
+ 	if (boot_min_uV <= 0 || boot_min_uV > rails->mx_max_uV ||
+ 	    rails->mx_min_uV < 0 || rails->mx_min_uV > rails->mx_max_uV)
+ 		return -EINVAL;
+-	if (rails->mx_min_uV >= boot_min_uV)
++	if (rails->mx_min_uV < boot_min_uV) {
++		ret = cpr_voltage_vote_mx(rails, boot_min_uV);
++		if (ret)
++			return ret;
++	}
++	if (rails->mx_enabled)
+ 		return 0;
+ 
+-	return cpr_voltage_vote_mx(rails, boot_min_uV);
++	ret = regulator_enable(rails->mx);
++	if (!ret)
++		rails->mx_enabled = true;
++
++	return ret;
+ }
+ 
+ static inline int cpr_voltage_set(struct cpr_voltage *rails, int apc_uV,
+@@ -57,7 +72,7 @@
+ 		return regulator_set_voltage(rails->apc, apc_uV, apc_uV);
+ 
+ 	/* Never infer an initial vote from a rounded-down boot clock corner. */
+-	if (rails->mx_min_uV <= 0 || rails->mx_min_uV > rails->mx_max_uV ||
++	if (!rails->mx_enabled || rails->mx_min_uV <= 0 || rails->mx_min_uV > rails->mx_max_uV ||
+ 	    mx_min_uV <= 0 || mx_min_uV > rails->mx_max_uV ||
