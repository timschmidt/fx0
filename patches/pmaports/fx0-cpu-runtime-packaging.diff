++	unsigned int target_uV, old_uV, delta_uV;
++	bool issued;
++	int ret, recovery;
+ 
+ 	if (range != state->range || selector > 255 || !state->step_rate)
+ 		return -EINVAL;
+@@ -115,6 +202,7 @@
+ 	if (old_uV < (range ? 700000 : 350000) ||
