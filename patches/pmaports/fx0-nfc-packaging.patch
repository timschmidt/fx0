-+		ret = cpr_msm8926_check_voltage(apc, apc_count, result.ceiling_uV[i]);
-+		if (ret)
-+			return ret;
-+		ret = cpr_msm8926_check_voltage(apc, apc_count, result.initial_uV[i]);
