diff --git a/device/testing/device-lg-madai/50-wcn36xx-pmf.conf b/device/testing/device-lg-madai/50-wcn36xx-pmf.conf
new file mode 100644
index 000000000..4367fd56f
--- /dev/null
+++ b/device/testing/device-lg-madai/50-wcn36xx-pmf.conf
@@ -0,0 +1,6 @@
+# wcn36xx exposes no BIP cipher. NetworkManager's optional-PMF default
+# otherwise makes WPA2 hotspot activation fail in wpa_supplicant.
+# Explicit profile PMF requirements still take precedence over this default.
+[connection-wcn36xx]
+match-device=driver:wcn36xx
+wifi-sec.pmf=1
