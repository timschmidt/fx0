diff --git a/device/testing/linux-postmarketos-qcom-msm8226/fx0-nxp-nci-unregister-lock.patch b/device/testing/linux-postmarketos-qcom-msm8226/fx0-nxp-nci-unregister-lock.patch
new file mode 100644
index 000000000..7e835fb83
--- /dev/null
+++ b/device/testing/linux-postmarketos-qcom-msm8226/fx0-nxp-nci-unregister-lock.patch
@@ -0,0 +1,24 @@
+diff --git a/drivers/nfc/nxp-nci/core.c b/drivers/nfc/nxp-nci/core.c
+index b84ad0ef2ca1..613aa0a2813a 100644
+--- a/drivers/nfc/nxp-nci/core.c
++++ b/drivers/nfc/nxp-nci/core.c
+@@ -188,15 +188,15 @@ void nxp_nci_remove(struct nci_dev *ndev)
+ 		nxp_nci_fw_work_complete(info, -ESHUTDOWN);
+ 	cancel_work_sync(&info->fw_info.work);
+ 
+-	mutex_lock(&info->info_lock);
++	nci_unregister_device(ndev);
+ 
++	mutex_lock(&info->info_lock);
+ 	if (info->phy_ops->set_mode)
+ 		info->phy_ops->set_mode(info->phy_id, NXP_NCI_MODE_COLD);
++	info->mode = NXP_NCI_MODE_COLD;
++	mutex_unlock(&info->info_lock);
+ 
+-	nci_unregister_device(ndev);
+ 	nci_free_device(ndev);
+-
+-	mutex_unlock(&info->info_lock);
+ }
+ EXPORT_SYMBOL(nxp_nci_remove);
+ 
