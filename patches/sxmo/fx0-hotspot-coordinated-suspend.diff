 start="$(date "+%s")"
-doas rtcwake -m mem -s "$suspend_time" || exit 1
+if [ "$SXMO_DEVICE_NAME" = "lg,madai" ]; then
+	# AP teardown can take time: keep the original scheduled wake deadline.
+	# The coordinator refreshes wakeup_count after network preparation.
+	fx0-hotspot-suspend --sync-wakeup-count \
+		doas -n rtcwake -m mem -t "$((start + suspend_time))" || exit 1
+else
+	doas rtcwake -m mem -s "$suspend_time" || exit 1
+fi
