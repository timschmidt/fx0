From e0e89468dcfc99500bcae40ce58bfa43fe570c15 Mon Sep 17 00:00:00 2001
From: Timothy Schmidt <timschmidt@gmail.com>
Date: Sat, 14 Nov 2026 13:06:58 -0500
Subject: [PATCH] iio: adc: qcom-spmi-vadc: expose processed battery voltages

Expose the existing calibrated voltage path for VBAT_SNS and
LR_MUX1_BAT_THERM while retaining raw reads and their prescale ratios.
Return absolute battery voltages as IIO_VAL_FRACTIONAL with denominator
1000 so the new interfaces use millivolts and processed-scale consumers
can preserve microvolt precision. Keep legacy processed channel units.

Carry the VADC prerequisite preserved in 2457eebe0bb6 onto the
reproducible 6.18.63 source. Actual callback/IIO consumer tests cover
84 conversion, precision, legacy, raw and error cases. Compiled channel
tables preserve the other 92 entries and both battery raw interfaces.
The W=1 ARM object build passes. Physical accuracy, battery consumers
and charging policy remain separate integration and qualification work.
---
 drivers/iio/adc/qcom-spmi-vadc.c | 12 ++++++++++--
 1 file changed, 10 insertions(+), 2 deletions(-)

diff --git a/drivers/iio/adc/qcom-spmi-vadc.c b/drivers/iio/adc/qcom-spmi-vadc.c
index 00a7f0982025..64d9b5b665fd 100644
--- a/drivers/iio/adc/qcom-spmi-vadc.c
+++ b/drivers/iio/adc/qcom-spmi-vadc.c
@@ -467,6 +467,14 @@ static int vadc_read_raw(struct iio_dev *indio_dev,
 		if (ret)
 			break;
 
+		/* New battery voltage inputs use the IIO millivolt ABI. */
+		if (prop->calibration == VADC_CALIB_ABSOLUTE &&
+		    (chan->channel == VADC_VBAT_SNS ||
+		     chan->channel == VADC_LR_MUX1_BAT_THERM)) {
+			*val2 = 1000;
+			return IIO_VAL_FRACTIONAL;
+		}
+
 		return IIO_VAL_INT;
 	case IIO_CHAN_INFO_RAW:
 		prop = &vadc->chan_props[chan->address];
@@ -564,7 +572,7 @@ static const struct vadc_channels vadc_chans[] = {
 	VADC_CHAN_NO_SCALE(SPARE1_03, 1)
 	VADC_CHAN_NO_SCALE(USB_ID_MV, 1)
 	VADC_CHAN_VOLT(VCOIN, 1, SCALE_DEFAULT)
-	VADC_CHAN_NO_SCALE(VBAT_SNS, 1)
+	VADC_CHAN_VOLT(VBAT_SNS, 1, SCALE_DEFAULT)
 	VADC_CHAN_VOLT(VSYS, 1, SCALE_DEFAULT)
 	VADC_CHAN_TEMP(DIE_TEMP, 0, SCALE_PMIC_THERM)
 	VADC_CHAN_VOLT(REF_625MV, 0, SCALE_DEFAULT)
@@ -609,7 +617,7 @@ static const struct vadc_channels vadc_chans[] = {
 	VADC_CHAN_NO_SCALE(P_MUX15_1_3, 1)
 	VADC_CHAN_NO_SCALE(P_MUX16_1_3, 1)
 
-	VADC_CHAN_NO_SCALE(LR_MUX1_BAT_THERM, 0)
+	VADC_CHAN_VOLT(LR_MUX1_BAT_THERM, 0, SCALE_DEFAULT)
 	VADC_CHAN_VOLT(LR_MUX2_BAT_ID, 0, SCALE_DEFAULT)
 	VADC_CHAN_NO_SCALE(LR_MUX3_XO_THERM, 0)
 	VADC_CHAN_NO_SCALE(LR_MUX4_AMUX_THM1, 0)
-- 
