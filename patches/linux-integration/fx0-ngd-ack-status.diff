-		dev_err(&sdev->dev, "TX timed out:MC:0x%x,mt:0x%x", txn.mc,
+		dev_err(&sdev->dev, "Transfer failed:MC:0x%x,mt:0x%x", txn.mc,
 				txn.mt);
 	}
 
@@ -1131,8 +1152,7 @@ static int qcom_slim_ngd_disable_stream(struct slim_stream_runtime *rt)
 	txn.rl = txn.msg->num_bytes + 4;
 	ret = qcom_slim_ngd_xfer_msg_sync(ctrl, &txn);
 	if (ret) {
-		slim_free_txn_tid(ctrl, &txn);
-		dev_err(&sdev->dev, "TX timed out:MC:0x%x,mt:0x%x", txn.mc,
+		dev_err(&sdev->dev, "Transfer failed:MC:0x%x,mt:0x%x", txn.mc,
 			txn.mt);
 		return ret;
 	}
@@ -1151,8 +1171,7 @@ static int qcom_slim_ngd_disable_stream(struct slim_stream_runtime *rt)
 	wbuf[0] = txn.tid;
 	ret = qcom_slim_ngd_xfer_msg_sync(ctrl, &txn);
 	if (ret) {
