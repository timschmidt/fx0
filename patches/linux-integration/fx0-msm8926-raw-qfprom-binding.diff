   reg:
-    # If the QFPROM is read-only OS image then only the corrected region
-    # needs to be provided.  If the QFPROM is writable then all 4 regions
-    # must be provided.
+    # Read-only instances provide one view: normally corrected, or raw
+    # for the standalone MSM8926 interface. Programming needs all 4 regions.
     oneOf:
       - items:
-          - description: The corrected region.
+          - description: The corrected region, or the standalone read-only MSM8926 raw view.
