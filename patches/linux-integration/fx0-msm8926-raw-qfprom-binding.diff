 title: Qualcomm Technologies Inc, QFPROM Efuse
 
+description: |
+  Most consumers use corrected fuse data. MSM8926 CPU and CPR calibration
+  instead use a standalone raw view. That interface has one read-only region
+  and no programming resources; the corrected provider remains independent.
+
 maintainers:
   - Srinivas Kandagatla <srinivas.kandagatla@linaro.org>
 
 allOf:
   - $ref: nvmem.yaml#
   - $ref: nvmem-deprecated-cells.yaml#
+  - if:
+      properties:
+        compatible:
+          contains:
+            const: qcom,msm8926-qfprom-raw
+    then:
+      properties:
+        reg:
+          maxItems: 1
+        clocks: false
+        clock-names: false
+        vcc-supply: false
+      required:
+        - read-only
 
