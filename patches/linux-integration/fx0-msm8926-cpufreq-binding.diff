diff --git a/include/dt-bindings/opp/qcom,msm8926.h b/include/dt-bindings/opp/qcom,msm8926.h
new file mode 100644
--- /dev/null
+++ b/include/dt-bindings/opp/qcom,msm8926.h
@@ -0,0 +1,21 @@
+/* SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause) */
+#ifndef __DT_BINDINGS_OPP_QCOM_MSM8926_H
+#define __DT_BINDINGS_OPP_QCOM_MSM8926_H
+
+/* Shared CPU/CPR opp-supported-hw bits, one per canonical frequency. */
+#define MSM8926_OPP_300000000	0x0001
+#define MSM8926_OPP_384000000	0x0002
+#define MSM8926_OPP_600000000	0x0004
+#define MSM8926_OPP_787200000	0x0008
+#define MSM8926_OPP_998400000	0x0010
+#define MSM8926_OPP_1094400000	0x0020
+#define MSM8926_OPP_1190400000	0x0040
+#define MSM8926_OPP_1305600000	0x0080
+#define MSM8926_OPP_1344000000	0x0100
+#define MSM8926_OPP_1401600000	0x0200
+#define MSM8926_OPP_1497600000	0x0400
+#define MSM8926_OPP_1593600000	0x0800
+#define MSM8926_OPP_1689600000	0x1000
+#define MSM8926_OPP_1785600000	0x2000
+
+#endif
