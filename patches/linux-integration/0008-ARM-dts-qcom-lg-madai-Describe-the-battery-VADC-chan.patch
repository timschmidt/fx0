From 52334e9f84c3e2425819f1ea20aa18eb42453e82 Mon Sep 17 00:00:00 2001
From: Timothy Schmidt <timschmidt@gmail.com>
Date: Thu, 29 Oct 2026 04:52:23 -0400
Subject: [PATCH 8/8] ARM: dts: qcom: lg-madai: Describe the battery VADC
 channels

Expose the stock VBAT_SNS and battery-thermistor channels for diagnostic
readings. The thermistor uses ratiometric calibration and a 200 us
settling time, matching the stock channel configuration.

The upstream VADC driver exposes these channels as raw values. Battery
voltage/temperature scaling and charger threshold qualification remain
separate work; this change does not bypass temperature protection.
---
 arch/arm/boot/dts/qcom/qcom-msm8926-lg-madai.dts | 14 ++++++++++++++
 1 file changed, 14 insertions(+)

diff --git a/arch/arm/boot/dts/qcom/qcom-msm8926-lg-madai.dts b/arch/arm/boot/dts/qcom/qcom-msm8926-lg-madai.dts
index a3c8b7f02..79b4901cd 100644
--- a/arch/arm/boot/dts/qcom/qcom-msm8926-lg-madai.dts
+++ b/arch/arm/boot/dts/qcom/qcom-msm8926-lg-madai.dts
@@ -54,6 +54,20 @@ &mpss_region {
 	status = "okay";
 };
 
+&pm8226_vadc {
+	channel@6 {
+		reg = <VADC_VBAT_SNS>;
+		label = "vbat_sns";
+	};
+
+	channel@30 {
+		reg = <VADC_LR_MUX1_BAT_THERM>;
+		label = "batt_therm";
+		qcom,ratiometric;
+		qcom,hw-settle-time = <200>;
+	};
+};
+
 &rpm_requests {
 	regulators {
 		compatible = "qcom,rpm-pm8226-regulators";
-- 
