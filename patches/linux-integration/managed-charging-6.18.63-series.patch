+	if (!marker || length)
+		return -EPROTO;
+	ret = regmap_read(chg->regmap, chg->addr + SMBB_CHG_CTRL, &control);
+	if (ret)
+		return ret;
+	ret = regmap_read(chg->regmap, chg->addr + SMBB_BAT_BTC_CTRL, &btc);
+	if (ret)
