+	ret = cpr_msm8926_decode(&fuses, calibration);
+	if (ret)
+		return dev_err_probe(dev, ret,
+				     "MSM8926 fuse calibration decode failed\n");
+
+	return 0;
 }
 
 #endif
diff --git a/drivers/pmdomain/qcom/cpr.c b/drivers/pmdomain/qcom/cpr.c
