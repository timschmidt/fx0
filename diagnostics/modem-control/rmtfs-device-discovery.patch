+/* The extra byte lets callers reject properties longer than the expected tuple. */
+static ssize_t read_dt_property(int dirfd, const char *name, void *buf, size_t size)
+{
+	ssize_t total = 0;
+	int fd;
+
+	fd = openat(dirfd, name, O_RDONLY | O_CLOEXEC);
+	if (fd < 0)
+		return -errno;
+
+	while ((size_t)total < size) {
+		ssize_t n = read(fd, (char *)buf + total, size - total);
+
+		if (n < 0 && errno == EINTR)
+			continue;
+		if (n < 0) {
+			total = -errno;
+			break;
+		}
+		if (!n)
+			break;
+		total += n;
+	}
+	close(fd);
+	return total;
+}
+
+static int read_dt_cell_count(int dirfd, const char *name)
+{
+	uint32_t cells[2];
+	ssize_t n;
+	uint32_t count;
+
+	n = read_dt_property(dirfd, name, cells, sizeof(cells));
+	if (n < 0)
+		return n;
+	if (n != sizeof(cells[0]))
+		return -EINVAL;
+	count = be32toh(cells[0]);
+	return count == 1 || count == 2 ? (int)count : -EINVAL;
+}
+
+static uint64_t read_dt_cells(const uint32_t *cells, int count)
+{
+	uint64_t value = be32toh(cells[0]);
+
+	if (count == 2)
+		value = (value << 32) | be32toh(cells[1]);
+	return value;
+}
