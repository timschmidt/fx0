 int rproc_stop(void)
 {
-	pthread_attr_t attr;
-
-	pthread_attr_init(&attr);
-	pthread_attr_setdetachstate(&attr, PTHREAD_CREATE_DETACHED);
-
-	return pthread_create(&stop_thread, &attr, do_rproc_stop, NULL);
-}
+	return begin_command(STOP);
