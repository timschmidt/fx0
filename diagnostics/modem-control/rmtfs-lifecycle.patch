+
+int rproc_complete(void)
+{
+	int result;
+	ssize_t n;
+
+	do {
+		n = read(completion[0], &result, sizeof(result));
+	} while (n < 0 && errno == EINTR);
+	active = false;
+	if (n < 0)
+		return -errno;
+	return n == sizeof(result) ? result : -EIO;
+}
+
+void rproc_exit(void)
+{
+	if (state_fd < 0)
+		return;
+
+	queue_command(EXIT);
+	pthread_join(worker, NULL);
+	close(completion[0]);
+	close(state_fd);
+	state_fd = -1;
+	pending = IDLE;
+}
