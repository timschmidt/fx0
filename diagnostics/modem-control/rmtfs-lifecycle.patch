+static void *command_worker(void *unused)
+{
+	(void)unused;
+	for (;;) {
+		enum rproc_command command;
+		const char *text;
+		size_t len;
+		ssize_t n;
+		int result;
+
+		pthread_mutex_lock(&command_lock);
+		while (pending == IDLE)
+			pthread_cond_wait(&command_ready, &command_lock);
+		command = pending;
+		pending = IDLE;
+		pthread_mutex_unlock(&command_lock);
+		if (command == EXIT)
+			break;
+
+		text = command == START ? "start" : "stop";
+		len = strlen(text);
+		n = pwrite(state_fd, text, len, 0);
+		if (n < 0)
+			result = -errno;
+		else if ((size_t)n != len)
+			result = -EIO;
+		else
+			result = 0;
+
+		do {
+			n = write(completion[1], &result, sizeof(result));
+		} while (n < 0 && errno == EINTR);
+		if (n != sizeof(result))
+			break;
+	}
+	close(completion[1]);
+	return NULL;
+}
