+static int v4l2_copy_nv12(const AVFrame *frame, V4L2Buffer *out, int height)
+{
+    unsigned int length = out->plane_info[0].length;
+    unsigned int stride = out->plane_info[0].bytesperline;
+    unsigned int chroma_height, luma, chroma;
+    uint8_t *dst = out->plane_info[0].mm_addr;
+
+    if (frame->width <= 0 || frame->height <= 0 || height < frame->height ||
+        frame->width >= INT_MAX || stride > INT_MAX ||
+        stride < FFALIGN(frame->width, 2) ||
+        !frame->data[0] || !frame->data[1])
+        return AVERROR(EINVAL);
+
+    chroma_height = FF_CEIL_RSHIFT(height, 1);
+    if (stride > length / (height + chroma_height))
+        return AVERROR(ENOSPC);
+    luma = stride * height;
+    chroma = stride * chroma_height;
+
+    memset(dst, 0, luma);
+    memset(dst + luma, 128, chroma);
+    av_image_copy_plane(dst, stride, frame->data[0], frame->linesize[0],
+                        frame->width, frame->height);
+    av_image_copy_plane(dst + luma, stride, frame->data[1], frame->linesize[1],
+                        FFALIGN(frame->width, 2), FF_CEIL_RSHIFT(frame->height, 1));
+
+    if (V4L2_TYPE_IS_MULTIPLANAR(out->buf.type)) {
+        out->planes[0].bytesused = luma + chroma;
+        out->planes[0].length = length;
+    } else {
+        out->buf.bytesused = luma + chroma;
+        out->buf.length = length;
+    }
+    return 0;
+}
