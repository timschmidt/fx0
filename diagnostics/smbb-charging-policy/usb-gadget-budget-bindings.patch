+      mode when using a generic PHY.
+    $ref: /schemas/types.yaml#/definitions/phandle-array
+    maxItems: 1
+
   ulpi:
     type: object
     additionalProperties: false
@@ -91,6 +98,17 @@
   - $ref: chipidea,usb2-common.yaml#
   - $ref: usb-hcd.yaml#
   - $ref: usb-drd.yaml#
+
+  - if:
+      required:
+        - power-supplies
